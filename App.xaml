        <SolidColorBrush x:Key="ThPanel"     Color="#313858"/>
        <SolidColorBrush x:Key="ThSidebar"   Color="#262C49"/>
        <SolidColorBrush x:Key="ThSecBtn"    Color="#2E3559"/>
        <SolidColorBrush x:Key="ThPill"      Color="#2B3358"/>
        <SolidColorBrush x:Key="ThTrack"     Color="#252C4A"/>
        <SolidColorBrush x:Key="ThLogBg"     Color="#242A45"/>
        <SolidColorBrush x:Key="ThLogHdr"    Color="#20253E"/>
        <SolidColorBrush x:Key="ThHover"     Color="#2E3658"/>
        <SolidColorBrush x:Key="ThSelection" Color="#34408A"/>
        <SolidColorBrush x:Key="ThBorder"    Color="#3D456E"/>
        <SolidColorBrush x:Key="ThTextTitle" Color="#E2E6FF"/>
        <SolidColorBrush x:Key="ThTextBody"  Color="#DCE0F6"/>
        <SolidColorBrush x:Key="ThTextLabel" Color="#C6CDEC"/>
        <SolidColorBrush x:Key="ThTextSub"   Color="#B4BBE0"/>
        <SolidColorBrush x:Key="ThTextNav"   Color="#B6BEE4"/>
        <SolidColorBrush x:Key="ThTextDim"   Color="#9CA3CC"/>
        <SolidColorBrush x:Key="ThAccentIcon" Color="#8FC0FF"/>
        <SolidColorBrush x:Key="ThChartLine"  Color="#3F88C5"/>
        <SolidColorBrush x:Key="ThWarnTint"    Color="#33F5C24A"/>
        <SolidColorBrush x:Key="ThCritTint"    Color="#33E05555"/>
        <SolidColorBrush x:Key="ThInfoTint"    Color="#22315FA0"/>
        <SolidColorBrush x:Key="ThInfoBorderTint" Color="#2E5BA0FF"/>
        <SolidColorBrush x:Key="ThInfoStrongTint" Color="#505BA0FF"/>
        <SolidColorBrush x:Key="ThNeutralTint" Color="#22A0A0A0"/>
        <SolidColorBrush x:Key="ThNeutralBorderTint" Color="#55B4BBE0"/>
        <SolidColorBrush x:Key="ThFaintBorder" Color="#1A808080"/>
        <SolidColorBrush x:Key="ThScrollThumb" Color="#4A5285"/>
        <SolidColorBrush x:Key="ThScrollThumbHover" Color="#5E68A8"/>
        <SolidColorBrush x:Key="ThScrollThumbDragging" Color="#6E78BE"/>
        <SolidColorBrush x:Key="ThLogText"   Color="#5FD98C"/>
        <SolidColorBrush x:Key="ThOk"        Color="#2EC46A"/>
        <SolidColorBrush x:Key="ThOkTint"    Color="#225FD98C"/>
        <SolidColorBrush x:Key="ThOkBorderTint" Color="#555FD98C"/>
        <SolidColorBrush x:Key="ThOkButton"  Color="#1E7A3C"/>
        <SolidColorBrush x:Key="ThOkButtonHover" Color="#28A050"/>
        <SolidColorBrush x:Key="ThOkButtonPressed" Color="#16602E"/>
        <SolidColorBrush x:Key="ThWarn"      Color="#F5C24A"/>
        <SolidColorBrush x:Key="ThWarnBorderTint" Color="#55F5C24A"/>
        <SolidColorBrush x:Key="ThWarnButton" Color="#B5781E"/>
        <SolidColorBrush x:Key="ThWarnButtonHover" Color="#D8941E"/>
        <SolidColorBrush x:Key="ThWarnButtonPressed" Color="#8E5E16"/>
        <SolidColorBrush x:Key="ThCrit"      Color="#E05555"/>
        <SolidColorBrush x:Key="ThCritBorderTint" Color="#55E05555"/>
        <SolidColorBrush x:Key="ThCritButton" Color="#7A1E1E"/>
        <SolidColorBrush x:Key="ThCritButtonHover" Color="#9E2828"/>
        <SolidColorBrush x:Key="ThCritButtonPressed" Color="#5E1818"/>
        <SolidColorBrush x:Key="ThPrimary"        Color="#1870CC"/>
        <SolidColorBrush x:Key="ThPrimaryHover"   Color="#2080E0"/>
        <SolidColorBrush x:Key="ThPrimaryPressed" Color="#1260AA"/>
        <SolidColorBrush x:Key="ThPrimaryText"    Color="#E8F0FF"/>
        <SolidColorBrush x:Key="ThBlueLine"       Color="#3B82E0"/>
        <SolidColorBrush x:Key="ThBlueGradA"      Color="#2F6FD8"/>
        <SolidColorBrush x:Key="ThBlueGradB"      Color="#5BA0FF"/>
        <SolidColorBrush x:Key="ThBlueGradC"      Color="#8AC0FF"/>
        <SolidColorBrush x:Key="ThRamGradA"       Color="#9A63D8"/>
        <SolidColorBrush x:Key="ThRamGradB"       Color="#C08CF0"/>
        <SolidColorBrush x:Key="ThRamGradC"       Color="#DCC0F8"/>
        <SolidColorBrush x:Key="ThNvme1"          Color="#F5A623"/>
        <SolidColorBrush x:Key="ThNvme2"          Color="#29C7D6"/>
        <SolidColorBrush x:Key="ThNvme3"          Color="#FF6B9D"/>
        <SolidColorBrush x:Key="ThNvme4"          Color="#E0C84A"/>
        <SolidColorBrush x:Key="ThCloseHover"     Color="#C42B1C"/>
        <SolidColorBrush x:Key="ThOverlayStrong"  Color="#CC1A1F36"/>
        <SolidColorBrush x:Key="ThWhite"          Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ThBlack"          Color="#000000"/>

        <!-- Couleurs thémables pour les dégradés (sombre par défaut) -->
        <Color x:Key="ThCardA">#353D66</Color>
        <Color x:Key="ThCardB">#272D4C</Color>
        <Color x:Key="ThSwOffA">#10132C</Color>
        <Color x:Key="ThSwOffB">#080A1E</Color>
        <Color x:Key="ThSwOffBdA">#2C3462</Color>
        <Color x:Key="ThSwOffBdB">#07091B</Color>
        <Color x:Key="ThPrimaryColor">#1870CC</Color>
        <Color x:Key="ThPrimaryHoverColor">#2080E0</Color>
        <Color x:Key="ThPrimaryPressedColor">#1260AA</Color>
        <Color x:Key="ThBlueLineColor">#3B82E0</Color>
        <Color x:Key="ThBlueGradAColor">#2F6FD8</Color>
        <Color x:Key="ThBlueGradBColor">#5BA0FF</Color>
        <Color x:Key="ThBlueGradCColor">#8AC0FF</Color>
        <Color x:Key="ThRamGradAColor">#9A63D8</Color>
        <Color x:Key="ThRamGradBColor">#C08CF0</Color>
        <Color x:Key="ThRamGradCColor">#DCC0F8</Color>
        <Color x:Key="ThOverlayStrongColor">#CC1A1F36</Color>
        <Color x:Key="ThWhiteColor">#FFFFFF</Color>
        <Color x:Key="ThBlackColor">#000000</Color>
        <Color x:Key="ThBlackAlpha18Color">#00000018</Color>
        <Color x:Key="ThInfoSelectionColor">#1F5BA0FF</Color>
        <Color x:Key="ThInfoFaintColor">#145BA0FF</Color>
        <Color x:Key="ThInfoTextTintColor">#805BA0FF</Color>
        <Color x:Key="ThInfoGradientColor">#3D5BA0FF</Color>
        <Color x:Key="ThSheenClearColor">#00FFFFFF</Color>
        <Color x:Key="ThSheenMidColor">#66FFFFFF</Color>
        <Color x:Key="ThGlassHighlightStrongColor">#26FFFFFF</Color>
        <Color x:Key="ThGlassHighlightFaintColor">#08FFFFFF</Color>
        <Color x:Key="ThGlassShadowFaintColor">#0A000000</Color>
        <Color x:Key="ThBoardVoidColor">#0E1526</Color>
        <Color x:Key="ThBoardOutlineColor">#46557F</Color>
        <Color x:Key="ThBoardContactColor">#384670</Color>
        <Color x:Key="ThBoardModuleColor">#243052</Color>
        <Color x:Key="ThBoardAccentStrokeColor">#56689E</Color>
        <Color x:Key="ThBoardTraceColor">#27335C</Color>
        <Color x:Key="ThBoardScrewFillColor">#3A4870</Color>
        <Color x:Key="ThBoardInnerColor">#33406A</Color>
        <Color x:Key="ThBoardSlotColor">#2C3962</Color>
        <Color x:Key="ThBoardPortColor">#1C2747</Color>
        <Color x:Key="ThBoardStrongOutlineColor">#4C5C94</Color>
        <Color x:Key="ThBoardLabelColor">#8193CC</Color>
        <Color x:Key="ThBoardSocketLineColor">#5468A8</Color>
        <Color x:Key="ThBoardCpuEdgeColor">#3C4B7A</Color>
        <Color x:Key="ThBoardModuleHighlightColor">#243056</Color>
        <Color x:Key="ThBoardLabelDimColor">#54659C</Color>
        <Color x:Key="ThBoardChipTopColor">#2F3C66</Color>
        <Color x:Key="ThBoardCpuFrameColor">#4A5880</Color>
        <Color x:Key="ThBoardCpuAreaColor">#1B2440</Color>
        <Color x:Key="ThBoardBaseBottomColor">#131D38</Color>
        <Color x:Key="ThBoardBaseTopColor">#1A2542</Color>
        <Color x:Key="ThBoardCpuCoreColor">#2B3860</Color>

        <!-- ── Toggle switch premium (shared par toutes les pages Optimisations) ── -->
        <Style x:Key="TweakChkStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ThTextBody}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Margin"     Value="0,0,0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid MinHeight="38">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="82"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ══ Toggle pill ══════════════════════════════════ -->
                            <Grid Grid.Column="0"
                                  Width="72" Height="30"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left">

                                <!-- ── Couche OFF ── -->
                                <Border x:Name="TrackOff" CornerRadius="15" BorderThickness="1.5">
                                    <Border.BorderBrush>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="{DynamicResource ThSwOffBdA}" Offset="0"/>
                                            <GradientStop Color="{DynamicResource ThSwOffBdB}" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.BorderBrush>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="{DynamicResource ThSwOffA}" Offset="0"/>
                                            <GradientStop Color="{DynamicResource ThSwOffB}" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <!-- ── Couche ON ── -->
                                <Border x:Name="TrackOn" CornerRadius="15" BorderThickness="1.5"
                                        Opacity="0">
                                    <Border.BorderBrush>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#50A8FF" Offset="0"/>
                                            <GradientStop Color="#0C4EA0" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.BorderBrush>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#1E7AE8" Offset="0"/>
                                            <GradientStop Color="#1258BE" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <!-- ── Reflet gloss haut de piste ── -->
                                <Border CornerRadius="15,15,4,4" Height="15"
                                        VerticalAlignment="Top" IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#22FFFFFF" Offset="0"/>
                                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <!-- ── Texte OFF (droite, visible quand OFF) ── -->
                                <TextBlock x:Name="TxtOff"
                                           Text="OFF"
                                           Foreground="{DynamicResource ThTextSub}"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"
                                           IsHitTestVisible="False"/>

                                <!-- ── Texte ON (gauche, visible quand ON) ── -->
                                <TextBlock x:Name="TxtOn"
                                           Text="ON"
                                           Foreground="#A0D0FF"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"
                                           Opacity="0"
                                           IsHitTestVisible="False"/>

                                <!-- ── Halo hover ── -->
                                <Border x:Name="HoverRing"
                                        CornerRadius="15" BorderThickness="1.5"
                                        BorderBrush="#406090"
                                        Opacity="0" IsHitTestVisible="False"/>

                                <!-- ══ Bouton (knob) ════════════════════════════ -->
                                <!-- Ombre portée du bouton sur la piste -->
                                <Ellipse x:Name="KnobShadow"
                                         Width="22" Height="22"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         Margin="4,2,0,0"
                                         IsHitTestVisible="False">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush Center="0.5,0.5"
                                                             GradientOrigin="0.5,0.5">
                                            <GradientStop Color="#70000018" Offset="0.5"/>
                                            <GradientStop Color="{DynamicResource ThBlackAlpha18Color}" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="ShadowTranslate"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>

                                <!-- Surface du bouton -->
                                <Border x:Name="Knob"
                                        Width="20" Height="20"
                                        CornerRadius="10"
                                        BorderThickness="0.5"
                                        BorderBrush="#6888A4"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Margin="5,0,0,0">
                                    <Border.Background>
                                        <RadialGradientBrush Center="0.40,0.32"
                                                             GradientOrigin="0.40,0.32"
                                                             RadiusX="0.75" RadiusY="0.75">
                                            <GradientStop Color="{DynamicResource ThWhiteColor}"  Offset="0"/>
                                            <GradientStop Color="#EAF2F8"  Offset="0.40"/>
                                            <GradientStop Color="#C8D8E6"  Offset="1"/>
                                        </RadialGradientBrush>
                                    </Border.Background>
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="KnobTranslate"/>
                                    </Border.RenderTransform>

                                    <!-- Reflet haut du bouton (dome) -->
                                    <Border CornerRadius="10,10,0,0" Height="10"
                                            VerticalAlignment="Top" IsHitTestVisible="False">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#60FFFFFF" Offset="0"/>
                                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </Border>
                            </Grid>

                            <!-- ── Texte du contrôle ── -->
                            <TextBlock Grid.Column="1"
                                       Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,0,8,0"/>
                        </Grid>

                        <ControlTemplate.Triggers>

                            <!-- Hover : halo subtil -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverRing"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.10"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverRing"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.10"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <!-- ON : glissement → droite, piste bleue, texte ON -->
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <!-- Bouton -->
                                            <DoubleAnimation
                                                Storyboard.TargetName="KnobTranslate"
                                                Storyboard.TargetProperty="X"
                                                To="38" Duration="0:0:0.20">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <!-- Ombre suit le bouton -->
                                            <DoubleAnimation
                                                Storyboard.TargetName="ShadowTranslate"
                                                Storyboard.TargetProperty="X"
                                                To="38" Duration="0:0:0.20">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <!-- Couleur piste -->
                                            <DoubleAnimation Storyboard.TargetName="TrackOn"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.20"/>
                                            <DoubleAnimation Storyboard.TargetName="TrackOff"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.20"/>
                                            <!-- Texte : OFF disparaît, ON apparaît -->
                                            <DoubleAnimation Storyboard.TargetName="TxtOff"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.10"/>
                                            <DoubleAnimation Storyboard.TargetName="TxtOn"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" BeginTime="0:0:0.10"
                                                             Duration="0:0:0.10"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="KnobTranslate"
                                                Storyboard.TargetProperty="X"
                                                To="0" Duration="0:0:0.20">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation
                                                Storyboard.TargetName="ShadowTranslate"
                                                Storyboard.TargetProperty="X"
                                                To="0" Duration="0:0:0.20">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="TrackOn"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.20"/>
                                            <DoubleAnimation Storyboard.TargetName="TrackOff"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.20"/>
                                            <DoubleAnimation Storyboard.TargetName="TxtOn"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.10"/>
                                            <DoubleAnimation Storyboard.TargetName="TxtOff"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" BeginTime="0:0:0.10"
                                                             Duration="0:0:0.10"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <!-- Désactivé -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.40"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Bouton primaire bleu ── -->
        <Style x:Key="PrimaryBtnStyle" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource ThPrimary}"/>
            <Setter Property="Foreground"      Value="{DynamicResource ThPrimaryText}"/>
            <Setter Property="FontFamily"      Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="20,10"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock x:Name="Lbl"
                                       Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThPrimaryHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThPrimaryPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd"  Property="Background" Value="{DynamicResource ThSecBtn}"/>
                                <Setter TargetName="Lbl" Property="Foreground" Value="{DynamicResource ThTextDim}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Bouton secondaire sombre ── -->
        <Style x:Key="SecondaryBtnStyle" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource ThSecBtn}"/>
            <Setter Property="Foreground"      Value="{DynamicResource ThTextNav}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource ThBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily"      Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="20,10"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock x:Name="Lbl"
                                       Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd"  Property="Background"  Value="{DynamicResource ThSelection}"/>
                                <Setter TargetName="Bd"  Property="BorderBrush" Value="{DynamicResource ThTextNav}"/>
                                <Setter TargetName="Lbl" Property="Foreground"  Value="{DynamicResource ThTextBody}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThSidebar}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd"  Property="Background" Value="{DynamicResource ThPanel}"/>
                                <Setter TargetName="Lbl" Property="Foreground" Value="{DynamicResource ThTextDim}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Scrollbar moderne (fine, arrondie, sombre) — appliquée partout ── -->
        <Style x:Key="ModernScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="T" CornerRadius="4"
                                Background="{DynamicResource ThScrollThumb}" Margin="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="T" Property="Background" Value="{DynamicResource ThScrollThumbHover}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="T" Property="Background" Value="{DynamicResource ThScrollThumbDragging}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width"      Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Opacity="0" Focusable="False"
                                                  IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ModernScrollThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Opacity="0" Focusable="False"
                                                  IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width"  Value="Auto"/>
                                <Setter Property="Height" Value="11"/>
                                <Setter TargetName="PART_Track" Property="Orientation" Value="Horizontal"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Convertisseur statut → couleur (Pack Réinstallation, conservé pour compat interne) -->

        <!-- ════════ DA « OPTIM » v1.3.5 (validée sur Nettoyage, déployée sur CPU /
             Windows / Réseau / Confidentialité) : rangée switch-gauche + icône dégradé
             + titre/description ; switch pilule I/O animé ; bouton d'action premium.
             ⚠️ Reflets : OFFSETS de dégradé animés, JAMAIS de rectangle translaté
             (un Border ne clippe pas en arrondi — piège vécu). ════════ -->

        <!-- Rangée d'option : hover bleu, clic n'importe où = toggle (Row_Click) -->
        <Style x:Key="CleanRowStyle" TargetType="Border">
            <Setter Property="Background"   Value="Transparent"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding"      Value="12,10"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThInfoTint}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CleanIconBox" TargetType="Border">
            <Setter Property="Width"  Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThInfoBorderTint}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="{DynamicResource ThInfoGradientColor}" Offset="0"/>
                        <GradientStop Color="{DynamicResource ThInfoFaintColor}" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CleanIconGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize"   Value="15"/>
            <Setter Property="Foreground" Value="{DynamicResource ThAccentIcon}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
        </Style>
        <Style x:Key="CleanRowTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize"   Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource ThTextBody}"/>
        </Style>
        <Style x:Key="CleanRowDesc" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize"   Value="11.2"/>
            <Setter Property="Foreground" Value="{DynamicResource ThTextDim}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="15.5"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
        <Style x:Key="CleanDefaultBadge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThInfoTint}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CleanDefaultText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource ThAccentIcon}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CleanMiniStateOn" TargetType="Border">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="17"/>
            <Setter Property="CornerRadius" Value="8.5"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThBlueGradB}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="{DynamicResource ThBlueGradAColor}" Offset="0"/>
                        <GradientStop Color="{DynamicResource ThBlueGradBColor}" Offset="0.65"/>
                        <GradientStop Color="{DynamicResource ThBlueGradCColor}" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CleanMiniStateOff" TargetType="Border">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="17"/>
            <Setter Property="CornerRadius" Value="8.5"/>
            <Setter Property="Background" Value="{DynamicResource ThTrack}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
        <Style x:Key="CleanMiniStateText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource ThPrimaryText}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="LineHeight" Value="10"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        </Style>
        <Style x:Key="CleanMiniStateTextOff" TargetType="TextBlock" BasedOn="{StaticResource CleanMiniStateText}">
            <Setter Property="Foreground" Value="{DynamicResource ThTextDim}"/>
        </Style>
        <Style x:Key="CleanMiniStateKnob" TargetType="Border">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#22000000"/>
            <Setter Property="BorderThickness" Value="0.8"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="{DynamicResource ThWhiteColor}" Offset="0"/>
                        <GradientStop Color="#D9DEE8" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="{DynamicResource ThBlackColor}" BlurRadius="4" ShadowDepth="1" Opacity="0.35"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Switch pilule : OFF creuse + « O », ON dégradé bleu + reflet bleu glacé + « I »,
             pastille 3D glissante (animation 180 ms) -->
        <Style x:Key="CleanSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="46" Height="24">
                            <Border CornerRadius="12" Background="{DynamicResource ThTrack}"/>
                            <Border CornerRadius="12" Background="#2E000000"
                                    BorderBrush="#55000000" BorderThickness="1"/>
                            <TextBlock x:Name="MarkO" Text="O"
                                       FontFamily="{StaticResource AppFont}" FontSize="9.5" FontWeight="Bold"
                                       Foreground="{DynamicResource ThTextDim}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Margin="0,0,9,0"/>
                            <Border x:Name="TrackOn" CornerRadius="12" Opacity="0" ClipToBounds="True">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="{DynamicResource ThBlueGradAColor}" Offset="0"/>
                                        <GradientStop Color="{DynamicResource ThBlueGradBColor}" Offset="0.6"/>
                                        <GradientStop Color="{DynamicResource ThBlueGradCColor}" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border x:Name="SwSheenB" CornerRadius="12" IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00BFDCFF" Offset="-0.5"/>
                                            <GradientStop Color="#30BFDCFF" Offset="-0.3"/>
                                            <GradientStop Color="#00BFDCFF" Offset="-0.1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Border.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetName="SwSheenB"
                                                                     Storyboard.TargetProperty="(Border.Background).(LinearGradientBrush.GradientStops)[0].(GradientStop.Offset)"
                                                                     From="-0.5" To="1.1" Duration="0:0:2"/>
                                                    <DoubleAnimation Storyboard.TargetName="SwSheenB"
                                                                     Storyboard.TargetProperty="(Border.Background).(LinearGradientBrush.GradientStops)[1].(GradientStop.Offset)"
                                                                     From="-0.3" To="1.3" Duration="0:0:2"/>
                                                    <DoubleAnimation Storyboard.TargetName="SwSheenB"
                                                                     Storyboard.TargetProperty="(Border.Background).(LinearGradientBrush.GradientStops)[2].(GradientStop.Offset)"
                                                                     From="-0.1" To="1.5" Duration="0:0:2"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                </Border>
                            </Border>
                            <TextBlock x:Name="MarkI" Text="I" Visibility="Collapsed"
                                       FontFamily="{StaticResource AppFont}" FontSize="9.5" FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"
                                       Margin="11,0,0,0"/>
                            <Border x:Name="Knob" Width="18" Height="18" CornerRadius="9"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    BorderBrush="#22000000" BorderThickness="0.8">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="{DynamicResource ThWhiteColor}" Offset="0"/>
                                        <GradientStop Color="#D9DEE8" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="{DynamicResource ThBlackColor}" BlurRadius="6" ShadowDepth="1" Opacity="0.4"/>
                                </Border.Effect>
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="KnobT" X="3"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="MarkI" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="MarkO" Property="Visibility" Value="Collapsed"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobT"
                                                             Storyboard.TargetProperty="X"
                                                             To="25" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="TrackOn"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobT"
                                                             Storyboard.TargetProperty="X"
                                                             To="3" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="TrackOn"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Knob" Property="BorderBrush" Value="{DynamicResource ThBlueGradB}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bouton d'action premium : dégradé bleu + reflet bleu glacé (offsets animés)
             + ombre + enfoncement au clic -->
        <Style x:Key="CleanRunBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="30,12"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value><ScaleTransform ScaleX="1" ScaleY="1"/></Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="10" Padding="{TemplateBinding Padding}"
                                ClipToBounds="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{DynamicResource ThBlueLineColor}" Offset="0"/>
                                    <GradientStop Color="{DynamicResource ThBlueGradBColor}" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="{DynamicResource ThBlueLineColor}" BlurRadius="16" ShadowDepth="2" Opacity="0.4"/>
                            </Border.Effect>
                            <Grid>
                                <Border x:Name="Sheen" CornerRadius="10" Margin="-30,-12"
                                        IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00BFDCFF" Offset="-0.45"/>
                                            <GradientStop Color="#22BFDCFF" Offset="-0.25"/>
                                            <GradientStop Color="#00BFDCFF" Offset="-0.05"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sheen"
                                                         Storyboard.TargetProperty="(Border.Background).(LinearGradientBrush.GradientStops)[0].(GradientStop.Offset)"
                                                         From="-0.45" To="1.05" Duration="0:0:0.8"/>
                                        <DoubleAnimation Storyboard.TargetName="Sheen"
                                                         Storyboard.TargetProperty="(Border.Background).(LinearGradientBrush.GradientStops)[1].(GradientStop.Offset)"
                                                         From="-0.25" To="1.25" Duration="0:0:0.8"/>
                                        <DoubleAnimation Storyboard.TargetName="Sheen"
                                                         Storyboard.TargetProperty="(Border.Background).(LinearGradientBrush.GradientStops)[2].(GradientStop.Offset)"
                                                         From="-0.05" To="1.45" Duration="0:0:0.8"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#4F94F0" Offset="0"/>
                                            <GradientStop Color="#74AFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Bg" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="{DynamicResource ThBlueGradBColor}" BlurRadius="22" ShadowDepth="2" Opacity="0.55"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value>
                                </Setter>
                                <Setter TargetName="Bg" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="{DynamicResource ThBlueLineColor}" BlurRadius="8" ShadowDepth="1" Opacity="0.3"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ThSecBtn}"/>
                                <Setter TargetName="Bg" Property="Effect" Value="{x:Null}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThTextDim}"/>
                                <Setter TargetName="Sheen" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
