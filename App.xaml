             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Optimisation_Tool"
             xmlns:pages="clr-namespace:Optimisation_Tool.Pages"
             ><!-- StartupUri retiré (v1.3.5) : App.OnStartup choisit SplashWindow ou
                  MainWindow directe (mode « démarrer minimisé ») — voir App.xaml.cs -->
    <Application.Resources>

        <!-- ── Police globale embarquée, avec repli Windows si la ressource est indisponible ── -->
        <FontFamily x:Key="AppFont">pack://application:,,,/Resources/Fonts/#Instrument Sans, Segoe UI Variable, Segoe UI</FontFamily>

