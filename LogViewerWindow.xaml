<Window x:Class="Optimisation_Tool.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Journal technique — Tweakly"
        Width="760" Height="540" MinWidth="520" MinHeight="320"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseDown">

    <!-- Visualiseur de journal INTÉGRÉ (v1.3.5) : remplace l'ouverture du .txt dans le
         Bloc-notes (rupture d'expérience, pas thémé — rejeté par l'utilisateur). -->
    <Border CornerRadius="14" Background="{DynamicResource ThBg}"
            BorderBrush="{DynamicResource ThBorder}" BorderThickness="1" Margin="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.45"/>
        </Border.Effect>
        <Grid Margin="18,14,18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- En-tête : titre + fermer -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Journal technique"
                               FontFamily="{StaticResource AppFont}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource ThTextTitle}"/>
                    <TextBlock x:Name="TxtLogInfo" Text=""
                               FontFamily="{StaticResource AppFont}" FontSize="11"
                               Foreground="{DynamicResource ThTextDim}"
                               VerticalAlignment="Center" Margin="12,2,0,0"/>
                </StackPanel>
                <Button x:Name="BtnCloseLog" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets"
                        FontSize="11" Width="32" Height="28" HorizontalAlignment="Right"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Foreground="{DynamicResource ThTextNav}"
                        Click="BtnCloseLog_Click"/>
            </Grid>

            <!-- Contenu du journal (lecture seule, monospace) -->
            <Border Grid.Row="1" Background="{DynamicResource ThLogBg}"
                    BorderBrush="{DynamicResource ThBorder}" BorderThickness="1"
                    CornerRadius="10" Padding="2">
                <TextBox x:Name="TxtLogContent"
                         IsReadOnly="True" BorderThickness="0" Background="Transparent"
                         Foreground="{DynamicResource ThTextBody}"
                         FontFamily="Consolas" FontSize="11.5"
                         TextWrapping="NoWrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Padding="10,8">
                    <TextBox.Resources>
                        <!-- Coin entre les 2 barres de défilement : transparent (le fond ThLogBg
                             apparaît). Sinon carré blanc système en bas à droite, vu en clair ET sombre. -->
                        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent"/>
                    </TextBox.Resources>
                </TextBox>
            </Border>

            <!-- Pied : note vie privée + actions -->
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <TextBlock Text="100 % local — rien n'est envoy&#233; nulle part."
                           FontFamily="{StaticResource AppFont}" FontSize="10.5"
                           Foreground="{DynamicResource ThTextDim}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnLogRefresh" Content="Actualiser"
                            Style="{StaticResource SecondaryBtnStyle}" Padding="14,7"
                            Margin="0,0,8,0" Click="BtnLogRefresh_Click"/>
                    <Button x:Name="BtnLogCopy" Content="Tout copier"
                            Style="{StaticResource SecondaryBtnStyle}" Padding="14,7"
                            Margin="0,0,8,0" Click="BtnLogCopy_Click"/>
                    <Button x:Name="BtnLogFolder" Content="Ouvrir le dossier"
                            Style="{StaticResource SecondaryBtnStyle}" Padding="14,7"
                            Click="BtnLogFolder_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
