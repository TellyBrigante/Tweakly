<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms NON utilisé : la cohabitation WPF + WinForms NotifyIcon cassait le 1er
         paint WPF (fenêtre noire au démarrage), même avec le fix officiel
         SetSynchronizationContext. La tray icon est implémentée en P/Invoke direct
         (Shell_NotifyIcon) dans Helpers/TrayIconManager.cs — zéro dépendance WinForms. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>Optimisation_Tool</RootNamespace>
    <AssemblyName>Tweakly</AssemblyName>
    <ApplicationIcon>Tweakly.ico</ApplicationIcon>
    <Version>1.3.4</Version>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <!-- App Windows-only (WPF + WMI) : CA1416 "API Windows uniquement" = faux positifs -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.7-pre700" />
    <PackageReference Include="NvAPIWrapper.Net" Version="0.8.1.101" />
    <PackageReference Include="System.Management" Version="10.0.8" />
  </ItemGroup>

  <!-- Icône embarquée comme ressource (pour l'icône de fenêtre / barre des tâches) -->
  <ItemGroup>
    <Resource Include="Tweakly.ico" />
  </ItemGroup>

  <!-- Dossier data/ — copié au build ET au publish -->
  <ItemGroup>
    <Content Include="data\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
