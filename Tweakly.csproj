<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>Optimisation_Tool</RootNamespace>
    <AssemblyName>Tweakly</AssemblyName>
    <ApplicationIcon>Tweakly.ico</ApplicationIcon>
    <Version>1.1.1</Version>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <!-- App Windows-only (WPF + WMI) : CA1416 "API Windows uniquement" = faux positifs -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <!-- Icône embarquée comme ressource (pour l'icône de fenêtre / barre des tâches) -->
  <ItemGroup>
    <Resource Include="Tweakly.ico" />
  </ItemGroup>

  <!-- Dossier data/ — copié au build ET au publish -->
  <ItemGroup>
    <Content Include="data\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
