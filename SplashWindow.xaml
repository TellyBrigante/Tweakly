<Window x:Class="Optimisation_Tool.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tweakly"
        Width="420" Height="240"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        ShowInTaskbar="True"
        Loaded="Window_Loaded">

    <!-- ÉCRAN DE DÉMARRAGE (v1.3.5) : logo + étapes de chargement + barre shimmer
         (DA validée). TOUJOURS sombre : le thème de l'utilisateur n'est pas encore
         chargé à cet instant, et le navy est l'identité de marque.
         ⚠️ ANTI-CASSE MAJ : tout le code-behind est blindé — quel que soit l'échec,
         MainWindow s'ouvre (voir SplashWindow.xaml.cs). -->
    <Border CornerRadius="16" Background="#2B3252"
            BorderBrush="#3D456E" BorderThickness="1" Margin="14">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="4" Opacity="0.45"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Logo centré -->
            <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock HorizontalAlignment="Center" FontSize="32" FontWeight="Bold"
                           FontFamily="{StaticResource AppFont}">
                    <Run Text="Tweak" Foreground="#E2E6FF"/><Run Text="ly" Foreground="#5BA0FF"/>
                </TextBlock>
                <TextBlock x:Name="TxtSplashVersion" Text=""
                           HorizontalAlignment="Center" Margin="0,6,0,0"
                           FontFamily="Consolas" FontSize="11" Foreground="#9CA3CC"/>
            </StackPanel>

            <!-- Étape + barre de progression -->
            <StackPanel Grid.Row="1" Margin="28,0,28,24">
                <TextBlock x:Name="TxtSplashStep" Text="Initialisation&#8230;"
                           FontFamily="{StaticResource AppFont}" FontSize="11.5"
                           Foreground="#B6BEE4" Margin="0,0,0,8"/>
                <Grid Height="6">
                    <Border Background="#2A3358" CornerRadius="3"/>
                    <Grid x:Name="SplashBar" ClipToBounds="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0*"/>
                            <ColumnDefinition Width="100*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="3">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#2F6FD8" Offset="0"/>
                                    <GradientStop Color="#5BA0FF" Offset="0.6"/>
                                    <GradientStop Color="#8AC0FF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <!-- Reflet bleu glacé : OFFSETS animés (jamais de rectangle translaté) -->
                            <Border x:Name="SplashSheen" CornerRadius="3" IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00BFDCFF" Offset="-0.5"/>
                                        <GradientStop Color="#40BFDCFF" Offset="-0.3"/>
                                        <GradientStop Color="#00BFDCFF" Offset="-0.1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Border.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="SplashSheen"
                                                                 Storyboard.TargetProperty="(Border.Background).(LinearGradientBrush.GradientStops)[0].(GradientStop.Offset)"
                                                                 From="-0.5" To="1.1" Duration="0:0:1.6"/>
                                                <DoubleAnimation Storyboard.TargetName="SplashSheen"
                                                                 Storyboard.TargetProperty="(Border.Background).(LinearGradientBrush.GradientStops)[1].(GradientStop.Offset)"
                                                                 From="-0.3" To="1.3" Duration="0:0:1.6"/>
                                                <DoubleAnimation Storyboard.TargetName="SplashSheen"
                                                                 Storyboard.TargetProperty="(Border.Background).(LinearGradientBrush.GradientStops)[2].(GradientStop.Offset)"
                                                                 From="-0.1" To="1.5" Duration="0:0:1.6"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                            </Border>
                        </Border>
                    </Grid>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
