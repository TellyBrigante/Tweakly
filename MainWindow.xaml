<Window x:Class="Optimisation_Tool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tweakly" Width="1180" Height="820"
        MinWidth="940" MinHeight="620"
        Icon="Tweakly.ico"
        WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource ThBg}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5"
                      GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <!-- Barre de progression dans la barre des tâches Windows -->
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="TaskbarInfo"
                         ProgressState="None" ProgressValue="0"/>
    </Window.TaskbarItemInfo>

    <Window.Resources>

        <!-- Bouton nav standard -->
        <Style x:Key="NavBtnStyle" TargetType="Button">
            <Setter Property="Background"                             Value="Transparent"/>
            <Setter Property="Foreground"                             Value="{DynamicResource ThTextNav}"/>
            <Setter Property="BorderThickness"                        Value="0"/>
            <Setter Property="HorizontalContentAlignment"             Value="Left"/>
            <Setter Property="FontSize"                               Value="12"/>
            <Setter Property="FontFamily"                             Value="{StaticResource AppFont}"/>
            <Setter Property="FontWeight"                             Value="Normal"/>
            <Setter Property="Cursor"                                 Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Margin="8,2">
                            <TextBlock x:Name="Lbl"
                                       Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       Padding="12,8" TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd"  Property="Background" Value="{DynamicResource ThSecBtn}"/>
                                <Setter TargetName="Lbl" Property="Foreground" Value="{DynamicResource ThTextNav}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bouton de sous-item : texte CENTRÉ (les noms longs wrappent centrés sous le parent) -->
        <Style x:Key="NavSubBtnStyle" TargetType="Button" BasedOn="{StaticResource NavBtnStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Margin="8,2">
                            <TextBlock x:Name="Lbl"
                                       Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       Padding="10,7" TextWrapping="Wrap" TextAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd"  Property="Background" Value="{DynamicResource ThSecBtn}"/>
                                <Setter TargetName="Lbl" Property="Foreground" Value="{DynamicResource ThTextNav}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Boutons fen&#234;tre (min/close) -->
        <Style x:Key="WinBtnStyle" TargetType="Button">
            <Setter Property="Background"                             Value="Transparent"/>
            <Setter Property="Foreground"                             Value="{DynamicResource ThTextNav}"/>
            <Setter Property="BorderThickness"                        Value="0"/>
            <Setter Property="Width"                                  Value="34"/>
            <Setter Property="Height"                                 Value="30"/>
            <Setter Property="FontSize"                               Value="13"/>
            <Setter Property="Cursor"                                 Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5">
                            <TextBlock x:Name="Lbl" Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd"  Property="Background" Value="#1F2865"/>
                                <Setter TargetName="Lbl" Property="Foreground" Value="{DynamicResource ThTextTitle}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseBtnStyle" TargetType="Button">
            <Setter Property="Background"                             Value="Transparent"/>
            <Setter Property="Foreground"                             Value="{DynamicResource ThTextNav}"/>
            <Setter Property="BorderThickness"                        Value="0"/>
            <Setter Property="Width"                                  Value="34"/>
            <Setter Property="Height"                                 Value="30"/>
            <Setter Property="FontSize"                               Value="13"/>
            <Setter Property="Cursor"                                 Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5">
                            <TextBlock x:Name="Lbl" Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd"  Property="Background" Value="#C42B1C"/>
                                <Setter TargetName="Lbl" Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ BARRE TITRE PLEINE LARGEUR (drag + min / agrandir / fermer) ═══ -->
        <Border Grid.Row="0" Height="40"
                Background="{DynamicResource ThSidebar}"
                BorderBrush="{DynamicResource ThBorder}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseDown">
            <Grid>
                <TextBlock x:Name="TxtPageTitle"
                           Text="Informations Syst&#232;me"
                           Foreground="{DynamicResource ThTextBody}"
                           FontSize="12" FontFamily="{StaticResource AppFont}"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"
                            Orientation="Horizontal" Margin="0,0,6,0">
                    <Button x:Name="BtnMiniMode" Content="&#xE73F;"
                            FontFamily="Segoe MDL2 Assets" FontSize="11"
                            ToolTip="Mode mini (monitoring compact)"
                            Style="{StaticResource WinBtnStyle}"
                            Click="BtnMiniMode_Click"/>
                    <Button x:Name="BtnMinimize" Content="&#xE921;"
                            FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Style="{StaticResource WinBtnStyle}"
                            Click="BtnMinimize_Click"/>
                    <Button x:Name="BtnMaximize" Content="&#xE922;"
                            FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Style="{StaticResource WinBtnStyle}"
                            Click="BtnMaximize_Click"/>
                    <Button x:Name="BtnClose" Content="&#xE8BB;"
                            FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Style="{StaticResource CloseBtnStyle}"
                            Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ CORPS : sidebar + contenu ════════════════════════════════════ -->
        <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="178"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border Grid.Column="0"
                    Background="{DynamicResource ThSidebar}"
                    BorderBrush="{DynamicResource ThBorder}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Logo + zone de drag -->
                    <Border Grid.Row="0" Padding="18,20,18,14"
                            MouseLeftButtonDown="DragBar_MouseDown"
                            Cursor="SizeAll">
                        <StackPanel>
                            <TextBlock FontSize="18" FontWeight="Bold"
                                       FontFamily="{StaticResource AppFont}"><Run Text="Tweak" Foreground="{DynamicResource ThTextTitle}"/><Run Text="ly" Foreground="#5BA0FF"/></TextBlock>
                            <TextBlock x:Name="TxtVersion" Text="v1.2.1"
                                       FontSize="11" Foreground="{DynamicResource ThTextDim}"
                                       FontFamily="{StaticResource AppFont}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Boutons de navigation -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,6,0,12">

                            <!-- ── Groupe Optimisations (repliable) ── -->
                            <Button x:Name="BtnNavOptGroup"
                                    Content="&#x25B8;  Optimisations"
                                    FontWeight="SemiBold"
                                    Style="{StaticResource NavBtnStyle}"
                                    Click="BtnNavOptGroup_Click"/>

                            <!-- Sous-items Optimisations -->
                            <Border x:Name="OptGroupPanel"
                                    Visibility="Collapsed"
                                    BorderBrush="{DynamicResource ThSelection}"
                                    BorderThickness="2,0,0,0"
                                    Margin="20,0,8,4">
                                <StackPanel>
                                    <Button x:Name="BtnNavNettoyage"
                                            Content="Nettoyage"
                                            Tag="Nettoyage"
                                            Style="{StaticResource NavSubBtnStyle}"
                                            Click="NavBtn_Click"/>
                                    <Button Content="Nvidia"
                                            Tag="Nvidia"
                                            Style="{StaticResource NavSubBtnStyle}"
                                            Click="NavBtn_Click"/>
                                    <Button Content="CPU"
                                            Tag="CPU"
                                            Style="{StaticResource NavSubBtnStyle}"
                                            Click="NavBtn_Click"/>
                                    <Button Content="Windows"
                                            Tag="Windows"
                                            Style="{StaticResource NavSubBtnStyle}"
                                            Click="NavBtn_Click"/>
                                    <Button Content="R&#233;seau"
                                            Tag="Reseau"
                                            Style="{StaticResource NavSubBtnStyle}"
                                            Click="NavBtn_Click"/>
                                    <Button Content="Confidentialit&#233;"
                                            Tag="Privacy"
                                            Style="{StaticResource NavSubBtnStyle}"
                                            Click="NavBtn_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- ── Groupe Diagnostic (repliable) ── -->
                            <Button x:Name="BtnNavDiagGroup"
                                    Content="&#x25B8;  Diagnostic"
                                    FontWeight="SemiBold"
                                    Style="{StaticResource NavBtnStyle}"
                                    Click="BtnNavDiagGroup_Click"/>
                            <Border x:Name="DiagGroupPanel"
                                    Visibility="Collapsed"
                                    BorderBrush="{DynamicResource ThSelection}"
                                    BorderThickness="2,0,0,0"
                                    Margin="20,0,8,4">
                                <StackPanel>
                                    <Button Content="Bilan de sant&#233;"
                                            Tag="Diagnostic"
                                            Style="{StaticResource NavSubBtnStyle}"
                                            Click="NavBtn_Click"/>
                                    <Button Content="Erreurs Windows"
                                            Tag="EventLog"
                                            Style="{StaticResource NavSubBtnStyle}"
                                            Click="NavBtn_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- ── Groupe Boîte à outils (repliable) ── -->
                            <Button x:Name="BtnNavToolsGroup"
                                    Content="&#x25B8;  Bo&#238;te &#224; outils"
                                    FontWeight="SemiBold"
                                    Style="{StaticResource NavBtnStyle}"
                                    Click="BtnNavToolsGroup_Click"/>
                            <Border x:Name="ToolsGroupPanel"
                                    Visibility="Collapsed"
                                    BorderBrush="{DynamicResource ThSelection}"
                                    BorderThickness="2,0,0,0"
                                    Margin="20,0,8,4">
                                <StackPanel>
                                    <Button Content="Applications"
                                            Tag="Apps"
                                            Style="{StaticResource NavSubBtnStyle}"
                                            Click="NavBtn_Click"/>
                                    <Button Content="Pack R&#233;installation"
                                            Tag="Fresh"
                                            Style="{StaticResource NavSubBtnStyle}"
                                            Click="NavBtn_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- ── Groupe Surveillance (repliable) ── -->
                            <Button x:Name="BtnNavMonGroup"
                                    Content="&#x25B8;  Surveillance"
                                    FontWeight="SemiBold"
                                    Style="{StaticResource NavBtnStyle}"
                                    Click="BtnNavMonGroup_Click"/>
                            <Border x:Name="MonGroupPanel"
                                    Visibility="Collapsed"
                                    BorderBrush="{DynamicResource ThSelection}"
                                    BorderThickness="2,0,0,0"
                                    Margin="20,0,8,4">
                                <StackPanel>
                                    <Button x:Name="BtnNavMonitoring"
                                            Content="Monitoring Syst&#232;me"
                                            Tag="Monitoring"
                                            Style="{StaticResource NavSubBtnStyle}"
                                            Click="NavBtn_Click"/>
                                    <Button Content="Monitoring R&#233;seau"
                                            Tag="ReseauMon"
                                            Style="{StaticResource NavSubBtnStyle}"
                                            Click="NavBtn_Click"/>
                                </StackPanel>
                            </Border>
                            <Button x:Name="BtnNavInfo"
                                    Content="Informations Syst&#232;me"
                                    Tag="Info"
                                    Style="{StaticResource NavBtnStyle}"
                                    Click="NavBtn_Click"/>
                            <Button x:Name="BtnNavReglages"
                                    Content="R&#233;glages"
                                    Tag="Reglages"
                                    Style="{StaticResource NavBtnStyle}"
                                    Click="NavBtn_Click"/>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bas de sidebar : bascule thème (affiche le mode cible) -->
                    <Button x:Name="BtnTheme" Grid.Row="2"
                            ToolTip="Basculer le th&#232;me"
                            HorizontalAlignment="Left"
                            Height="30"
                            Margin="12,0,0,12"
                            Cursor="Hand"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="BtnTheme_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="9"
                                        Background="{DynamicResource ThSecBtn}"
                                        BorderBrush="{DynamicResource ThBorder}"
                                        BorderThickness="1"
                                        Padding="11,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="ThemeIcon"
                                                   Text="&#xE706;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13"
                                                   Foreground="#F5C24A"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="ThemeLbl"
                                                   Text="Mode clair"
                                                   Foreground="{DynamicResource ThTextNav}"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThHover}"/>
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#1870CC"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- ══ COLONNE DROITE : contenu + journal ══════════════════════ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ZONE DE CONTENU -->
                <Grid Grid.Row="0" Background="{DynamicResource ThBg}">

                <!-- Contenu de la page active -->
                <ContentControl x:Name="MainContent"
                                Focusable="False"/>
                </Grid><!-- fin ZONE DE CONTENU -->

                <!-- ══ JOURNAL D'ACTIVIT&#201; (repliable) ══════════════════════ -->
                <Border Grid.Row="1"
                        Background="{DynamicResource ThLogBg}"
                        BorderBrush="{DynamicResource ThBorder}"
                        BorderThickness="0,1,0,0">
                    <StackPanel>
                        <!-- En-t&#234;te + bouton repli -->
                        <Grid Height="24" Background="{DynamicResource ThLogHdr}">
                            <TextBlock Text="Journal d'activit&#233;"
                                       Foreground="{DynamicResource ThTextDim}" FontFamily="{StaticResource AppFont}"
                                       FontSize="11" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <Button x:Name="BtnToggleLog"
                                    Content="&#x25B4;"
                                    Style="{StaticResource WinBtnStyle}"
                                    Width="40" Height="20"
                                    HorizontalAlignment="Right" Margin="0,0,6,0"
                                    Click="BtnToggleLog_Click"/>
                        </Grid>
                        <!-- Corps du journal -->
                        <ScrollViewer x:Name="LogScroll"
                                      Visibility="Collapsed"
                                      Height="130"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="12,6,12,8">
                            <TextBlock x:Name="TxtLog"
                                       Foreground="{DynamicResource ThLogText}"
                                       FontFamily="Consolas" FontSize="11.5"
                                       TextWrapping="Wrap" LineHeight="16"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

            </Grid><!-- fin colonne droite -->
        </Grid><!-- fin corps (sidebar + contenu) -->

        <!-- ══ OVERLAY DE MISE À JOUR (couvre toute la fenêtre) ══════════════ -->
        <Border x:Name="UpdateOverlay" Grid.Row="0" Grid.RowSpan="2"
                Panel.ZIndex="100" Visibility="Collapsed"
                Background="{DynamicResource ThBg}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="460">
                <!-- Logo -->
                <TextBlock HorizontalAlignment="Center" FontSize="34" FontWeight="Bold"
                           FontFamily="{StaticResource AppFont}">
                    <Run Text="Tweak" Foreground="{DynamicResource ThTextTitle}"/><Run Text="ly" Foreground="#5BA0FF"/>
                </TextBlock>
                <TextBlock x:Name="TxtUpdTitle" Text="Mise &#224; jour"
                           HorizontalAlignment="Center" Margin="0,20,0,4"
                           Foreground="{DynamicResource ThTextTitle}"
                           FontFamily="{StaticResource AppFont}" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock x:Name="TxtUpdStatus" Text="T&#233;l&#233;chargement&#8230;"
                           HorizontalAlignment="Center" Margin="0,0,0,22"
                           Foreground="{DynamicResource ThTextDim}"
                           FontFamily="{StaticResource AppFont}" FontSize="12.5"/>

                <!-- Barre de progression -->
                <Grid Height="10">
                    <Border Background="{DynamicResource ThTrack}" CornerRadius="5"/>
                    <Grid x:Name="UpdBar" ClipToBounds="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0*"/>
                            <ColumnDefinition Width="100*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#3B82E0" Offset="0"/>
                                    <GradientStop Color="#5BA0FF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                </Grid>
                <TextBlock x:Name="TxtUpdPct" Text="0 %" HorizontalAlignment="Center"
                           Margin="0,9,0,0" Foreground="{DynamicResource ThTextNav}"
                           FontFamily="Consolas" FontSize="11.5"/>

                <!-- Bouton Continuer (apparaît après téléchargement) -->
                <Button x:Name="BtnUpdContinue" Content="CONTINUER"
                        Visibility="Collapsed"
                        Style="{StaticResource PrimaryBtnStyle}"
                        HorizontalAlignment="Center" Margin="0,24,0,0" Padding="34,10"
                        Click="BtnUpdContinue_Click"/>
            </StackPanel>
        </Border>
    </Grid><!-- fin grille principale -->
</Window>
