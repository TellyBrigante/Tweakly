<Window x:Class="Optimisation_Tool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tweakly" Width="1180" Height="820"
        MinWidth="760" MinHeight="460"
        Icon="Tweakly.ico"
        WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource ThBg}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5"
                      GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <!-- Barre de progression dans la barre des tâches Windows -->
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="TaskbarInfo"
                         ProgressState="None" ProgressValue="0"/>
    </Window.TaskbarItemInfo>

    <Window.Resources>

        <!-- Bouton nav standard -->
        <Style x:Key="NavBtnStyle" TargetType="Button">
            <Setter Property="Background"                             Value="Transparent"/>
            <Setter Property="Foreground"                             Value="{DynamicResource ThTextNav}"/>
            <Setter Property="BorderThickness"                        Value="0"/>
            <Setter Property="HorizontalContentAlignment"             Value="Left"/>
            <Setter Property="FontSize"                               Value="12"/>
            <Setter Property="FontFamily"                             Value="{StaticResource AppFont}"/>
            <Setter Property="FontWeight"                             Value="Normal"/>
            <Setter Property="Cursor"                                 Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Margin="8,2">
                            <TextBlock x:Name="Lbl"
                                       Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       Padding="12,8" TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                       TextAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd"  Property="Background" Value="{DynamicResource ThSecBtn}"/>
                                <Setter TargetName="Lbl" Property="Foreground" Value="{DynamicResource ThTextNav}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bouton de sous-item : texte CENTRÉ (les noms longs wrappent centrés sous le parent) -->
        <Style x:Key="NavSubBtnStyle" TargetType="Button" BasedOn="{StaticResource NavBtnStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Margin="8,2">
                            <TextBlock x:Name="Lbl"
                                       Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       Padding="10,7" TextWrapping="Wrap" TextAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd"  Property="Background" Value="{DynamicResource ThSecBtn}"/>
                                <Setter TargetName="Lbl" Property="Foreground" Value="{DynamicResource ThTextNav}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Navigation expérimentale : contenu texte conservé pour le titre de page,
             badge rouge thémé ajouté uniquement à Optimisation GPU. -->
        <Style x:Key="GpuExperimentalNavBtnStyle" TargetType="Button" BasedOn="{StaticResource NavBtnStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Margin="8,2" Padding="6,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Lbl" Text="{TemplateBinding Content}"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           TextAlignment="Center" TextWrapping="Wrap"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="{DynamicResource ThCritTint}"
                                        BorderBrush="{DynamicResource ThCritBorderTint}"
                                        BorderThickness="1" CornerRadius="4"
                                        Padding="3,1" Margin="4,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="EXP" Foreground="{DynamicResource ThCrit}"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="7.5" FontWeight="Bold"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThSecBtn}"/>
                                <Setter TargetName="Lbl" Property="Foreground" Value="{DynamicResource ThTextNav}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Boutons fen&#234;tre (min/close) -->
        <Style x:Key="WinBtnStyle" TargetType="Button">
            <Setter Property="Background"                             Value="Transparent"/>
            <Setter Property="Foreground"                             Value="{DynamicResource ThTextNav}"/>
            <Setter Property="BorderThickness"                        Value="0"/>
            <Setter Property="Width"                                  Value="34"/>
            <Setter Property="Height"                                 Value="30"/>
            <Setter Property="FontSize"                               Value="13"/>
            <Setter Property="Cursor"                                 Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5">
                            <TextBlock x:Name="Lbl" Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover THÉMÉ (l'ancien #1F2865 en dur était un bleu nuit
                                 invisible/bizarre en mode clair — retour utilisateur v1.3.5) -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd"  Property="Background" Value="{DynamicResource ThSelection}"/>
                                <Setter TargetName="Lbl" Property="Foreground" Value="{DynamicResource ThTextTitle}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseBtnStyle" TargetType="Button">
            <Setter Property="Background"                             Value="Transparent"/>
            <Setter Property="Foreground"                             Value="{DynamicResource ThTextNav}"/>
            <Setter Property="BorderThickness"                        Value="0"/>
            <Setter Property="Width"                                  Value="34"/>
            <Setter Property="Height"                                 Value="30"/>
            <Setter Property="FontSize"                               Value="13"/>
            <Setter Property="Cursor"                                 Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5">
                            <TextBlock x:Name="Lbl" Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd"  Property="Background" Value="{DynamicResource ThCloseHover}"/>
                                <Setter TargetName="Lbl" Property="Foreground" Value="{DynamicResource ThWhite}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ BARRE TITRE PLEINE LARGEUR (drag + min / agrandir / fermer) ═══ -->
        <Border Grid.Row="0" Height="40"
                Background="{DynamicResource ThSidebar}"
                BorderBrush="{DynamicResource ThBorder}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseDown">
            <Grid>
                <TextBlock x:Name="TxtPageTitle"
                           Text="Informations Syst&#232;me"
                           Foreground="{DynamicResource ThTextBody}"
                           FontSize="12" FontFamily="{StaticResource AppFont}"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"
                            Orientation="Horizontal" Margin="0,0,6,0">
                    <Button x:Name="BtnMiniMode" Content="&#xE73F;"
                            FontFamily="Segoe MDL2 Assets" FontSize="11"
                            ToolTip="Mode mini (monitoring compact)"
                            Style="{StaticResource WinBtnStyle}"
                            Click="BtnMiniMode_Click"/>
                    <Button x:Name="BtnMinimize" Content="&#xE921;"
                            FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Style="{StaticResource WinBtnStyle}"
                            Click="BtnMinimize_Click"/>
                    <Button x:Name="BtnMaximize" Content="&#xE922;"
                            FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Style="{StaticResource WinBtnStyle}"
                            Click="BtnMaximize_Click"/>
                    <Button x:Name="BtnClose" Content="&#xE8BB;"
                            FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Style="{StaticResource CloseBtnStyle}"
                            Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ CORPS : sidebar + contenu ════════════════════════════════════ -->
        <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="178"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border Grid.Column="0"
                    Background="{DynamicResource ThSidebar}"
                    BorderBrush="{DynamicResource ThBorder}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Logo + zone de drag -->
                    <Border Grid.Row="0" Padding="18,20,18,14"
                            MouseLeftButtonDown="DragBar_MouseDown"
                            Cursor="SizeAll">
                        <StackPanel>
                            <TextBlock FontSize="18" FontWeight="Bold"
                                       FontFamily="{StaticResource AppFont}"><Run Text="Tweak" Foreground="{DynamicResource ThTextTitle}"/><Run Text="ly" Foreground="{DynamicResource ThAccentIcon}"/></TextBlock>
                            <TextBlock x:Name="TxtVersion" Text="v1.5.0"
                                       FontSize="11" Foreground="{DynamicResource ThTextDim}"
                                       FontFamily="{StaticResource AppFont}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Boutons de navigation -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,6,0,12">

                            <!-- ── Accueil (page d'arrivée par défaut, v1.4.3) ── -->
                            <Button x:Name="BtnNavAccueil"
                                    Content="Accueil"
                                    Tag="Accueil"
                                    FontWeight="SemiBold"
                                    Style="{StaticResource NavBtnStyle}"
                                    Click="NavBtn_Click"/>

                            <!-- ── Diagnostiquer : comprendre pourquoi le PC va mal ── -->
                            <Button x:Name="BtnNavDiagGroup"
                                    Content="&#x25B8;  Diagnostiquer"
                                    FontWeight="SemiBold"
                                    Style="{StaticResource NavBtnStyle}"
                                    Click="BtnNavDiagGroup_Click"/>
                            <Border x:Name="DiagGroupPanel"
                                    Visibility="Collapsed"
                                    BorderBrush="{DynamicResource ThAccentIcon}"
                                    BorderThickness="2,0,0,0"
                                    Margin="20,0,8,4">
                                <StackPanel>
                                    <Button Content="Erreurs Windows"
                                            Tag="EventLog"
                                            Style="{StaticResource NavSubBtnStyle}"
                                            Click="NavBtn_Click"/>
                                    <Button Content="Bilan de sant&#233;"
                                            Tag="Diagnostic"
                                            Style="{StaticResource NavSubBtnStyle}"
                                            Click="NavBtn_Click"/>
                                    <Button x:Name="BtnNavInfo"
                                            Content="Informations Syst&#232;me"
                                            Tag="Info"
                                            Style="{StaticResource NavSubBtnStyle}"
                                            Click="NavBtn_Click"/>
                                    <Button x:Name="BtnNavBenchmark"
                                            Content="Tweakly Score"
                                            Tag="Benchmark"
                                            Style="{StaticResource NavSubBtnStyle}"
                                            Click="NavBtn_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- ── Surveiller : valeurs live et sessions jeu ── -->
                            <Button x:Name="BtnNavMonitorGroup"
                                    Content="&#x25B8;  Surveiller"
                                    FontWeight="SemiBold"
                                    Style="{StaticResource NavBtnStyle}"
                                    Click="BtnNavMonitorGroup_Click"/>
                            <Border x:Name="MonitorGroupPanel"
                                    Visibility="Collapsed"
                                    BorderBrush="{DynamicResource ThAccentIcon}"
                                    BorderThickness="2,0,0,0"
                                    Margin="20,0,8,4">
                                <StackPanel>
                                    <Button x:Name="BtnNavMonitoring"
                                            Content="Monitoring Syst&#232;me"
                                            Tag="Monitoring"
                                            Style="{StaticResource NavSubBtnStyle}"
                                            Click="NavBtn_Click"/>
                                    <Button Content="Monitoring R&#233;seau"
                                            Tag="ReseauMon"
                                            Style="{StaticResource NavSubBtnStyle}"
                                            Click="NavBtn_Click"/>
                                    <Button x:Name="BtnNavGameSession"
                                            Content="Suivi en jeu"
                                            Tag="GameSession"
                                            Style="{StaticResource NavSubBtnStyle}"
                                            Click="NavBtn_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- ── Optimiser : appliquer les réglages de perf/confort ── -->
                            <Button x:Name="BtnNavOptimizeGroup"
                                    Content="&#x25B8;  Optimiser"
                                    FontWeight="SemiBold"
                                    Style="{StaticResource NavBtnStyle}"
                                    Click="BtnNavOptimizeGroup_Click"/>
                            <Border x:Name="OptimizeGroupPanel"
                                    Visibility="Collapsed"
                                    BorderBrush="{DynamicResource ThAccentIcon}"
                                    BorderThickness="2,0,0,0"
                                    Margin="20,0,8,4">
                                <StackPanel>
                                    <Button Content="Windows"
                                            Tag="Windows"
                                            Style="{StaticResource NavSubBtnStyle}"
                                            Click="NavBtn_Click"/>
                                    <Button x:Name="BtnNavBattery"
                                            Content="Calibrage Batterie"
                                            Tag="Battery"
                                            Style="{StaticResource NavSubBtnStyle}"
                                            Click="NavBtn_Click"/>
                                    <Button Content="CPU"
                                            Tag="CPU"
                                            Style="{StaticResource NavSubBtnStyle}"
                                            Click="NavBtn_Click"/>
                                    <Button x:Name="BtnNavNvidia"
                                            Content="Nvidia"
                                            Tag="Nvidia"
                                            Style="{StaticResource NavSubBtnStyle}"
                                            Click="NavBtn_Click"/>
                                    <Button x:Name="BtnNavGpuTuning"
                                            Content="Optimisation GPU"
                                            Tag="GpuTuning"
                                            Style="{StaticResource GpuExperimentalNavBtnStyle}"
                                            Click="NavBtn_Click"/>
                                    <Button Content="R&#233;seau"
                                            Tag="Reseau"
                                            Style="{StaticResource NavSubBtnStyle}"
                                            Click="NavBtn_Click"/>
                                    <Button Content="Confidentialit&#233;"
                                            Tag="Privacy"
                                            Style="{StaticResource NavSubBtnStyle}"
                                            Click="NavBtn_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- ── Réparer : nettoyer ou remettre Windows d'aplomb ── -->
                            <Button x:Name="BtnNavRepairGroup"
                                    Content="&#x25B8;  R&#233;parer"
                                    FontWeight="SemiBold"
                                    Style="{StaticResource NavBtnStyle}"
                                    Click="BtnNavRepairGroup_Click"/>
                            <Border x:Name="RepairGroupPanel"
                                    Visibility="Collapsed"
                                    BorderBrush="{DynamicResource ThAccentIcon}"
                                    BorderThickness="2,0,0,0"
                                    Margin="20,0,8,4">
                                <StackPanel>
                                    <Button Content="R&#233;paration Windows"
                                            Tag="WinRepair"
                                            Style="{StaticResource NavSubBtnStyle}"
                                            Click="NavBtn_Click"/>
                                    <Button x:Name="BtnNavNettoyage"
                                            Content="Nettoyage"
                                            Tag="Nettoyage"
                                            Style="{StaticResource NavSubBtnStyle}"
                                            Click="NavBtn_Click"/>
                                    <Button Content="Applications"
                                            Tag="Apps"
                                            Style="{StaticResource NavSubBtnStyle}"
                                            Click="NavBtn_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- ── Réinstaller : pack post-installation pour repartir vite ── -->
                            <Button x:Name="BtnNavPrepareGroup"
                                    Content="&#x25B8;  R&#233;installer"
                                    FontWeight="SemiBold"
                                    Style="{StaticResource NavBtnStyle}"
                                    Click="BtnNavPrepareGroup_Click"/>
                            <Border x:Name="PrepareGroupPanel"
                                    Visibility="Collapsed"
                                    BorderBrush="{DynamicResource ThAccentIcon}"
                                    BorderThickness="2,0,0,0"
                                    Margin="20,0,8,4">
                                <StackPanel>
                                    <Button Content="Pack R&#233;installation"
                                            Tag="Fresh"
                                            Style="{StaticResource NavSubBtnStyle}"
                                            Click="NavBtn_Click"/>
                                </StackPanel>
                            </Border>
                            <Button x:Name="BtnNavReglages"
                                    Content="R&#233;glages"
                                    Tag="Reglages"
                                    Style="{StaticResource NavBtnStyle}"
                                    Click="NavBtn_Click"/>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bas de sidebar : bascules rapides (affichent le mode cible) -->
                    <StackPanel Grid.Row="2" Margin="12,0,0,12" HorizontalAlignment="Left">
                        <Button x:Name="BtnTheme"
                                ToolTip="Basculer le th&#232;me"
                                HorizontalAlignment="Left"
                                Height="30"
                                Margin="0,0,0,7"
                                Cursor="Hand"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="BtnTheme_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" CornerRadius="9"
                                            Background="{DynamicResource ThSecBtn}"
                                            BorderBrush="{DynamicResource ThBorder}"
                                            BorderThickness="1"
                                            Padding="11,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="ThemeIcon"
                                                       Text="&#xE706;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource ThWarn}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock x:Name="ThemeLbl"
                                                       Text="Mode clair"
                                                       Foreground="{DynamicResource ThTextNav}"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThHover}"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThPrimary}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button x:Name="BtnNavModeToggle"
                                ToolTip="Basculer le mode d'utilisation"
                                HorizontalAlignment="Left"
                                Height="30"
                                Margin="0"
                                Cursor="Hand"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="BtnNavModeToggle_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" CornerRadius="9"
                                            Background="{DynamicResource ThSecBtn}"
                                            BorderBrush="{DynamicResource ThBorder}"
                                            BorderThickness="1"
                                            Padding="11,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="NavModeIcon"
                                                       Text="&#xE7EF;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource ThAccentIcon}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock x:Name="NavModeLbl"
                                                       Text="Mode simple"
                                                       Foreground="{DynamicResource ThTextNav}"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThHover}"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThPrimary}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══ COLONNE DROITE : contenu + journal ══════════════════════ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ZONE DE CONTENU -->
                <Grid Grid.Row="0" Background="{DynamicResource ThBg}">

                <!-- Contenu de la page active -->
                <ContentControl x:Name="MainContent"
                                Focusable="False"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"/>
                </Grid><!-- fin ZONE DE CONTENU -->

                <!-- ══ JOURNAL D'ACTIVIT&#201; (repliable) ══════════════════════ -->
                <Border x:Name="ActivityLogPanel"
                        Grid.Row="1"
                        Background="{DynamicResource ThLogBg}"
                        BorderBrush="{DynamicResource ThBorder}"
                        BorderThickness="0,1,0,0">
                    <StackPanel>
                        <!-- En-t&#234;te + bouton repli -->
                        <Grid Height="24" Background="{DynamicResource ThLogHdr}">
                            <TextBlock Text="Journal d'activit&#233;"
                                       Foreground="{DynamicResource ThTextDim}" FontFamily="{StaticResource AppFont}"
                                       FontSize="11" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <Button x:Name="BtnToggleLog"
                                    Content="&#x25B4;"
                                    Style="{StaticResource WinBtnStyle}"
                                    Width="40" Height="20"
                                    HorizontalAlignment="Right" Margin="0,0,6,0"
                                    Click="BtnToggleLog_Click"/>
                        </Grid>
                        <!-- Corps du journal -->
                        <ScrollViewer x:Name="LogScroll"
                                      Visibility="Collapsed"
                                      Height="130"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="12,6,12,8">
                            <TextBlock x:Name="TxtLog"
                                       Foreground="{DynamicResource ThLogText}"
                                       FontFamily="Consolas" FontSize="11.5"
                                       TextWrapping="Wrap" LineHeight="16"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

            </Grid><!-- fin colonne droite -->
        </Grid><!-- fin corps (sidebar + contenu) -->

        <!-- ══ OVERLAY DE MISE À JOUR (couvre toute la fenêtre) ══════════════
             Refonte v1.3.4 (3e passe, design « 2026 » type Linear/Vercel) : fond
             propre, carte plate à liseré 1px, accent dégradé bleu→violet, barre
             fine avec shimmer ANIMÉ, bouton texte pour « Plus tard ».
             (2e passe halo+pilule+3D : REJETÉE par l'utilisateur, ne pas y revenir.) -->
        <Border x:Name="UpdateOverlay" Grid.Row="0" Grid.RowSpan="2"
                Panel.ZIndex="100" Visibility="Collapsed"
                Background="{DynamicResource ThBg}"
                MouseLeftButtonDown="UpdateOverlay_MouseDown">
            <Border.Resources>
                <!-- Accent de la barre : camaïeu 100 % BLEU (le violet a été rejeté par
                     l'utilisateur — rester dans l'identité bleue de Tweakly) -->
                <LinearGradientBrush x:Key="UpdAccent" StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="{DynamicResource ThBlueGradAColor}" Offset="0"/>
                    <GradientStop Color="{DynamicResource ThBlueGradBColor}" Offset="0.6"/>
                    <GradientStop Color="{DynamicResource ThBlueGradCColor}" Offset="1"/>
                </LinearGradientBrush>
                <!-- Bouton principal : bleu PLEIN et plat (cohérent avec les boutons de
                     l'app — le dégradé bleu→violet a été REJETÉ par l'utilisateur ici,
                     l'accent dégradé ne sert que pour la barre de progression) -->
                <Style x:Key="UpdPrimaryBtn" TargetType="Button">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                    <Setter Property="FontSize" Value="12.5"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" CornerRadius="10" Padding="{TemplateBinding Padding}"
                                        Background="{DynamicResource ThBlueLine}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#4F94F0"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#3273C8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <!-- Bouton secondaire (Plus tard) : contour 1px VISIBLE en permanence
                     (la version « texte nu » était invisible tant qu'on ne survolait pas) -->
                <Style x:Key="UpdTextBtn" TargetType="Button">
                    <Setter Property="Foreground" Value="{DynamicResource ThTextNav}"/>
                    <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                    <Setter Property="FontSize" Value="12.5"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" CornerRadius="10" Padding="{TemplateBinding Padding}"
                                        Background="#0A808080" BorderThickness="1"
                                        BorderBrush="#4D808080">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#1A808080"/>
                                        <Setter TargetName="Bg" Property="BorderBrush" Value="#805BA0FF"/>
                                        <Setter Property="Foreground" Value="{DynamicResource ThTextTitle}"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bg" Property="Opacity" Value="0.8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Border.Resources>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="560">
                <!-- Logo, sobre (pas de glow) -->
                <TextBlock HorizontalAlignment="Center" FontSize="34" FontWeight="Bold"
                           FontFamily="{StaticResource AppFont}">
                    <Run Text="Tweak" Foreground="{DynamicResource ThTextTitle}"/><Run Text="ly" Foreground="{DynamicResource ThAccentIcon}"/>
                </TextBlock>

                <TextBlock x:Name="TxtUpdTitle" Text="Mise &#224; jour"
                           HorizontalAlignment="Center" Margin="0,26,0,8"
                           Foreground="{DynamicResource ThTextTitle}"
                           FontFamily="{StaticResource AppFont}" FontSize="20" FontWeight="SemiBold"/>
                <!-- Transition de version, texte nu : la nouvelle version porte l'accent
                     (les Run sont remplis en code — SetUpdateVersions) -->
                <TextBlock HorizontalAlignment="Center" Margin="0,0,0,44"
                           FontFamily="{StaticResource AppFont}" FontSize="13">
                    <Run x:Name="RunUpdFrom" Foreground="{DynamicResource ThTextDim}"/><Run
                         Text="   &#x2192;   " Foreground="{DynamicResource ThTextDim}"/><Run
                         x:Name="RunUpdTo" FontWeight="SemiBold" Foreground="{DynamicResource ThAccentIcon}"/>
                </TextBlock>

                <!-- Carte « Nouveautés » plate : voile très léger + liseré 1px, sans ombre -->
                <Border x:Name="UpdNotesCard" CornerRadius="12" Padding="22,18" Margin="0,0,0,44"
                        Visibility="Collapsed" Background="#0AFFFFFF"
                        BorderBrush="#1A808080" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Nouveaut&#233;s"
                                   FontFamily="{StaticResource AppFont}" FontSize="12"
                                   FontWeight="SemiBold" Foreground="{DynamicResource ThTextTitle}"
                                   Margin="0,0,0,10"/>
                        <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="TxtUpdNotes" TextWrapping="Wrap"
                                       FontFamily="{StaticResource AppFont}" FontSize="12.5"
                                       LineHeight="21"
                                       Foreground="{DynamicResource ThTextNav}"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Ligne statut + pourcentage, au-dessus de la barre (façon installeur moderne) -->
                <Grid Margin="0,0,0,8">
                    <TextBlock x:Name="TxtUpdStatus" Text="T&#233;l&#233;chargement&#8230;"
                               HorizontalAlignment="Left"
                               Foreground="{DynamicResource ThTextDim}"
                               FontFamily="{StaticResource AppFont}" FontSize="12"/>
                    <TextBlock x:Name="TxtUpdPct" Text="0 %" HorizontalAlignment="Right"
                               Foreground="{DynamicResource ThTextNav}"
                               FontFamily="Consolas" FontSize="12"/>
                </Grid>

                <!-- Barre fine : remplissage dégradé accent + SHIMMER animé qui balaye -->
                <Grid Height="6">
                    <Border Background="{DynamicResource ThTrack}" CornerRadius="3"/>
                    <Grid x:Name="UpdBar" ClipToBounds="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0*"/>
                            <ColumnDefinition Width="100*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="3" Background="{StaticResource UpdAccent}"
                                ClipToBounds="True">
                            <!-- Bande lumineuse qui traverse le remplissage en boucle -->
                            <Border Width="110" HorizontalAlignment="Left" CornerRadius="3">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                                        <GradientStop Color="#66FFFFFF" Offset="0.5"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="UpdShimmer" X="-120"/>
                                </Border.RenderTransform>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Border.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="UpdShimmer"
                                                                 Storyboard.TargetProperty="X"
                                                                 From="-120" To="600" Duration="0:0:2.4"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                            </Border>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Réassurances : ligne discrète, séparateurs points médians -->
                <TextBlock HorizontalAlignment="Center" Margin="0,18,0,0"
                           FontFamily="{StaticResource AppFont}" FontSize="11"
                           Foreground="{DynamicResource ThTextDim}">
                    <Run Text="&#x2713;" Foreground="{DynamicResource ThOk}"/><Run Text=" R&#233;glages conserv&#233;s"/>
                    <Run Text="   &#183;   "/>
                    <Run Text="&#x2713;" Foreground="{DynamicResource ThOk}"/><Run Text=" Int&#233;grit&#233; v&#233;rifi&#233;e"/>
                    <Run Text="   &#183;   "/>
                    <Run Text="&#x2713;" Foreground="{DynamicResource ThOk}"/><Run Text=" Red&#233;marrage automatique"/>
                </TextBlock>

                <!-- Boutons : Plus tard (texte) + Continuer (accent), alignés à droite de la zone -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,46,0,0">
                    <Button x:Name="BtnUpdLater" Content="Plus tard"
                            Style="{StaticResource UpdTextBtn}"
                            Margin="0,0,12,0" Padding="24,11"
                            Click="BtnUpdLater_Click"/>
                    <Button x:Name="BtnUpdContinue" Content="Mettre &#224; jour maintenant"
                            Visibility="Collapsed"
                            Style="{StaticResource UpdPrimaryBtn}"
                            Padding="28,11"
                            Click="BtnUpdContinue_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid><!-- fin grille principale -->
</Window>
