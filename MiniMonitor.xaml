<Window x:Class="Optimisation_Tool.MiniMonitor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tweakly — Mini"
        Width="360" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="True"
        Icon="Tweakly.ico"
        WindowStartupLocation="Manual"
        Loaded="Window_Loaded" Closing="Window_Closing">

    <Window.Resources>
        <!-- Petite légende (catégorie) -->
        <Style x:Key="MiCap" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThTextDim}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize"   Value="9.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <!-- Grand chiffre -->
        <Style x:Key="MiBig" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThTextTitle}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize"   Value="23"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <!-- Petit détail (température / sous-ligne) -->
        <Style x:Key="MiSub" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThTextDim}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize"   Value="10.5"/>
        </Style>
    </Window.Resources>

    <!-- Bordure arrondie = corps de la fenêtre (drag depuis n'importe où) -->
    <Border x:Name="RootBorder"
            Background="{DynamicResource ThBg}"
            BorderBrush="{DynamicResource ThBorder}"
            BorderThickness="1" CornerRadius="12"
            MouseLeftButtonDown="Root_MouseDown">
        <StackPanel Margin="14,10,14,12">

            <!-- En-tête : logo mini + bouton retour -->
            <Grid Margin="0,0,0,10">
                <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="Bold"
                           FontFamily="{StaticResource AppFont}"><Run Text="Tweak" Foreground="{DynamicResource ThTextTitle}"/><Run Text="ly" Foreground="{DynamicResource ThAccentIcon}"/><Run Text="  ·  mini" Foreground="{DynamicResource ThTextDim}" FontSize="10" FontWeight="SemiBold"/></TextBlock>
                <Button x:Name="BtnReturn"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="28" Height="24" Cursor="Hand"
                        ToolTip="Revenir à la version complète"
                        Click="BtnReturn_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{DynamicResource ThSecBtn}"
                                    CornerRadius="6">
                                <TextBlock Text="&#xE740;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="11" Foreground="{DynamicResource ThTextNav}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Rangée système : CPU / RAM / GPU -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- CPU -->
                <Border Grid.Column="0" Background="{DynamicResource ThPanel}"
                        BorderBrush="{DynamicResource ThBorder}" BorderThickness="1"
                        CornerRadius="9" Padding="10,8" Margin="0,0,5,0">
                    <StackPanel>
                        <TextBlock Text="CPU" Style="{StaticResource MiCap}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock x:Name="TxtCpu" Text="—" Style="{StaticResource MiBig}" Foreground="{DynamicResource ThAccentIcon}"/>
                            <TextBlock Text="%" Foreground="{DynamicResource ThAccentIcon}" FontSize="11" FontWeight="Bold"
                                       FontFamily="{StaticResource AppFont}"
                                       VerticalAlignment="Bottom" Margin="1,0,0,4"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtCpuFreq" Text="—" Style="{StaticResource MiSub}"/>
                    </StackPanel>
                </Border>

                <!-- RAM -->
                <Border Grid.Column="1" Background="{DynamicResource ThPanel}"
                        BorderBrush="{DynamicResource ThBorder}" BorderThickness="1"
                        CornerRadius="9" Padding="10,8" Margin="5,0,5,0">
                    <StackPanel>
                        <TextBlock Text="RAM" Style="{StaticResource MiCap}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock x:Name="TxtRam" Text="—" Style="{StaticResource MiBig}" Foreground="{DynamicResource ThViolet}"/>
                            <TextBlock Text="%" Foreground="{DynamicResource ThViolet}" FontSize="11" FontWeight="Bold"
                                       FontFamily="{StaticResource AppFont}"
                                       VerticalAlignment="Bottom" Margin="1,0,0,4"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtRamFree" Text="—" Style="{StaticResource MiSub}"/>
                    </StackPanel>
                </Border>

                <!-- GPU -->
                <Border Grid.Column="2" Background="{DynamicResource ThPanel}"
                        BorderBrush="{DynamicResource ThBorder}" BorderThickness="1"
                        CornerRadius="9" Padding="10,8" Margin="5,0,0,0">
                    <StackPanel>
                        <TextBlock Text="GPU" Style="{StaticResource MiCap}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock x:Name="TxtGpu" Text="—" Style="{StaticResource MiBig}" Foreground="{DynamicResource ThOk}"/>
                            <TextBlock Text="%" Foreground="{DynamicResource ThOk}" FontSize="11" FontWeight="Bold"
                                       FontFamily="{StaticResource AppFont}"
                                       VerticalAlignment="Bottom" Margin="1,0,0,4"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtGpuTemp" Text="—" Style="{StaticResource MiSub}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Bande réseau -->
            <Border Background="{DynamicResource ThPanel}"
                    BorderBrush="{DynamicResource ThBorder}" BorderThickness="1"
                    CornerRadius="9" Padding="10,8" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Ping + verdict -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="RÉSEAU" Style="{StaticResource MiCap}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock x:Name="TxtPing" Text="—" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource ThTextTitle}"
                                       FontFamily="{StaticResource AppFont}" VerticalAlignment="Bottom"/>
                            <TextBlock Text="ms" Foreground="{DynamicResource ThTextDim}" FontSize="10"
                                       FontFamily="{StaticResource AppFont}"
                                       VerticalAlignment="Bottom" Margin="2,0,0,3"/>
                        </StackPanel>
                    </StackPanel>

                    <Border x:Name="PillVerdict" Grid.Column="1"
                            VerticalAlignment="Center" Margin="12,0,0,0"
                            CornerRadius="7" Padding="9,3"
                            Background="{DynamicResource ThSecBtn}">
                        <TextBlock x:Name="TxtVerdict" Text="—"
                                   Foreground="White" FontSize="10" FontWeight="Bold"
                                   FontFamily="{StaticResource AppFont}"/>
                    </Border>

                    <!-- Débit ↓ / ↑ -->
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="&#x2193; " Foreground="{DynamicResource ThOk}" FontSize="11" FontWeight="Bold"
                                       FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtDown" Text="—" Foreground="{DynamicResource ThTextBody}"
                                       FontSize="11.5" FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>
                            <TextBlock Text=" Mb/s" Foreground="{DynamicResource ThTextDim}" FontSize="9.5"
                                       FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                            <TextBlock Text="&#x2191; " Foreground="{DynamicResource ThAccentIcon}" FontSize="11" FontWeight="Bold"
                                       FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtUp" Text="—" Foreground="{DynamicResource ThTextBody}"
                                       FontSize="11.5" FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>
                            <TextBlock Text=" Mb/s" Foreground="{DynamicResource ThTextDim}" FontSize="9.5"
                                       FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </Border>
</Window>
