<UserControl x:Class="Optimisation_Tool.Pages.PageDiagnostic"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <!-- Tuile -->
        <Style x:Key="DTile" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource ThPanel}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource ThBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="12"/>
            <Setter Property="Padding"         Value="18,16"/>
        </Style>
        <!-- En-tête de catégorie -->
        <Style x:Key="DCat" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThTextDim}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin"     Value="2,0,0,8"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18,16,18,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ CARTE RÉSUMÉ ══ -->
        <Border Grid.Row="0" Style="{StaticResource DTile}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="BILAN DE SANTÉ"
                               Foreground="{DynamicResource ThTextDim}"
                               FontFamily="{StaticResource AppFont}" FontSize="11" FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <!-- OK -->
                        <Ellipse Width="11" Height="11" Fill="{DynamicResource ThOk}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtOk" Text="—"
                                   Foreground="{DynamicResource ThTextBody}" FontFamily="{StaticResource AppFont}"
                                   FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,4,0"/>
                        <TextBlock Text="OK" Foreground="{DynamicResource ThTextDim}"
                                   FontFamily="{StaticResource AppFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,22,0"/>
                        <!-- Avertissements -->
                        <Ellipse Width="11" Height="11" Fill="{DynamicResource ThWarn}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtWarn" Text="—"
                                   Foreground="{DynamicResource ThTextBody}" FontFamily="{StaticResource AppFont}"
                                   FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,4,0"/>
                        <TextBlock Text="avertissements" Foreground="{DynamicResource ThTextDim}"
                                   FontFamily="{StaticResource AppFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,22,0"/>
                        <!-- Critiques -->
                        <Ellipse Width="11" Height="11" Fill="{DynamicResource ThCrit}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtCrit" Text="—"
                                   Foreground="{DynamicResource ThTextBody}" FontFamily="{StaticResource AppFont}"
                                   FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,4,0"/>
                        <TextBlock Text="critiques" Foreground="{DynamicResource ThTextDim}"
                                   FontFamily="{StaticResource AppFont}" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <Button x:Name="BtnScan" Grid.Column="1"
                        Content="RELANCER LE DIAGNOSTIC"
                        Style="{StaticResource CleanRunBtn}" Padding="20,10"
                        VerticalAlignment="Center"
                        Click="BtnScan_Click"/>
            </Grid>
        </Border>

        <!-- ══ RÉSULTATS ══ -->
        <ScrollViewer Grid.Row="1" Margin="0,12,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ResultsPanel"/>
        </ScrollViewer>

        <!-- ══ BARRE DE STATUT ══ -->
        <Border Grid.Row="2"
                Background="{DynamicResource ThSidebar}"
                BorderBrush="{DynamicResource ThBorder}"
                BorderThickness="0,1,0,0"
                Padding="18,7" Margin="0,12,0,0"
                CornerRadius="8">
            <TextBlock x:Name="TxtStatus" Text="Prêt."
                       Foreground="{DynamicResource ThTextDim}"
                       FontFamily="{StaticResource AppFont}" FontSize="11.5"/>
        </Border>
    </Grid>
</UserControl>
