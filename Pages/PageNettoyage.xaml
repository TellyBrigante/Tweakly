<UserControl x:Class="Optimisation_Tool.Pages.PageNettoyage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Loaded="UserControl_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="18,14,18,18">

            <CheckBox x:Name="ChkTemp"
                      Content="Dossier %temp% (Cache utilisateur)"
                      Style="{StaticResource TweakChkStyle}"
                      IsChecked="False"/>
            <CheckBox x:Name="ChkSystemTemp"
                      Content="Dossier Windows Temp (Cache syst&#232;me)"
                      Style="{StaticResource TweakChkStyle}"
                      IsChecked="False"/>
            <CheckBox x:Name="ChkPrefetch"
                      Content="Dossier Windows Prefetch"
                      Style="{StaticResource TweakChkStyle}"
                      IsChecked="False"/>
            <CheckBox x:Name="ChkDXCache"
                      Content="Cache de Shaders DirectX (Windows)"
                      Style="{StaticResource TweakChkStyle}"
                      IsChecked="False"/>
            <CheckBox x:Name="ChkNvCache"
                      Content="Cache GL &amp; Shaders NVIDIA"
                      Style="{StaticResource TweakChkStyle}"
                      IsChecked="False"/>
            <CheckBox x:Name="ChkTrimSSD"
                      Content="Trim SSD (lib&#232;re les blocs inutilis&#233;s sur tous les SSD)"
                      Style="{StaticResource TweakChkStyle}"
                      IsChecked="False"/>
            <CheckBox x:Name="ChkEventLogs"
                      Content="Journaux d'&#233;v&#233;nements Windows (peuvent atteindre plusieurs Go)"
                      Style="{StaticResource TweakChkStyle}"
                      IsChecked="False"/>
            <CheckBox x:Name="ChkResidues"
                      Content="R&#233;sidus de logiciels d&#233;sinstall&#233;s (raccourcis cass&#233;s + entr&#233;es registre orphelines)"
                      Style="{StaticResource TweakChkStyle}"
                      IsChecked="False"/>

            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <Button x:Name="BtnLancer"
                        Content="EX&#201;CUTER LE NETTOYAGE"
                        Style="{StaticResource PrimaryBtnStyle}"
                        Click="BtnLancer_Click"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
