<UserControl x:Class="Optimisation_Tool.Pages.PageSpecs"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Loaded="UserControl_Loaded"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <Style x:Key="TileStyle" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource ThPanel}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource ThBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Padding"         Value="14,12"/>
            <Setter Property="MinHeight"       Value="76"/>
        </Style>

        <Style x:Key="TileLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThTextLabel}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize"   Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin"     Value="0,0,0,7"/>
        </Style>

        <Style x:Key="TileValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground"   Value="{DynamicResource ThTextBody}"/>
            <Setter Property="FontFamily"   Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize"     Value="11.5"/>
            <Setter Property="LineHeight"   Value="18"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="FirmwareRoleText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThTextDim}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Role}" Value="ThTextBody">
                    <Setter Property="Foreground" Value="{DynamicResource ThTextBody}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Role}" Value="ThAccentIcon">
                    <Setter Property="Foreground" Value="{DynamicResource ThAccentIcon}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Role}" Value="ThOk">
                    <Setter Property="Foreground" Value="{DynamicResource ThOk}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Role}" Value="ThWarn">
                    <Setter Property="Foreground" Value="{DynamicResource ThWarn}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Role}" Value="ThCrit">
                    <Setter Property="Foreground" Value="{DynamicResource ThCrit}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FirmwareRoleAccent" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThTextDim}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Role}" Value="ThTextBody">
                    <Setter Property="Background" Value="{DynamicResource ThTextBody}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Role}" Value="ThAccentIcon">
                    <Setter Property="Background" Value="{DynamicResource ThAccentIcon}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Role}" Value="ThOk">
                    <Setter Property="Background" Value="{DynamicResource ThOk}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Role}" Value="ThWarn">
                    <Setter Property="Background" Value="{DynamicResource ThWarn}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Role}" Value="ThCrit">
                    <Setter Property="Background" Value="{DynamicResource ThCrit}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThTextSub}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize"   Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="ActionBtnStyle" TargetType="Button">
            <Setter Property="Background"        Value="{DynamicResource ThSecBtn}"/>
            <Setter Property="Foreground"        Value="{DynamicResource ThTextNav}"/>
            <Setter Property="BorderBrush"       Value="{DynamicResource ThBorder}"/>
            <Setter Property="BorderThickness"   Value="1"/>
            <Setter Property="Padding"           Value="13,6"/>
            <Setter Property="FontFamily"        Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize"          Value="11.5"/>
            <Setter Property="Cursor"            Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock x:Name="Lbl"
                                       Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd"  Property="Background" Value="{DynamicResource ThSelection}"/>
                                <Setter TargetName="Lbl" Property="Foreground" Value="{DynamicResource ThTextTitle}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThSidebar}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd"  Property="Background" Value="{DynamicResource ThPanel}"/>
                                <Setter TargetName="Lbl" Property="Foreground" Value="{DynamicResource ThTextDim}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ════════ DESIGN 2026 v2 — Bento, glass, typo brutaliste ════════
             Inspirations : Linear, Vercel dashboards, Apple Bento layouts.
             Principes :
               - UNE couleur accent (bleu Tweakly), pas un arc-en-ciel
               - Cartes glass (background semi-transparent + bordure très fine)
               - Drop shadows quasi invisibles (BlurRadius 40 / Opacity 0.07)
               - Layout asymétrique (column spans variables)
               - Typo hiérarchisée : composant en grand, specs en sous-texte
               - Zéro icône badge multicolore, juste micro-glyphes monochromes -->

        <!-- Couleur accent unique réutilisée partout -->
        <SolidColorBrush x:Key="AccentBlue"     Color="{DynamicResource ThBlueGradBColor}"/>
        <SolidColorBrush x:Key="AccentBlueDim"  Color="#1F5BA0FF"/>

        <!-- BENTO CARD : glass subtle + ombre quasi invisible + hover discret (compat) -->
        <Style x:Key="BentoCard" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource ThPanel}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource ThBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="16"/>
            <Setter Property="Padding"         Value="26,22,26,22"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="2" Direction="270"
                                      Opacity="0.10" Color="Black" RenderingBias="Quality"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- BENTO 3D v3.1 : élévation qui RESPECTE LE THÈME.
             - Background = ThPanel (dynamique dark/light)
             - Highlight border en alpha (marche en dark ET light, indépendant de la teinte)
             - Drop shadow modérée : l'effet 3D vient de l'ombre + du highlight border
             - Padding et tailles réduites (~40%) pour ne pas écraser -->
        <Style x:Key="Bento3D" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource ThPanel}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="14"/>
            <Setter Property="Padding"         Value="20,18,20,18"/>
            <Setter Property="MinHeight"       Value="130"/>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <!-- Highlight border : alpha-blanc en haut (reflet) → alpha-noir en bas
                         (ombre). Marche en dark ET light puisque c'est de l'alpha pur, pas
                         une teinte qui pourrait jurer avec le fond. -->
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#26FFFFFF" Offset="0"/>
                        <GradientStop Color="#08FFFFFF" Offset="0.5"/>
                        <GradientStop Color="#0A000000" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <!-- Drop shadow modérée pour l'élévation 3D (l'ombre porte, le highlight border crée le reflet) -->
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270"
                                      Opacity="0.28" Color="Black" RenderingBias="Quality"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="38" ShadowDepth="10" Direction="270"
                                              Opacity="0.38" Color="Black" RenderingBias="Quality"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Micro-glyphe MDL2 en accent bleu, discret (utilisé en haut à gauche
             des cartes pour signaler le type, à la place des badges colorés). -->
        <Style x:Key="MicroGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBlue}"/>
            <Setter Property="Margin"     Value="0,0,9,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Étiquette de catégorie (8.5pt Bold tracking, ultra discret en haut de carte) -->
        <Style x:Key="BentoLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThTextDim}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize"   Value="9.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ════════ SCHÉMA MACHINE (v1.3.3) ════════ -->

        <!-- Nœud du schéma : carte cliquable, glow accent au survol (effet « circuit alimenté ») -->
        <Style x:Key="SchemaNode" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource ThPanel}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource ThBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="12"/>
            <Setter Property="Padding"         Value="16,12"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource ThBlueGradB}"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="{DynamicResource ThBlueGradBColor}" BlurRadius="18" ShadowDepth="0" Opacity="0.45"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Étiquette de catégorie d'un nœud -->
        <Style x:Key="SchemaCat" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThTextDim}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize"   Value="9.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Étiquette de lien (bus) sur une trace -->
        <Style x:Key="SchemaLink" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThBlueGradB}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize"   Value="9.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="18,14,18,18">

            <!-- ══ Sous-onglets : Spécifications / Compatibilité / BIOS ═══════ -->
            <Border Background="{DynamicResource ThBg}"
                    BorderBrush="{DynamicResource ThBorder}" BorderThickness="1"
                    CornerRadius="10" Padding="4"
                    HorizontalAlignment="Left" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnTabSpecs" Click="BtnTabSpecs_Click" Cursor="Hand" Height="32" Width="150">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" CornerRadius="7" Background="Transparent">
                                    <TextBlock x:Name="Lbl" Text="Sp&#233;cifications"
                                               Foreground="{DynamicResource ThTextDim}"
                                               FontFamily="{StaticResource AppFont}" FontSize="12" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="BtnTabCompat" Click="BtnTabCompat_Click" Cursor="Hand" Height="32" Width="190">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" CornerRadius="7" Background="Transparent">
                                    <TextBlock x:Name="Lbl" Text="Compatibilit&#233; PCIe / M.2"
                                               Foreground="{DynamicResource ThTextDim}"
                                               FontFamily="{StaticResource AppFont}" FontSize="12" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="BtnTabBios" Click="BtnTabBios_Click" Cursor="Hand" Height="32" Width="150">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" CornerRadius="7" Background="Transparent">
                                    <TextBlock x:Name="Lbl" Text="R&#233;glages BIOS"
                                               Foreground="{DynamicResource ThTextDim}"
                                               FontFamily="{StaticResource AppFont}" FontSize="12" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ════════════ CARTE MÈRE ILLUSTRÉE (v1.3.3) ════════════
                 Une carte mère ATX stylisée dessinée en vectoriel : socket CPU, slots RAM
                 (remplis selon la config RÉELLE de l'utilisateur), slots PCIe (le GPU est
                 « branché » dans le x16), M.2, chipset, SATA, ATX 24-pin, pile CMOS, vis.
                 Les composants réels sont en callouts reliés aux zones, tout est cliquable
                 (zones de la carte ET callouts) → détail dans SpecDetailZone.
                 L'illustration garde des couleurs PCB sombres fixes dans les deux thèmes
                 (c'est une illustration, comme une image). -->
            <StackPanel x:Name="PanelSpecs">

                <!-- Conteneur tuile : encadre l'illustration (sombre par design) pour
                     qu'elle s'integre aussi en MODE CLAIR (sinon le PCB sombre jure
                     directement sur le fond clair de la page). -->
                <Border Background="{DynamicResource ThPanel}"
                        BorderBrush="{DynamicResource ThBorder}" BorderThickness="1"
                        CornerRadius="12" Padding="10,14">
                <Viewbox Stretch="Uniform" MaxHeight="530">
                    <Grid Width="900" Height="600">

                        <!-- ═════ LA CARTE MÈRE (PCB) ═════ -->
                        <Border Width="380" Height="560" HorizontalAlignment="Center" VerticalAlignment="Center"
                                CornerRadius="8" BorderThickness="1.5" BorderBrush="#46557F">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1A2542" Offset="0"/>
                                    <GradientStop Color="#131D38" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <!-- Ombre portée : détache la carte du fond de page -->
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270"
                                                  Opacity="0.55" Color="Black"/>
                            </Border.Effect>
                            <Canvas Width="377" Height="557" ClipToBounds="True">

                                <!-- Traces décoratives en filigrane -->
                                <Polyline Points="20,520 20,470 70,470 70,430" Stroke="#27335C" StrokeThickness="1.5"/>
                                <Polyline Points="34,520 34,484 84,484 84,440" Stroke="#27335C" StrokeThickness="1.5"/>
                                <Polyline Points="330,30 330,80 290,80 290,120" Stroke="#27335C" StrokeThickness="1.5"/>
                                <Polyline Points="344,36 344,94 304,94 304,130" Stroke="#27335C" StrokeThickness="1.5"/>
                                <Polyline Points="120,460 180,460 180,500 240,500" Stroke="#27335C" StrokeThickness="1.5"/>

                                <!-- Vis de fixation (4 coins + centre) -->
                                <Ellipse Canvas.Left="8"   Canvas.Top="8"   Width="10" Height="10" Fill="#3A4870" Stroke="#56689E" StrokeThickness="1"/>
                                <Ellipse Canvas.Left="359" Canvas.Top="8"   Width="10" Height="10" Fill="#3A4870" Stroke="#56689E" StrokeThickness="1"/>
                                <Ellipse Canvas.Left="8"   Canvas.Top="539" Width="10" Height="10" Fill="#3A4870" Stroke="#56689E" StrokeThickness="1"/>
                                <Ellipse Canvas.Left="359" Canvas.Top="539" Width="10" Height="10" Fill="#3A4870" Stroke="#56689E" StrokeThickness="1"/>

                                <!-- Panneau I/O (bord gauche haut) -->
                                <Border Canvas.Left="14" Canvas.Top="26" Width="44" Height="150"
                                        Background="#243052" BorderBrush="#46557F" BorderThickness="1" CornerRadius="3">
                                    <StackPanel Margin="7,9">
                                        <Border Height="11" Background="#0E1526" BorderBrush="#46557F" BorderThickness="1" Margin="0,0,0,5" CornerRadius="1"/>
                                        <Border Height="11" Background="#0E1526" BorderBrush="#46557F" BorderThickness="1" Margin="0,0,0,5" CornerRadius="1"/>
                                        <Border Height="8"  Background="#0E1526" BorderBrush="#46557F" BorderThickness="1" Margin="0,0,0,5" CornerRadius="1"/>
                                        <Border Height="8"  Background="#0E1526" BorderBrush="#46557F" BorderThickness="1" Margin="0,0,0,5" CornerRadius="1"/>
                                        <Border Height="11" Background="#0E1526" BorderBrush="#46557F" BorderThickness="1" Margin="0,0,0,5" CornerRadius="1"/>
                                        <Border Height="8"  Background="#0E1526" BorderBrush="#46557F" BorderThickness="1" CornerRadius="1"/>
                                    </StackPanel>
                                </Border>

                                <!-- Radiateurs VRM (autour du socket) -->
                                <Border Canvas.Left="72" Canvas.Top="26" Width="150" Height="26"
                                        Background="#2C3962" BorderBrush="#4C5C94" BorderThickness="1" CornerRadius="3">
                                    <UniformGrid Rows="1" Columns="9" Margin="3">
                                        <Border Background="#384670" Margin="1,0"/><Border Background="#384670" Margin="1,0"/>
                                        <Border Background="#384670" Margin="1,0"/><Border Background="#384670" Margin="1,0"/>
                                        <Border Background="#384670" Margin="1,0"/><Border Background="#384670" Margin="1,0"/>
                                        <Border Background="#384670" Margin="1,0"/><Border Background="#384670" Margin="1,0"/>
                                        <Border Background="#384670" Margin="1,0"/>
                                    </UniformGrid>
                                </Border>
                                <Border Canvas.Left="66" Canvas.Top="62" Width="24" Height="120"
                                        Background="#2C3962" BorderBrush="#4C5C94" BorderThickness="1" CornerRadius="3">
                                    <UniformGrid Columns="1" Rows="8" Margin="3">
                                        <Border Background="#384670" Margin="0,1"/><Border Background="#384670" Margin="0,1"/>
                                        <Border Background="#384670" Margin="0,1"/><Border Background="#384670" Margin="0,1"/>
                                        <Border Background="#384670" Margin="0,1"/><Border Background="#384670" Margin="0,1"/>
                                        <Border Background="#384670" Margin="0,1"/><Border Background="#384670" Margin="0,1"/>
                                    </UniformGrid>
                                </Border>

                                <!-- ▸ SOCKET CPU (cliquable) -->
                                <Border x:Name="ZoneCpu" Canvas.Left="100" Canvas.Top="64" Width="118" Height="118"
                                        Background="#1B2440" BorderBrush="#56689E" BorderThickness="1.5" CornerRadius="4"
                                        Cursor="Hand" MouseLeftButtonUp="NodeCpu_Click">
                                    <Grid>
                                        <!-- trous de fixation -->
                                        <Ellipse Width="6" Height="6" Fill="#0E1526" HorizontalAlignment="Left"  VerticalAlignment="Top"    Margin="5"/>
                                        <Ellipse Width="6" Height="6" Fill="#0E1526" HorizontalAlignment="Right" VerticalAlignment="Top"    Margin="5"/>
                                        <Ellipse Width="6" Height="6" Fill="#0E1526" HorizontalAlignment="Left"  VerticalAlignment="Bottom" Margin="5"/>
                                        <Ellipse Width="6" Height="6" Fill="#0E1526" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="5"/>
                                        <!-- le die (IHS) -->
                                        <Border Width="64" Height="64" CornerRadius="3" BorderBrush="#4A5880" BorderThickness="1">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#3C4B7A" Offset="0"/>
                                                    <GradientStop Color="#2B3860" Offset="0.5"/>
                                                    <GradientStop Color="#3C4B7A" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="CPU" Foreground="#8193CC"
                                                       FontFamily="{StaticResource AppFont}" FontSize="10" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- ▸ SLOTS RAM ×4 (cliquables, remplis selon la config réelle) -->
                                <Border x:Name="ZoneRam" Canvas.Left="240" Canvas.Top="40" Width="104" Height="220"
                                        Background="Transparent" Cursor="Hand" MouseLeftButtonUp="NodeRam_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Border x:Name="RamStick0" Width="15" Height="216" Margin="0,2,9,0"
                                                CornerRadius="2" BorderThickness="1"
                                                BorderBrush="#46557F" Background="#0E1526"/>
                                        <Border x:Name="RamStick1" Width="15" Height="216" Margin="0,2,9,0"
                                                CornerRadius="2" BorderThickness="1"
                                                BorderBrush="#46557F" Background="#0E1526"/>
                                        <Border x:Name="RamStick2" Width="15" Height="216" Margin="0,2,9,0"
                                                CornerRadius="2" BorderThickness="1"
                                                BorderBrush="#46557F" Background="#0E1526"/>
                                        <Border x:Name="RamStick3" Width="15" Height="216" Margin="0,2,0,0"
                                                CornerRadius="2" BorderThickness="1"
                                                BorderBrush="#46557F" Background="#0E1526"/>
                                    </StackPanel>
                                </Border>

                                <!-- ATX 24-pin (bord droit) -->
                                <Border Canvas.Left="352" Canvas.Top="290" Width="16" Height="86"
                                        Background="#243052" BorderBrush="#46557F" BorderThickness="1" CornerRadius="2">
                                    <UniformGrid Columns="2" Rows="12" Margin="2">
                                        <Ellipse Fill="#0E1526" Margin="1"/><Ellipse Fill="#0E1526" Margin="1"/>
                                        <Ellipse Fill="#0E1526" Margin="1"/><Ellipse Fill="#0E1526" Margin="1"/>
                                        <Ellipse Fill="#0E1526" Margin="1"/><Ellipse Fill="#0E1526" Margin="1"/>
                                        <Ellipse Fill="#0E1526" Margin="1"/><Ellipse Fill="#0E1526" Margin="1"/>
                                        <Ellipse Fill="#0E1526" Margin="1"/><Ellipse Fill="#0E1526" Margin="1"/>
                                        <Ellipse Fill="#0E1526" Margin="1"/><Ellipse Fill="#0E1526" Margin="1"/>
                                        <Ellipse Fill="#0E1526" Margin="1"/><Ellipse Fill="#0E1526" Margin="1"/>
                                        <Ellipse Fill="#0E1526" Margin="1"/><Ellipse Fill="#0E1526" Margin="1"/>
                                        <Ellipse Fill="#0E1526" Margin="1"/><Ellipse Fill="#0E1526" Margin="1"/>
                                        <Ellipse Fill="#0E1526" Margin="1"/><Ellipse Fill="#0E1526" Margin="1"/>
                                        <Ellipse Fill="#0E1526" Margin="1"/><Ellipse Fill="#0E1526" Margin="1"/>
                                        <Ellipse Fill="#0E1526" Margin="1"/><Ellipse Fill="#0E1526" Margin="1"/>
                                    </UniformGrid>
                                </Border>

                                <!-- ▸ M.2 (cliquable → stockage) -->
                                <Border x:Name="ZoneM2" Canvas.Left="100" Canvas.Top="206" Width="150" Height="18"
                                        Background="#243052" BorderBrush="#46557F" BorderThickness="1" CornerRadius="2"
                                        Cursor="Hand" MouseLeftButtonUp="NodeSto_Click">
                                    <Grid>
                                        <Border Width="120" Height="10" HorizontalAlignment="Left" Margin="4,0,0,0"
                                                Background="#33406A" CornerRadius="1"/>
                                        <Ellipse Width="7" Height="7" Fill="#3A4870" Stroke="#56689E" StrokeThickness="1"
                                                 HorizontalAlignment="Right" Margin="0,0,4,0"/>
                                        <TextBlock Text="M.2" Foreground="#8193CC" FontSize="7" FontWeight="Bold"
                                                   FontFamily="{StaticResource AppFont}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- ▸ PCIe x16 avec GPU branché (cliquable → GPU) -->
                                <Border x:Name="ZoneGpu" Canvas.Left="24" Canvas.Top="248" Width="300" Height="40"
                                        Background="Transparent" Cursor="Hand" MouseLeftButtonUp="NodeGpu_Click">
                                    <Grid>
                                        <!-- le slot -->
                                        <Border VerticalAlignment="Bottom" Height="14"
                                                Background="#243052" BorderBrush="#46557F" BorderThickness="1" CornerRadius="2"/>
                                        <!-- la carte graphique enfichée (de profil) -->
                                        <Border VerticalAlignment="Top" Height="26" Margin="10,0,30,0" CornerRadius="3,3,1,1"
                                                BorderBrush="#5468A8" BorderThickness="1">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#243056" Offset="0"/>
                                                    <GradientStop Color="#243052" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Grid>
                                                <!-- ventilateurs -->
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
                                                    <Ellipse Width="16" Height="16" Stroke="#5468A8" StrokeThickness="1.5" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <Ellipse Width="16" Height="16" Stroke="#5468A8" StrokeThickness="1.5" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="GPU" Foreground="{DynamicResource ThBlueGradB}" FontSize="9" FontWeight="Bold"
                                                           FontFamily="{StaticResource AppFont}"
                                                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                                <TextBlock Canvas.Left="26" Canvas.Top="290" Text="PCIe ×16" Foreground="#56689E"
                                           FontSize="7.5" FontWeight="Bold" FontFamily="{StaticResource AppFont}"/>

                                <!-- PCIe x1 + 2e x16 (vides, décoratifs) -->
                                <Border Canvas.Left="24" Canvas.Top="312" Width="80" Height="11"
                                        Background="#1C2747" BorderBrush="#33406A" BorderThickness="1" CornerRadius="2"/>
                                <Border Canvas.Left="24" Canvas.Top="338" Width="300" Height="13"
                                        Background="#1C2747" BorderBrush="#33406A" BorderThickness="1" CornerRadius="2"/>

                                <!-- 2e M.2 (décoratif, sous les PCIe) -->
                                <Border Canvas.Left="100" Canvas.Top="368" Width="150" Height="16"
                                        Background="#1C2747" BorderBrush="#33406A" BorderThickness="1" CornerRadius="2"/>

                                <!-- ▸ CHIPSET avec heatsink (cliquable → carte mère) -->
                                <Border x:Name="ZoneMb" Canvas.Left="252" Canvas.Top="400" Width="92" Height="92"
                                        BorderBrush="#4C5C94" BorderThickness="1.5" CornerRadius="6"
                                        Cursor="Hand" MouseLeftButtonUp="NodeMb_Click">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#2F3C66" Offset="0"/>
                                            <GradientStop Color="#243052" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <!-- stries diagonales du heatsink -->
                                        <Line X1="14" Y1="0" X2="0" Y2="14" Stroke="#46557F" StrokeThickness="2"/>
                                        <Line X1="38" Y1="0" X2="0" Y2="38" Stroke="#46557F" StrokeThickness="2"/>
                                        <Line X1="62" Y1="0" X2="0" Y2="62" Stroke="#46557F" StrokeThickness="2"/>
                                        <Line X1="86" Y1="0" X2="0" Y2="86" Stroke="#46557F" StrokeThickness="2"/>
                                        <Line X1="89" Y1="22" X2="22" Y2="89" Stroke="#46557F" StrokeThickness="2"/>
                                        <Line X1="89" Y1="46" X2="46" Y2="89" Stroke="#46557F" StrokeThickness="2"/>
                                        <Line X1="89" Y1="70" X2="70" Y2="89" Stroke="#46557F" StrokeThickness="2"/>
                                        <TextBlock Text="CHIPSET" Foreground="#8193CC" FontSize="8" FontWeight="Bold"
                                                   FontFamily="{StaticResource AppFont}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- ▸ Connecteurs SATA (cliquables → stockage) -->
                                <Border x:Name="ZoneSata" Canvas.Left="346" Canvas.Top="420" Width="22" Height="78"
                                        Background="Transparent" Cursor="Hand" MouseLeftButtonUp="NodeSto_Click">
                                    <StackPanel>
                                        <Border Height="14" Background="#243052" BorderBrush="#46557F" BorderThickness="1" CornerRadius="1" Margin="0,0,0,5">
                                            <Border Width="10" Height="4" Background="#0E1526" HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border Height="14" Background="#243052" BorderBrush="#46557F" BorderThickness="1" CornerRadius="1" Margin="0,0,0,5">
                                            <Border Width="10" Height="4" Background="#0E1526" HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border Height="14" Background="#243052" BorderBrush="#46557F" BorderThickness="1" CornerRadius="1" Margin="0,0,0,5">
                                            <Border Width="10" Height="4" Background="#0E1526" HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border Height="14" Background="#243052" BorderBrush="#46557F" BorderThickness="1" CornerRadius="1">
                                            <Border Width="10" Height="4" Background="#0E1526" HorizontalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <TextBlock Canvas.Left="340" Canvas.Top="500" Text="SATA" Foreground="#56689E"
                                           FontSize="7.5" FontWeight="Bold" FontFamily="{StaticResource AppFont}"/>

                                <!-- Pile CMOS -->
                                <Ellipse Canvas.Left="44" Canvas.Top="430" Width="30" Height="30"
                                         Stroke="#56689E" StrokeThickness="1.5">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Color="#33406A" Offset="0"/>
                                            <GradientStop Color="#243052" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <TextBlock Canvas.Left="50" Canvas.Top="440" Text="CR2032" Foreground="#56689E"
                                           FontSize="6" FontWeight="Bold" FontFamily="{StaticResource AppFont}"/>

                                <!-- Sérigraphie : modèle de la carte (en bas à gauche) -->
                                <TextBlock x:Name="TxtMbSilk" Canvas.Left="100" Canvas.Top="520" Text="TWEAKLY BOARD"
                                           Foreground="#54659C" FontSize="9" FontWeight="Bold"
                                           FontFamily="{StaticResource AppFont}"/>
                            </Canvas>
                        </Border>

                        <!-- ═════ LIGNES DE RAPPEL (callout → zone) ═════
                             Coords en repère Grille 900×600. La carte est centrée (Grid
                             x260..640, y20..580) → les points tombent sur le CENTRE réel
                             de chaque zone. CPU routé PAR LE HAUT (sinon il croise la RAM,
                             bug vécu) ; stockage routé par la MARGE GAUCHE (sinon il passe
                             sur la pile CMOS / le chipset, bug vécu). -->
                        <Canvas>
                            <!-- OS → panneau I/O (bord gauche haut, Grid ~297,122) -->
                            <Line X1="222" Y1="122" X2="297" Y2="122" Stroke="#3D5BA0FF" StrokeThickness="1.2"/>
                            <Ellipse Canvas.Left="293.5" Canvas.Top="118.5" Width="7" Height="7" Fill="{DynamicResource ThBlueGradB}"/>
                            <!-- GPU → slot PCIe x16 (Grid ~360,289) -->
                            <Line X1="222" Y1="289" X2="360" Y2="289" Stroke="#3D5BA0FF" StrokeThickness="1.2"/>
                            <Ellipse Canvas.Left="356.5" Canvas.Top="285.5" Width="7" Height="7" Fill="{DynamicResource ThBlueGradB}"/>
                            <!-- Stockage → M.2 (remonte par la marge gauche x248, evite la pile/chipset) -->
                            <Line X1="222" Y1="455" X2="248" Y2="455" Stroke="#3D5BA0FF" StrokeThickness="1.2"/>
                            <Line X1="248" Y1="455" X2="248" Y2="236" Stroke="#3D5BA0FF" StrokeThickness="1.2"/>
                            <Line X1="248" Y1="236" X2="410" Y2="236" Stroke="#3D5BA0FF" StrokeThickness="1.2"/>
                            <Ellipse Canvas.Left="406.5" Canvas.Top="232.5" Width="7" Height="7" Fill="{DynamicResource ThBlueGradB}"/>
                            <!-- CPU → socket (route PAR LE HAUT a y46, au-dessus de la RAM, Grid ~420,90) -->
                            <Line X1="678" Y1="118" X2="678" Y2="46" Stroke="#3D5BA0FF" StrokeThickness="1.2"/>
                            <Line X1="678" Y1="46"  X2="420" Y2="46" Stroke="#3D5BA0FF" StrokeThickness="1.2"/>
                            <Line X1="420" Y1="46"  X2="420" Y2="90" Stroke="#3D5BA0FF" StrokeThickness="1.2"/>
                            <Ellipse Canvas.Left="416.5" Canvas.Top="86.5" Width="7" Height="7" Fill="{DynamicResource ThBlueGradB}"/>
                            <!-- RAM → slots (conserve : valide par l'utilisateur) -->
                            <Line X1="678" Y1="288" X2="616" Y2="288" Stroke="#3D5BA0FF" StrokeThickness="1.2"/>
                            <Line X1="616" Y1="288" X2="616" Y2="170" Stroke="#3D5BA0FF" StrokeThickness="1.2"/>
                            <Ellipse Canvas.Left="612" Canvas.Top="166" Width="7" Height="7" Fill="{DynamicResource ThBlueGradB}"/>
                            <!-- Carte mère → chipset (bord droit du chipset, Grid ~605,466) -->
                            <Line X1="678" Y1="465" X2="606" Y2="465" Stroke="#3D5BA0FF" StrokeThickness="1.2"/>
                            <Ellipse Canvas.Left="602.5" Canvas.Top="461.5" Width="7" Height="7" Fill="{DynamicResource ThBlueGradB}"/>
                        </Canvas>

                        <!-- ═════ CALLOUTS GAUCHE ═════ -->
                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Width="212" Margin="8,60,0,0">
                            <!-- OS -->
                            <Border Style="{StaticResource SchemaNode}" MouseLeftButtonUp="NodeOs_Click" Margin="0,0,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource ThOk}" VerticalAlignment="Center" Margin="0,1,7,0"/>
                                        <TextBlock Text="SYSTÈME" Style="{StaticResource SchemaCat}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtOsHead" Text="Chargement…"
                                               Foreground="{DynamicResource ThTextTitle}"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <!-- GPU -->
                            <Border Style="{StaticResource SchemaNode}" MouseLeftButtonUp="NodeGpu_Click" Margin="0,96,0,0">
                                <StackPanel>
                                    <TextBlock Text="CARTE GRAPHIQUE" Style="{StaticResource SchemaCat}" Margin="0,0,0,5"/>
                                    <TextBlock x:Name="TxtGpuHead" Text="Chargement…"
                                               Foreground="{DynamicResource ThTextTitle}"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock x:Name="TxtGpuBig" Text="—"
                                                   Foreground="{DynamicResource ThTextTitle}"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="17" FontWeight="Bold"/>
                                        <TextBlock Text="VRAM" Foreground="{DynamicResource ThTextDim}"
                                                   FontFamily="{StaticResource AppFont}" FontSize="9" FontWeight="Bold"
                                                   Margin="6,0,0,3" VerticalAlignment="Bottom"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <!-- STOCKAGE -->
                            <Border Style="{StaticResource SchemaNode}" MouseLeftButtonUp="NodeSto_Click" Margin="0,72,0,0">
                                <StackPanel>
                                    <TextBlock Text="STOCKAGE" Style="{StaticResource SchemaCat}" Margin="0,0,0,5"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="TxtDiskBig" Text="—"
                                                   Foreground="{DynamicResource ThTextTitle}"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Text="DISQUES" Foreground="{DynamicResource ThTextDim}"
                                                   FontFamily="{StaticResource AppFont}" FontSize="9" FontWeight="Bold"
                                                   Margin="7,0,0,4" VerticalAlignment="Bottom"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtDiskHead" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ═════ CALLOUTS DROITE ═════ -->
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Width="212" Margin="0,60,8,0">
                            <!-- CPU -->
                            <Border Style="{StaticResource SchemaNode}" MouseLeftButtonUp="NodeCpu_Click">
                                <StackPanel>
                                    <TextBlock Text="PROCESSEUR" Style="{StaticResource SchemaCat}" Margin="0,0,0,5"/>
                                    <TextBlock x:Name="TxtCpuHead" Text="Chargement…"
                                               Foreground="{DynamicResource ThTextTitle}"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock x:Name="TxtCpuBig" Text="—"
                                                   Foreground="{DynamicResource ThTextTitle}"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="17" FontWeight="Bold"/>
                                        <TextBlock Text="FRÉQ. MAX" Foreground="{DynamicResource ThTextDim}"
                                                   FontFamily="{StaticResource AppFont}" FontSize="9" FontWeight="Bold"
                                                   Margin="6,0,0,3" VerticalAlignment="Bottom"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <!-- RAM -->
                            <Border Style="{StaticResource SchemaNode}" MouseLeftButtonUp="NodeRam_Click" Margin="0,68,0,0">
                                <StackPanel>
                                    <TextBlock Text="MÉMOIRE" Style="{StaticResource SchemaCat}" Margin="0,0,0,5"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="TxtRamBig" Text="—"
                                                   Foreground="{DynamicResource ThTextTitle}"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtRamHead" Text=""
                                                   Foreground="{DynamicResource ThTextDim}"
                                                   FontFamily="{StaticResource AppFont}" FontSize="10.5"
                                                   Margin="8,0,0,3" VerticalAlignment="Bottom" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtRamSlots" Text=""
                                               Foreground="{DynamicResource ThTextDim}"
                                               FontFamily="{StaticResource AppFont}" FontSize="10.5"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                            <!-- CARTE MÈRE -->
                            <Border Style="{StaticResource SchemaNode}" MouseLeftButtonUp="NodeMb_Click" Margin="0,86,0,0">
                                <StackPanel>
                                    <TextBlock Text="CARTE MÈRE" Style="{StaticResource SchemaCat}" Margin="0,0,0,5"/>
                                    <TextBlock x:Name="TxtMbHead" Text="Chargement…"
                                               Foreground="{DynamicResource ThTextTitle}"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Viewbox>
                </Border>

                <!-- Hint + zone de détail (clic sur un composant / une zone de la carte) -->
                <TextBlock x:Name="TxtSchemaHint"
                           Text="Clique sur un composant — ou directement sur une zone de la carte — pour afficher son détail."
                           Foreground="{DynamicResource ThTextDim}"
                           FontFamily="{StaticResource AppFont}" FontSize="11"
                           HorizontalAlignment="Center" Margin="0,8,0,0"/>

                <Border x:Name="SpecDetailZone" Style="{StaticResource TileStyle}"
                        Margin="0,10,0,0" Visibility="Collapsed">
                    <Grid>
                        <StackPanel x:Name="DetCpu" Visibility="Collapsed">
                            <TextBlock Text="PROCESSEUR — DÉTAIL" Style="{StaticResource SchemaCat}" Margin="0,0,0,7"/>
                            <TextBlock x:Name="TxtCpuDetails" Text="—" Style="{StaticResource TileValueStyle}"/>
                        </StackPanel>
                        <StackPanel x:Name="DetRam" Visibility="Collapsed">
                            <TextBlock Text="MÉMOIRE — DÉTAIL" Style="{StaticResource SchemaCat}" Margin="0,0,0,7"/>
                            <TextBlock x:Name="TxtRamDetails" Text="—" Style="{StaticResource TileValueStyle}"/>
                        </StackPanel>
                        <StackPanel x:Name="DetGpu" Visibility="Collapsed">
                            <TextBlock Text="CARTE GRAPHIQUE — DÉTAIL" Style="{StaticResource SchemaCat}" Margin="0,0,0,7"/>
                            <TextBlock x:Name="TxtGpuDetails" Text="—" Style="{StaticResource TileValueStyle}"/>
                        </StackPanel>
                        <StackPanel x:Name="DetSto" Visibility="Collapsed">
                            <TextBlock Text="STOCKAGE — DÉTAIL" Style="{StaticResource SchemaCat}" Margin="0,0,0,7"/>
                            <TextBlock x:Name="TxtDiskDetails" Text="—" Style="{StaticResource TileValueStyle}"/>
                        </StackPanel>
                        <StackPanel x:Name="DetMb" Visibility="Collapsed">
                            <TextBlock Text="CARTE MÈRE &amp; BIOS — DÉTAIL" Style="{StaticResource SchemaCat}" Margin="0,0,0,7"/>
                            <TextBlock x:Name="TxtMbDetails" Text="—" Style="{StaticResource TileValueStyle}"/>
                            <Button x:Name="BtnBios"
                                    Content="&#8599; Page BIOS constructeur"
                                    Style="{StaticResource ActionBtnStyle}"
                                    Margin="0,10,0,0"
                                    IsEnabled="False"
                                    HorizontalAlignment="Left"
                                    Click="BtnBios_Click"/>
                        </StackPanel>
                        <StackPanel x:Name="DetOs" Visibility="Collapsed">
                            <TextBlock Text="SYSTÈME D'EXPLOITATION — DÉTAIL" Style="{StaticResource SchemaCat}" Margin="0,0,0,7"/>
                            <TextBlock x:Name="TxtOsDetails" Text="—" Style="{StaticResource TileValueStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- TextBlocks LEGACY (cachés) — populés en compat par LoadHardwareAsync -->
                <TextBlock x:Name="TxtCPU"  Visibility="Collapsed"/>
                <TextBlock x:Name="TxtRAM"  Visibility="Collapsed"/>
                <TextBlock x:Name="TxtGPU"  Visibility="Collapsed"/>
                <TextBlock x:Name="TxtOS"   Visibility="Collapsed"/>
                <TextBlock x:Name="TxtDisk" Visibility="Collapsed"/>
                <TextBlock x:Name="TxtMB"   Visibility="Collapsed"/>

            </StackPanel><!-- fin PanelSpecs -->

            <!-- ══════════════════ PANNEAU COMPATIBILITÉ ═════════════════════ -->
            <StackPanel x:Name="PanelCompat" Visibility="Collapsed">

                <!-- Tuile GPU — Compatibilité PCIe -->
                <Border Style="{StaticResource TileStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="COMPATIBILIT&#201; PCIe — CARTE GRAPHIQUE" Style="{StaticResource TileLabelStyle}"/>
                        <TextBlock x:Name="TxtCompatGpuName" Text="Analyse&#8230;"
                                   Foreground="{DynamicResource ThTextBody}"
                                   FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtCompatGpuGen" Text=""
                                   Foreground="{DynamicResource ThTextSub}"
                                   FontFamily="{StaticResource AppFont}" FontSize="11.5" Margin="0,6,0,0"/>
                        <TextBlock x:Name="TxtCompatGpuBw" Text=""
                                   Foreground="{DynamicResource ThTextDim}"
                                   FontFamily="{StaticResource AppFont}" FontSize="11.5" Margin="0,2,0,0"/>

                        <!-- Barre bande passante -->
                        <Grid Height="8" Margin="0,12,0,6">
                            <Border Background="{DynamicResource ThTrack}" CornerRadius="4"/>
                            <Grid x:Name="CompatGpuBar" ClipToBounds="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0*"/><ColumnDefinition Width="100*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="CompatGpuFill" Grid.Column="0" Background="{DynamicResource ThOk}" CornerRadius="4"/>
                            </Grid>
                        </Grid>
                        <TextBlock x:Name="TxtCompatGpuStatus" Text=""
                                   FontFamily="{StaticResource AppFont}" FontSize="11.5" FontWeight="SemiBold"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Tuile NVMe — Compatibilité M.2 -->
                <Border Style="{StaticResource TileStyle}">
                    <StackPanel>
                        <TextBlock Text="COMPATIBILIT&#201; M.2 — STOCKAGE NVMe" Style="{StaticResource TileLabelStyle}"/>
                        <TextBlock x:Name="TxtCompatNvmeEmpty" Text="Analyse&#8230;"
                                   Foreground="{DynamicResource ThTextDim}"
                                   FontFamily="{StaticResource AppFont}" FontSize="11.5" Margin="0,2,0,0"/>
                        <ItemsControl x:Name="CompatNvmeList" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{DynamicResource ThTextBody}"
                                                       FontFamily="{StaticResource AppFont}" FontSize="12.5" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Info}"
                                                       Foreground="{DynamicResource ThTextDim}"
                                                       FontFamily="{StaticResource AppFont}" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{DynamicResource ThPill}"
                                                CornerRadius="7" Padding="10,4" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding Badge}"
                                                       Style="{StaticResource FirmwareRoleText}"
                                                       FontFamily="Consolas" FontSize="11.5" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel><!-- fin PanelCompat -->

            <!-- ══════════════════ PANNEAU RÉGLAGES BIOS ════════════════════ -->
            <StackPanel x:Name="PanelBios" Visibility="Collapsed">

                <Border Style="{StaticResource TileStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="SYNTH&#200;SE BIOS / FIRMWARE"
                                           Style="{StaticResource TileLabelStyle}"/>
                                <TextBlock x:Name="TxtBiosSummary"
                                           Text="Analyse des informations firmware..."
                                           Foreground="{DynamicResource ThTextBody}"
                                           FontFamily="{StaticResource AppFont}" FontSize="13"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="Lecture seule : Tweakly affiche ce que Windows expose, sans modifier le BIOS."
                                           Foreground="{DynamicResource ThTextDim}"
                                           FontFamily="{StaticResource AppFont}" FontSize="11.5"
                                           TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="{DynamicResource ThPill}"
                                    CornerRadius="8"
                                    Padding="10,5"
                                    Margin="14,0,0,0"
                                    VerticalAlignment="Top">
                                <TextBlock x:Name="TxtBiosLastRead"
                                           Text="Lecture en cours"
                                           Foreground="{DynamicResource ThTextDim}"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </Grid>

                        <ItemsControl x:Name="BiosInsightList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource ThSecBtn}"
                                            BorderBrush="{DynamicResource ThBorder}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Width="355"
                                            MinHeight="104"
                                            Margin="0,0,10,10"
                                            Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
                                                    Style="{StaticResource FirmwareRoleAccent}"
                                                    CornerRadius="3"
                                                    Margin="0,1,10,1"/>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                <TextBlock Text="{Binding Title}"
                                                           Foreground="{DynamicResource ThTextDim}"
                                                           FontFamily="{StaticResource AppFont}"
                                                           FontSize="10.5"
                                                           FontWeight="Bold"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Value}"
                                                           Style="{StaticResource FirmwareRoleText}"
                                                           FontFamily="{StaticResource AppFont}"
                                                           FontSize="14"
                                                           FontWeight="Bold"
                                                           TextWrapping="Wrap"
                                                           Margin="0,5,0,0"/>
                                                <TextBlock Text="{Binding Detail}"
                                                           Foreground="{DynamicResource ThTextBody}"
                                                           FontFamily="{StaticResource AppFont}"
                                                           FontSize="11.5"
                                                           LineHeight="16"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border x:Name="BiosChangesTile" Style="{StaticResource TileStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="CHANGEMENTS DEPUIS LA DERNI&#200;RE LECTURE"
                                   Style="{StaticResource TileLabelStyle}"/>
                        <TextBlock x:Name="TxtBiosChangesTitle"
                                   Text="Comparaison en cours..."
                                   Foreground="{DynamicResource ThTextBody}"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtBiosChangesSub"
                                   Text=""
                                   Foreground="{DynamicResource ThTextDim}"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="11.5"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                        <ItemsControl x:Name="BiosChangeList" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource ThSecBtn}"
                                            BorderBrush="{DynamicResource ThBorder}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="12"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="210"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Title}"
                                                       Foreground="{DynamicResource ThTextTitle}"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Avant"
                                                           Foreground="{DynamicResource ThTextDim}"
                                                           FontFamily="{StaticResource AppFont}"
                                                           FontSize="10.5"
                                                           FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Before}"
                                                           Foreground="{DynamicResource ThTextBody}"
                                                           FontFamily="{StaticResource AppFont}"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       Text="&#8594;"
                                                       Style="{StaticResource FirmwareRoleText}"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="3">
                                                <TextBlock Text="Maintenant"
                                                           Foreground="{DynamicResource ThTextDim}"
                                                           FontFamily="{StaticResource AppFont}"
                                                           FontSize="10.5"
                                                           FontWeight="Bold"/>
                                                <TextBlock Text="{Binding After}"
                                                           Style="{StaticResource FirmwareRoleText}"
                                                           FontFamily="{StaticResource AppFont}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <ItemsControl x:Name="BiosSettingsList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource TileStyle}"
                                    MinHeight="120"
                                    Margin="0,0,12,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Group}"
                                                   Style="{StaticResource TileLabelStyle}"
                                                   Margin="0"/>
                                        <Border Grid.Column="1"
                                                Background="{DynamicResource ThPill}"
                                                CornerRadius="7"
                                                Padding="9,3"
                                                VerticalAlignment="Top"
                                                Margin="10,0,0,0">
                                            <TextBlock Text="{Binding Source}"
                                                       Foreground="{DynamicResource ThTextDim}"
                                                       FontFamily="Consolas"
                                                       FontSize="10.5"
                                                       FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="{Binding Title}"
                                               Foreground="{DynamicResource ThTextTitle}"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>

                                    <TextBlock Text="{Binding Value}"
                                               Style="{StaticResource FirmwareRoleText}"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0"/>

                                    <TextBlock Text="{Binding Detail}"
                                               Foreground="{DynamicResource ThTextDim}"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="11.5"
                                               LineHeight="17"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel><!-- fin PanelBios -->

        </StackPanel>
    </ScrollViewer>
</UserControl>
