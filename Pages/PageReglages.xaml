<UserControl x:Class="Optimisation_Tool.Pages.PageReglages"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource ThPanel}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource ThBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="18,15"/>
            <Setter Property="Margin"          Value="0,0,0,14"/>
        </Style>
        <Style x:Key="SecHdr" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThTextDim}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize"   Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin"     Value="2,0,0,7"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="18,16,18,18" MaxWidth="640" HorizontalAlignment="Left">

            <!-- ══ MISES À JOUR ══ -->
            <TextBlock Text="MISES &#192; JOUR" Style="{StaticResource SecHdr}"/>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <!-- Version + statut à gauche, boutons centrés à droite (même gabarit que la demi-tuile du bas) -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtVersionLine"
                                       Text="Version install&#233;e : &#8212;"
                                       Foreground="{DynamicResource ThTextBody}"
                                       FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtUpdateStatus"
                                       Text="Clique sur &#171; V&#233;rifier &#187; pour chercher une mise &#224; jour."
                                       Foreground="{DynamicResource ThTextDim}"
                                       FontFamily="{StaticResource AppFont}" FontSize="11.5"
                                       Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="20,0,0,0">
                            <Button x:Name="BtnDownloadUpdate"
                                    Content="T&#201;L&#201;CHARGER"
                                    Style="{StaticResource CleanRunBtn}" Padding="20,10"
                                    Visibility="Collapsed"
                                    Margin="0,0,8,0"
                                    Click="BtnDownloadUpdate_Click"/>
                            <Button x:Name="BtnCheckUpdate"
                                    Content="V&#233;rifier"
                                    Style="{StaticResource SecondaryBtnStyle}"
                                    Click="BtnCheckUpdate_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- S&#233;parateur -->
                    <Border Height="1" Background="{DynamicResource ThBorder}" Margin="0,13,0,0"/>

                    <!-- Toggle mises à jour automatiques -->
                    <Grid Margin="0,13,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Mise &#224; jour automatique"
                                       Foreground="{DynamicResource ThTextBody}"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="V&#233;rifie au d&#233;marrage et propose les nouvelles versions."
                                       Foreground="{DynamicResource ThTextDim}"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <CheckBox x:Name="ChkAutoUpdate" Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource TweakChkStyle}"
                                  Checked="ChkAutoUpdate_Changed"
                                  Unchecked="ChkAutoUpdate_Changed"/>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="INTERFACE" Style="{StaticResource SecHdr}"/>
            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="Mode d'utilisation"
                                   Foreground="{DynamicResource ThTextBody}"
                                   FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="Simple cache les pages techniques. Avanc&#233; affiche toute la bo&#238;te &#224; outils."
                                   Foreground="{DynamicResource ThTextDim}"
                                   FontFamily="{StaticResource AppFont}" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border x:Name="NavigationModeSegment" Grid.Column="1"
                            VerticalAlignment="Center"
                            Background="{DynamicResource ThBg}"
                            BorderBrush="{DynamicResource ThBorder}"
                            BorderThickness="1" CornerRadius="10"
                            Padding="4">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnNavModeEasy" Click="BtnNavModeEasy_Click"
                                    Cursor="Hand" Width="86" Height="30">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg" CornerRadius="7" Background="Transparent">
                                            <TextBlock x:Name="Lbl" Text="Simple"
                                                       Foreground="{DynamicResource ThTextDim}"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button x:Name="BtnNavModeAdvanced" Click="BtnNavModeAdvanced_Click"
                                    Cursor="Hand" Width="86" Height="30">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg" CornerRadius="7" Background="Transparent">
                                            <TextBlock x:Name="Lbl" Text="Avanc&#233;"
                                                       Foreground="{DynamicResource ThTextDim}"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ══ APPARENCE ══ -->
            <TextBlock Text="APPARENCE" Style="{StaticResource SecHdr}"/>
            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Thème de l'interface"
                                   Foreground="{DynamicResource ThTextBody}"
                                   FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="Bascule entre le mode sombre et le mode clair."
                                   Foreground="{DynamicResource ThTextDim}"
                                   FontFamily="{StaticResource AppFont}" FontSize="11.5" Margin="0,3,0,0"/>
                    </StackPanel>
                    <!-- Segmented control Sombre / Clair -->
                    <Border x:Name="ThemeSegment" Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="20,0,0,0"
                            Background="{DynamicResource ThBg}"
                            BorderBrush="{DynamicResource ThBorder}"
                            BorderThickness="1" CornerRadius="10"
                            Padding="4">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnThemeDark" Click="BtnThemeDark_Click"
                                    Cursor="Hand" Width="88" Height="30">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg" CornerRadius="7" Background="Transparent">
                                            <TextBlock x:Name="Lbl" Text="Sombre"
                                                       Foreground="{DynamicResource ThTextDim}"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button x:Name="BtnThemeLight" Click="BtnThemeLight_Click"
                                    Cursor="Hand" Width="80" Height="30">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg" CornerRadius="7" Background="Transparent">
                                            <TextBlock x:Name="Lbl" Text="Clair"
                                                       Foreground="{DynamicResource ThTextDim}"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ══ DÉMARRAGE & RACCOURCI ══ -->
            <TextBlock Text="SYST&#200;ME" Style="{StaticResource SecHdr}"/>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <!-- Démarrage avec Windows -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Lancer au d&#233;marrage de Windows"
                                       Foreground="{DynamicResource ThTextBody}"
                                       FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="Tweakly s'ouvre automatiquement avec Windows."
                                       Foreground="{DynamicResource ThTextDim}"
                                       FontFamily="{StaticResource AppFont}" FontSize="11.5" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="ChkStartup" Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource TweakChkStyle}"
                                  Checked="ChkStartup_Changed" Unchecked="ChkStartup_Changed"/>
                    </Grid>
                    <!-- Démarrer minimisé -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="D&#233;marrer minimis&#233;"
                                       Foreground="{DynamicResource ThTextBody}"
                                       FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="Au lancement, Tweakly reste r&#233;duit dans la zone de notification."
                                       Foreground="{DynamicResource ThTextDim}"
                                       FontFamily="{StaticResource AppFont}" FontSize="11.5" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="ChkStartMinimized" Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource TweakChkStyle}"
                                  Checked="ChkStartMinimized_Changed" Unchecked="ChkStartMinimized_Changed"/>
                    </Grid>
                    <!-- Séparateur -->
                    <Border Height="1" Background="{DynamicResource ThBorder}" Margin="0,0,0,12"/>
                    <!-- Raccourci bureau -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Raccourci sur le bureau"
                                       Foreground="{DynamicResource ThTextBody}"
                                       FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="Cr&#233;e un raccourci Tweakly.lnk sur ton bureau."
                                       Foreground="{DynamicResource ThTextDim}"
                                       FontFamily="{StaticResource AppFont}" FontSize="11.5" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button x:Name="BtnShortcut" Grid.Column="1"
                                Content="Cr&#233;er le raccourci"
                                Style="{StaticResource SecondaryBtnStyle}"
                                VerticalAlignment="Center"
                                Click="BtnShortcut_Click"/>
                    </Grid>
                    <!-- Séparateur -->
                    <Border Height="1" Background="{DynamicResource ThBorder}" Margin="0,12,0,12"/>
                    <!-- Sons d'interface -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Sons de l'interface"
                                       Foreground="{DynamicResource ThTextBody}"
                                       FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="Sons discrets lors des notifications (r&#233;glage appliqu&#233;, etc.)."
                                       Foreground="{DynamicResource ThTextDim}"
                                       FontFamily="{StaticResource AppFont}" FontSize="11.5" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="ChkSounds" Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource TweakChkStyle}"
                                  Checked="ChkSounds_Changed" Unchecked="ChkSounds_Changed"/>
                    </Grid>
                    <!-- Séparateur -->
                    <Border Height="1" Background="{DynamicResource ThBorder}" Margin="0,12,0,12"/>
                    <!-- Température du CPU (opt-in, pilote PawnIO) -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                            <TextBlock Text="Temp&#233;rature du CPU"
                                       Foreground="{DynamicResource ThTextBody}"
                                       FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="Affiche la temp&#233;rature du processeur dans le Monitoring. N&#233;cessite un petit pilote sign&#233; (PawnIO), install&#233; &#224; l'activation. D&#233;cocher l'option arr&#234;te la lecture (le pilote reste en place)."
                                       Foreground="{DynamicResource ThTextDim}"
                                       FontFamily="{StaticResource AppFont}" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtCpuTempStatus" Text=""
                                       Foreground="{DynamicResource ThTextDim}"
                                       FontFamily="{StaticResource AppFont}" FontSize="11.5" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <CheckBox x:Name="ChkCpuTemp" Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource TweakChkStyle}"
                                  Checked="ChkCpuTemp_Changed" Unchecked="ChkCpuTemp_Changed"/>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="RESTAURATION" Style="{StaticResource SecHdr}"/>
            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="Restaurer les r&#233;glages Windows"
                                   Foreground="{DynamicResource ThTextBody}"
                                   FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="Remet les optimisations CPU, Windows, r&#233;seau et confidentialit&#233; aux valeurs standard. NVIDIA reste &#224; part."
                                   Foreground="{DynamicResource ThTextDim}"
                                   FontFamily="{StaticResource AppFont}" FontSize="11.5"
                                   Margin="0,3,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtRestoreDefaultsStatus"
                                   Text="Aucune restauration lanc&#233;e."
                                   Foreground="{DynamicResource ThTextDim}"
                                   FontFamily="{StaticResource AppFont}" FontSize="11.5"
                                   Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button x:Name="BtnRestoreWindowsDefaults" Grid.Column="1"
                            Content="Restaurer"
                            Style="{StaticResource SecondaryBtnStyle}"
                            VerticalAlignment="Center"
                            Click="BtnRestoreWindowsDefaults_Click"/>
                </Grid>
            </Border>

            <!-- ══ LIENS ══ -->
            <TextBlock Text="LIENS &amp; DOSSIERS" Style="{StaticResource SecHdr}"/>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnGitHub"
                            Content="GitHub du projet"
                            Style="{StaticResource SecondaryBtnStyle}"
                            Margin="0,0,8,0" Click="BtnGitHub_Click"/>
                    <Button x:Name="BtnOpenFolder"
                            Content="Dossier de l'application"
                            Style="{StaticResource SecondaryBtnStyle}"
                            Margin="0,0,8,0"
                            Click="BtnOpenFolder_Click"/>
                    <Button x:Name="BtnOpenLog"
                            Content="Journal technique"
                            ToolTip="Ouvre le fichier de logs local (config\tweakly-log.txt) — utile pour diagnostiquer un problème. Rien n'est envoyé nulle part."
                            Style="{StaticResource SecondaryBtnStyle}"
                            Click="BtnOpenLog_Click"/>
                </StackPanel>
            </Border>

            <!-- ══ À PROPOS ══ -->
            <TextBlock Text="&#192; PROPOS" Style="{StaticResource SecHdr}"/>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Tweakly -->
                        <TextBlock FontFamily="{StaticResource AppFont}" FontSize="14" FontWeight="Bold"
                                   VerticalAlignment="Center">
                            <Run Text="Tweak" Foreground="{DynamicResource ThTextTitle}"/><Run Text="ly" Foreground="{DynamicResource ThAccentIcon}"/>
                        </TextBlock>
                        <!-- × -->
                        <TextBlock Text=" &#xD7; " Foreground="{DynamicResource ThTextDim}"
                                   FontFamily="{StaticResource AppFont}" FontSize="13"
                                   VerticalAlignment="Center" Margin="4,0"/>
                        <!-- Claude Code — typo et couleur Claude -->
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="14" FontWeight="SemiBold"
                                   FontFamily="Georgia, 'Times New Roman', serif">
                            <Run Text="Claude" Foreground="#D97757"/><Run Text=" Code" Foreground="#C4623F"/>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="Outil d'optimisation et de réglages Windows — par Telly."
                               Foreground="{DynamicResource ThTextDim}"
                               FontFamily="{StaticResource AppFont}" FontSize="11.5"
                               Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="© 2026 Telly · Distribué sous licence GNU GPL v3"
                               Foreground="{DynamicResource ThTextDim}"
                               FontFamily="{StaticResource AppFont}" FontSize="11"
                               Margin="0,8,0,0" TextWrapping="Wrap"/>
                    <!-- Remerciements aux testeurs (discret, italique) -->
                    <TextBlock Foreground="{DynamicResource ThTextDim}"
                               FontFamily="{StaticResource AppFont}" FontSize="11"
                               FontStyle="Italic"
                               Margin="0,6,0,0" TextWrapping="Wrap">
                        <Run Text="Ils ont cliqué partout pour toi — "/><Run Text="@Symca" Foreground="{DynamicResource ThTextNav}"/><Run Text=", "/><Run Text="@Elliot" Foreground="{DynamicResource ThTextNav}"/><Run Text=", "/><Run Text="@Théo" Foreground="{DynamicResource ThTextNav}"/><Run Text=", "/><Run Text="@Sekane" Foreground="{DynamicResource ThTextNav}"/><Run Text="."/>
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
