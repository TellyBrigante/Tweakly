<UserControl x:Class="Optimisation_Tool.Pages.PageFresh"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>

        <!-- Accent de barre de progression : camaïeu bleu (validé sur l'écran de MAJ) -->
        <LinearGradientBrush x:Key="FreshAccent" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#2F6FD8" Offset="0"/>
            <GradientStop Color="#5BA0FF" Offset="0.6"/>
            <GradientStop Color="#8AC0FF" Offset="1"/>
        </LinearGradientBrush>

        <!-- Checkbox (accent bleu Tweakly, refonte v1.3.5) -->
        <Style x:Key="DarkChkStyle" TargetType="CheckBox">
            <Setter Property="Cursor"              Value="Hand"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Bd" Width="19" Height="19"
                                Background="{DynamicResource ThPanel}" BorderBrush="{DynamicResource ThTextDim}"
                                BorderThickness="2" CornerRadius="5">
                            <TextBlock x:Name="Tick" Text="&#10003;"
                                       Foreground="#5BA0FF" FontSize="12.5" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd"   Property="Background"  Value="#2E5BA0FF"/>
                                <Setter TargetName="Bd"   Property="BorderBrush" Value="#5BA0FF"/>
                                <Setter TargetName="Tick" Property="Visibility"  Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#5BA0FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- En-tête de colonne DataGrid : transparent + petites majuscules grises
             (même langage que l'onglet Applications) -->
        <Style x:Key="DgHdrStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource ThTextDim}"/>
            <Setter Property="FontFamily"      Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize"        Value="10.5"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="12,8"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource ThBorder}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ligne de DataGrid : hover bleu FRANC + contour fin (validé sur Applications) -->
        <Style x:Key="FreshRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"      Value="#2E5BA0FF"/>
                    <Setter Property="BorderBrush"     Value="#665BA0FF"/>
                    <Setter Property="BorderThickness" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid Margin="18,14,18,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0 : barre toggle SAVE / RESTORE   -->
            <RowDefinition Height="12"/>     <!-- 1 : espace                         -->
            <RowDefinition Height="Auto"/>   <!-- 2 : stepper                        -->
            <RowDefinition Height="Auto"/>   <!-- 3 : hint texte                     -->
            <RowDefinition Height="10"/>     <!-- 4 : espace                         -->
            <RowDefinition Height="*"/>      <!-- 5 : contenu (panneaux superposés)  -->
        </Grid.RowDefinitions>

        <!-- ══ 0 : Toggle SAVE / RESTORE ══════════════════════════════════ -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">

            <Button x:Name="BtnModeSave"
                    Content="SAUVEGARDE"
                    Width="110" Padding="0,10"
                    Click="BtnModeSave_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryBtnStyle}">
                        <Setter Property="FontSize" Value="11.5"/>
                    </Style>
                </Button.Style>
            </Button>

            <Button x:Name="BtnModeRestore"
                    Content="RESTAURATION"
                    Width="124" Padding="0,10"
                    Margin="10,0,0,0"
                    Click="BtnModeRestore_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryBtnStyle}">
                        <Setter Property="FontSize" Value="11.5"/>
                    </Style>
                </Button.Style>
            </Button>

        </StackPanel>

        <!-- ══ 2 : Steppers (un par mode, superposés) ══════════════════════ -->

        <!-- Stepper SAVE : Scan → Téléchargement → ZIP prêt -->
        <Grid x:Name="StepperSave" Grid.Row="2" Visibility="Visible">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Étape 1 -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="SS1Dot" Width="24" Height="24" CornerRadius="12"
                        Background="#1870CC" BorderBrush="#2580E0" BorderThickness="2"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="SS1Num" Text="1" Foreground="White"
                               FontSize="11.5" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="SS1Lbl" Text="SCAN"
                           Foreground="{DynamicResource ThTextBody}" FontFamily="{StaticResource AppFont}" FontSize="11" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>

            <!-- Ligne 1→2 -->
            <Border x:Name="SS1Line" Grid.Column="1"
                    Height="2" Background="{DynamicResource ThBorder}"
                    VerticalAlignment="Center" Margin="8,0"/>

            <!-- Étape 2 -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="SS2Dot" Width="24" Height="24" CornerRadius="12"
                        Background="{DynamicResource ThPanel}" BorderBrush="{DynamicResource ThBorder}" BorderThickness="2"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="SS2Num" Text="2" Foreground="{DynamicResource ThTextDim}"
                               FontSize="11.5" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="SS2Lbl" Text="T&#201;L&#201;CHARGEMENT"
                           Foreground="{DynamicResource ThTextDim}" FontFamily="{StaticResource AppFont}" FontSize="11" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>

            <!-- Ligne 2→3 -->
            <Border x:Name="SS2Line" Grid.Column="3"
                    Height="2" Background="{DynamicResource ThBorder}"
                    VerticalAlignment="Center" Margin="8,0"/>

            <!-- Étape 3 -->
            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="SS3Dot" Width="24" Height="24" CornerRadius="12"
                        Background="{DynamicResource ThPanel}" BorderBrush="{DynamicResource ThBorder}" BorderThickness="2"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="SS3Num" Text="3" Foreground="{DynamicResource ThTextDim}"
                               FontSize="11.5" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="SS3Lbl" Text="ZIP PR&#202;T"
                           Foreground="{DynamicResource ThTextDim}" FontFamily="{StaticResource AppFont}" FontSize="11" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Stepper RESTORE : Fichier ZIP → Lecture → Sélection → Installation -->
        <Grid x:Name="StepperRestore" Grid.Row="2" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="RS1Dot" Width="24" Height="24" CornerRadius="12"
                        Background="#1870CC" BorderBrush="#2580E0" BorderThickness="2">
                    <TextBlock x:Name="RS1Num" Text="1" Foreground="White"
                               FontSize="11.5" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="RS1Lbl" Text="FICHIER ZIP"
                           Foreground="{DynamicResource ThTextBody}" FontFamily="{StaticResource AppFont}" FontSize="11" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>

            <Border x:Name="RS1Line" Grid.Column="1" Height="2" Background="{DynamicResource ThBorder}"
                    VerticalAlignment="Center" Margin="8,0"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="RS2Dot" Width="24" Height="24" CornerRadius="12"
                        Background="{DynamicResource ThPanel}" BorderBrush="{DynamicResource ThBorder}" BorderThickness="2">
                    <TextBlock x:Name="RS2Num" Text="2" Foreground="{DynamicResource ThTextDim}"
                               FontSize="11.5" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="RS2Lbl" Text="LECTURE"
                           Foreground="{DynamicResource ThTextDim}" FontFamily="{StaticResource AppFont}" FontSize="11" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>

            <Border x:Name="RS2Line" Grid.Column="3" Height="2" Background="{DynamicResource ThBorder}"
                    VerticalAlignment="Center" Margin="8,0"/>

            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="RS3Dot" Width="24" Height="24" CornerRadius="12"
                        Background="{DynamicResource ThPanel}" BorderBrush="{DynamicResource ThBorder}" BorderThickness="2">
                    <TextBlock x:Name="RS3Num" Text="3" Foreground="{DynamicResource ThTextDim}"
                               FontSize="11.5" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="RS3Lbl" Text="S&#201;LECTION"
                           Foreground="{DynamicResource ThTextDim}" FontFamily="{StaticResource AppFont}" FontSize="11" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>

            <Border x:Name="RS3Line" Grid.Column="5" Height="2" Background="{DynamicResource ThBorder}"
                    VerticalAlignment="Center" Margin="8,0"/>

            <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="RS4Dot" Width="24" Height="24" CornerRadius="12"
                        Background="{DynamicResource ThPanel}" BorderBrush="{DynamicResource ThBorder}" BorderThickness="2">
                    <TextBlock x:Name="RS4Num" Text="4" Foreground="{DynamicResource ThTextDim}"
                               FontSize="11.5" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="RS4Lbl" Text="INSTALLATION"
                           Foreground="{DynamicResource ThTextDim}" FontFamily="{StaticResource AppFont}" FontSize="11" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- ══ 3 : Hint texte (mis à jour par étape) ═══════════════════════ -->
        <TextBlock x:Name="TxtHint" Grid.Row="3"
                   Text=""
                   Foreground="{DynamicResource ThTextSub}"
                   FontFamily="{StaticResource AppFont}" FontSize="11.5"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0"/>

        <!-- ══ 5 : Panneaux de contenu (superposés, un seul visible à la fois) -->
        <Grid Grid.Row="5">

            <!-- ──────────────────────────────────────────────────── -->
            <!-- S1 : Scan (liste apps avec cases à cocher)           -->
            <!-- ──────────────────────────────────────────────────── -->
            <Grid x:Name="PanelS1" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource ThBorder}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                    <DataGrid x:Name="DgSaveApps"
                              PreviewMouseLeftButtonUp="Dg_RowClickToggle"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserSortColumns="True" IsReadOnly="False"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              RowHeight="38"
                              Background="{DynamicResource ThPanel}"
                              BorderThickness="0"
                              ColumnHeaderStyle="{StaticResource DgHdrStyle}"
                              RowStyle="{StaticResource FreshRowStyle}"
                              Foreground="{DynamicResource ThTextBody}" FontFamily="{StaticResource AppFont}" FontSize="12"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <DataGrid.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"           Color="#1F5BA0FF"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"        Color="#5BA0FF"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#145BA0FF"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#805BA0FF"/>
                        </DataGrid.Resources>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness"  Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Background"       Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="40" CanUserSort="False" CanUserResize="False" CanUserReorder="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Style="{StaticResource DarkChkStyle}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="APPLICATION" Binding="{Binding Name}" Width="*" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="12,0"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <!-- (colonne Winget ID supprimée — même décision que l'onglet
                                 Applications : info interne, l'ID reste dans le modèle) -->
                            <DataGridTextColumn Header="VERSION" Binding="{Binding Version}" Width="100" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground"        Value="{DynamicResource ThTextDim}"/>
                                        <Setter Property="Padding"           Value="12,0"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Barre basse S1 -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnSaveSelectAll" Grid.Column="0"
                            Content="Tout cocher" Style="{StaticResource SecondaryBtnStyle}"
                            Padding="14,8" FontSize="11.5" IsEnabled="False"
                            Click="BtnSaveSelectAll_Click"/>
                    <Button x:Name="BtnSaveDeselectAll" Grid.Column="2"
                            Content="Tout d&#233;cocher" Style="{StaticResource SecondaryBtnStyle}"
                            Padding="14,8" FontSize="11.5" IsEnabled="False"
                            Click="BtnSaveDeselectAll_Click"/>
                    <Button x:Name="BtnDownload" Grid.Column="4"
                            Content="T&#201;L&#201;CHARGER ET ZIPPER (0)"
                            Style="{StaticResource CleanRunBtn}" Padding="20,10"
                            IsEnabled="False"
                            Click="BtnDownload_Click"/>
                </Grid>
            </Grid>

            <!-- ──────────────────────────────────────────────────── -->
            <!-- S2 : Téléchargement en cours                         -->
            <!-- ──────────────────────────────────────────────────── -->
            <Border x:Name="PanelS2" Visibility="Collapsed"
                    Background="{DynamicResource ThPanel}" BorderBrush="{DynamicResource ThBorder}"
                    BorderThickness="1" CornerRadius="12" Padding="24,20">
                <StackPanel VerticalAlignment="Top">
                    <TextBlock x:Name="TxtDlTitle"
                               Text="T&#233;l&#233;chargement en cours&#8230;"
                               Foreground="{DynamicResource ThTextBody}" FontFamily="{StaticResource AppFont}"
                               FontSize="15" FontWeight="Bold" Margin="0,0,0,14"/>
                    <TextBlock x:Name="TxtDlApp"
                               Text=""
                               Foreground="{DynamicResource ThTextNav}" FontFamily="{StaticResource AppFont}"
                               FontSize="11.5" Margin="0,0,0,12"/>
                    <!-- Barre de progression : dégradé bleu + shimmer (style validé v1.3.4) -->
                    <Grid Height="6" Margin="0,0,0,8">
                        <Border Background="{DynamicResource ThTrack}" CornerRadius="3"/>
                        <Grid x:Name="BarDl" ClipToBounds="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0*"/>
                                <ColumnDefinition Width="100*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource FreshAccent}" CornerRadius="3"
                                    ClipToBounds="True">
                                <Border Width="110" HorizontalAlignment="Left" CornerRadius="3">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00FFFFFF" Offset="0"/>
                                            <GradientStop Color="#66FFFFFF" Offset="0.5"/>
                                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="DlShimmer" X="-120"/>
                                    </Border.RenderTransform>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Border.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetName="DlShimmer"
                                                                     Storyboard.TargetProperty="X"
                                                                     From="-120" To="900" Duration="0:0:2.4"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                </Border>
                            </Border>
                        </Grid>
                    </Grid>
                    <TextBlock x:Name="TxtDlStatus"
                               Text="0 / 0"
                               Foreground="{DynamicResource ThTextDim}" FontFamily="{StaticResource AppFont}" FontSize="11.5"/>
                </StackPanel>
            </Border>

            <!-- ──────────────────────────────────────────────────── -->
            <!-- S3 : ZIP prêt                                        -->
            <!-- ──────────────────────────────────────────────────── -->
            <Border x:Name="PanelS3" Visibility="Collapsed"
                    Background="{DynamicResource ThPanel}" BorderBrush="{DynamicResource ThBorder}"
                    BorderThickness="1" CornerRadius="12" Padding="24,20">
                <StackPanel VerticalAlignment="Top">
                    <TextBlock x:Name="TxtZipTitle"
                               Text="&#10003;  ZIP pr&#234;t !"
                               Foreground="#2ECC71" FontFamily="{StaticResource AppFont}"
                               FontSize="18" FontWeight="Bold" Margin="0,0,0,14"/>
                    <TextBlock x:Name="TxtZipPath"
                               Text=""
                               Foreground="{DynamicResource ThTextLabel}" FontFamily="Consolas" FontSize="11.5"
                               TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBlock Text="Copie ce ZIP sur une cl&#233; USB ou un stockage externe."
                               Foreground="{DynamicResource ThTextDim}" FontFamily="{StaticResource AppFont}" FontSize="11.5"
                               TextWrapping="Wrap" Margin="0,0,0,20"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnOpenFolder"
                                Content="&#9654;  OUVRIR T&#201;L&#201;CHARGEMENTS"
                                Style="{StaticResource SecondaryBtnStyle}"
                                Click="BtnOpenFolder_Click"/>
                        <Button x:Name="BtnSaveAgain"
                                Content="Nouveau ZIP"
                                Style="{StaticResource SecondaryBtnStyle}"
                                Margin="10,0,0,0"
                                Click="BtnSaveAgain_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ──────────────────────────────────────────────────── -->
            <!-- R1 : Choisir le fichier ZIP                          -->
            <!-- ──────────────────────────────────────────────────── -->
            <Border x:Name="PanelR1" Visibility="Collapsed"
                    Background="{DynamicResource ThPanel}" BorderBrush="{DynamicResource ThBorder}"
                    BorderThickness="1" CornerRadius="12" Padding="24,20">
                <StackPanel VerticalAlignment="Top">
                    <Button x:Name="BtnPickZip"
                            Content="&#9654;  CHOISIR LE FICHIER ZIP"
                            HorizontalAlignment="Left"
                            Click="BtnPickZip_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryBtnStyle}">
                                <Setter Property="Background"  Value="#12376E"/>
                                <Setter Property="BorderBrush" Value="#1464A8"/>
                                <Setter Property="Foreground"  Value="#DCF0FF"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1A4F9C"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBlock x:Name="TxtPickedZip"
                               Text="Aucun fichier s&#233;lectionn&#233;"
                               Foreground="{DynamicResource ThTextDim}" FontFamily="{StaticResource AppFont}" FontSize="11.5"
                               FontStyle="Italic" Margin="0,14,0,14"
                               TextWrapping="Wrap"/>
                    <Button x:Name="BtnNextR1"
                            Content="SUIVANT &#x2192;"
                            Style="{StaticResource CleanRunBtn}" Padding="20,10"
                            HorizontalAlignment="Left"
                            IsEnabled="False"
                            Click="BtnNextR1_Click"/>
                </StackPanel>
            </Border>

            <!-- ──────────────────────────────────────────────────── -->
            <!-- R2 : Lecture du ZIP                                   -->
            <!-- ──────────────────────────────────────────────────── -->
            <Border x:Name="PanelR2" Visibility="Collapsed"
                    Background="{DynamicResource ThPanel}" BorderBrush="{DynamicResource ThBorder}"
                    BorderThickness="1" CornerRadius="12" Padding="24,20">
                <TextBlock Text="Lecture du ZIP en cours&#8230;"
                           Foreground="{DynamicResource ThTextNav}" FontFamily="{StaticResource AppFont}" FontSize="13"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- ──────────────────────────────────────────────────── -->
            <!-- R3 : Sélection des apps à réinstaller                -->
            <!-- ──────────────────────────────────────────────────── -->
            <Grid x:Name="PanelR3" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource ThBorder}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                    <DataGrid x:Name="DgRestApps"
                              PreviewMouseLeftButtonUp="Dg_RowClickToggle"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserSortColumns="True" IsReadOnly="False"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              RowHeight="38"
                              Background="{DynamicResource ThPanel}"
                              BorderThickness="0"
                              ColumnHeaderStyle="{StaticResource DgHdrStyle}"
                              RowStyle="{StaticResource FreshRowStyle}"
                              Foreground="{DynamicResource ThTextBody}" FontFamily="{StaticResource AppFont}" FontSize="12"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <DataGrid.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"           Color="#1F5BA0FF"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"        Color="#5BA0FF"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#145BA0FF"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#805BA0FF"/>
                        </DataGrid.Resources>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness"  Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Background"       Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="40" CanUserSort="False" CanUserResize="False" CanUserReorder="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Style="{StaticResource DarkChkStyle}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="APPLICATION" Binding="{Binding Name}" Width="*" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="12,0"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="VERSION" Binding="{Binding Version}" Width="100" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground"        Value="{DynamicResource ThTextDim}"/>
                                        <Setter Property="Padding"           Value="12,0"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="STATUT" Width="130" CanUserSort="False" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Status}"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusColor}}"
                                                   FontFamily="{StaticResource AppFont}" FontSize="11.5"
                                                   VerticalAlignment="Center" Padding="12,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Barre basse R3 -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnRestSelectAll" Grid.Column="0"
                            Content="Tout cocher" Style="{StaticResource SecondaryBtnStyle}"
                            Padding="14,8" FontSize="11.5" IsEnabled="False"
                            Click="BtnRestSelectAll_Click"/>
                    <Button x:Name="BtnRestDeselectAll" Grid.Column="2"
                            Content="Tout d&#233;cocher" Style="{StaticResource SecondaryBtnStyle}"
                            Padding="14,8" FontSize="11.5" IsEnabled="False"
                            Click="BtnRestDeselectAll_Click"/>
                    <Button x:Name="BtnInstall" Grid.Column="4"
                            Content="INSTALLER (0)"
                            Style="{StaticResource CleanRunBtn}" Padding="20,10"
                            IsEnabled="False"
                            Click="BtnInstall_Click"/>
                </Grid>
            </Grid>

            <!-- ──────────────────────────────────────────────────── -->
            <!-- R4 : Installation en cours                           -->
            <!-- ──────────────────────────────────────────────────── -->
            <Border x:Name="PanelR4" Visibility="Collapsed"
                    Background="{DynamicResource ThPanel}" BorderBrush="{DynamicResource ThBorder}"
                    BorderThickness="1" CornerRadius="12" Padding="24,20">
                <StackPanel VerticalAlignment="Top">
                    <Grid Margin="0,0,0,14">
                        <TextBlock x:Name="TxtInstTitle"
                                   Text="Installation en cours&#8230;"
                                   Foreground="{DynamicResource ThTextBody}" FontFamily="{StaticResource AppFont}"
                                   FontSize="15" FontWeight="Bold"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <Button x:Name="BtnCancelInst"
                                Content="Annuler"
                                Style="{StaticResource SecondaryBtnStyle}"
                                Padding="12,5" FontSize="11.5"
                                HorizontalAlignment="Right"
                                Click="BtnCancelInst_Click"/>
                    </Grid>
                    <TextBlock x:Name="TxtInstApp"
                               Text=""
                               Foreground="{DynamicResource ThTextNav}" FontFamily="{StaticResource AppFont}"
                               FontSize="11.5" Margin="0,0,0,12"/>
                    <!-- Barre d'installation : même style dégradé + shimmer -->
                    <Grid Height="6" Margin="0,0,0,8">
                        <Border Background="{DynamicResource ThTrack}" CornerRadius="3"/>
                        <Grid x:Name="BarInst" ClipToBounds="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0*"/>
                                <ColumnDefinition Width="100*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource FreshAccent}" CornerRadius="3"
                                    ClipToBounds="True">
                                <Border Width="110" HorizontalAlignment="Left" CornerRadius="3">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00FFFFFF" Offset="0"/>
                                            <GradientStop Color="#66FFFFFF" Offset="0.5"/>
                                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="InstShimmer" X="-120"/>
                                    </Border.RenderTransform>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Border.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetName="InstShimmer"
                                                                     Storyboard.TargetProperty="X"
                                                                     From="-120" To="900" Duration="0:0:2.4"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                </Border>
                            </Border>
                        </Grid>
                    </Grid>
                    <TextBlock x:Name="TxtInstStatus"
                               Text="0 / 0"
                               Foreground="{DynamicResource ThTextDim}" FontFamily="{StaticResource AppFont}" FontSize="11.5"/>
                </StackPanel>
            </Border>

        </Grid><!-- fin contenu -->
    </Grid>
</UserControl>
