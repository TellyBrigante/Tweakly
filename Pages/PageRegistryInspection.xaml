<UserControl x:Class="Optimisation_Tool.Pages.PageRegistryInspection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="RegistryCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThPanel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15,13"/>
        </Style>

        <Style x:Key="RegistryCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThTextDim}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="RegistryProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="7"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Background" Value="{DynamicResource ThTrack}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThAccentIcon}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource ThBorder}"
                                    BorderThickness="1" CornerRadius="4"/>
                            <Decorator x:Name="PART_Indicator" HorizontalAlignment="Left">
                                <Border Background="{TemplateBinding Foreground}" CornerRadius="4"/>
                            </Decorator>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18,14,18,18" MaxWidth="1080" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Registre Windows"
                           Foreground="{DynamicResource ThTextTitle}"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="V&#233;rifie les zones document&#233;es du registre sans modifier Windows."
                           Foreground="{DynamicResource ThTextSub}"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="11.5" Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Border Background="{DynamicResource ThWarnTint}"
                        BorderBrush="{DynamicResource ThWarn}"
                        BorderThickness="1" CornerRadius="8"
                        Padding="12,6" Margin="0,0,8,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="EXP&#201;RIMENTAL"
                               Foreground="{DynamicResource ThWarn}"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="10" FontWeight="Bold"/>
                </Border>
                <Button x:Name="BtnAnalyze" Content="ANALYSER LE REGISTRE"
                        Style="{StaticResource CleanRunBtn}"
                        Padding="18,9" Click="BtnAnalyze_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource ThInfoTint}"
                BorderBrush="{DynamicResource ThInfoBorderTint}"
                BorderThickness="1" CornerRadius="8" Padding="13,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets"
                           Foreground="{DynamicResource ThAccentIcon}"
                           FontSize="15" Margin="0,0,10,0" VerticalAlignment="Top"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Analyse en lecture seule"
                               Foreground="{DynamicResource ThTextBody}"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="11.5" FontWeight="SemiBold"/>
                    <TextBlock Text="Aucune valeur n'est modifi&#233;e. Un constat signale un &#233;cart &#224; examiner, pas automatiquement une corruption."
                               Foreground="{DynamicResource ThTextDim}"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="10.8" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="0 CORRECTION AUTOMATIQUE"
                           Foreground="{DynamicResource ThAccentIcon}"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="9.5" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
            </Grid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource RegistryCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="TxtScanTitle" Text="Pr&#234;t &#224; analyser"
                                   Foreground="{DynamicResource ThTextTitle}"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="13.5" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtScanStage"
                                   Text="D&#233;marrage, AppInit, IFEO, Winlogon, services et associations de fichiers."
                                   Foreground="{DynamicResource ThTextDim}"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="10.8" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtScanPercent" Grid.Column="1" Text="0 %"
                               Foreground="{DynamicResource ThTextNav}"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="11" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="14,0,0,0"/>
                </Grid>

                <ProgressBar x:Name="PbScan" Grid.Row="2"
                             Style="{StaticResource RegistryProgress}"
                             Value="0" Visibility="Collapsed"/>

                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource ThPill}"
                            BorderBrush="{DynamicResource ThBorder}" BorderThickness="1"
                            CornerRadius="6" Padding="11,8">
                        <StackPanel>
                            <TextBlock Text="CONSTATS" Style="{StaticResource RegistryCaption}"/>
                            <TextBlock x:Name="TxtTotal" Text="&#8212;" Foreground="{DynamicResource ThTextTitle}"
                                       FontFamily="{StaticResource AppFont}" FontSize="18" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{DynamicResource ThPill}"
                            BorderBrush="{DynamicResource ThCritBorderTint}" BorderThickness="1"
                            CornerRadius="6" Padding="11,8">
                        <StackPanel>
                            <TextBlock Text="ANOMALIES CERTAINES" Style="{StaticResource RegistryCaption}"
                                       Foreground="{DynamicResource ThCrit}"/>
                            <TextBlock x:Name="TxtMalformed" Text="&#8212;" Foreground="{DynamicResource ThCrit}"
                                       FontFamily="{StaticResource AppFont}" FontSize="18" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Background="{DynamicResource ThPill}"
                            BorderBrush="{DynamicResource ThWarnBorderTint}" BorderThickness="1"
                            CornerRadius="6" Padding="11,8">
                        <StackPanel>
                            <TextBlock Text="INHABITUELS" Style="{StaticResource RegistryCaption}"
                                       Foreground="{DynamicResource ThWarn}"/>
                            <TextBlock x:Name="TxtReview" Text="&#8212;" Foreground="{DynamicResource ThWarn}"
                                       FontFamily="{StaticResource AppFont}" FontSize="18" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="6" Background="{DynamicResource ThPill}"
                            BorderBrush="{DynamicResource ThBorder}" BorderThickness="1"
                            CornerRadius="6" Padding="11,8">
                        <StackPanel>
                            <TextBlock Text="INFORMATIONS" Style="{StaticResource RegistryCaption}"/>
                            <TextBlock x:Name="TxtUnreadable" Text="&#8212;" Foreground="{DynamicResource ThTextBody}"
                                       FontFamily="{StaticResource AppFont}" FontSize="18" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="6" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border x:Name="EmptyState" Style="{StaticResource RegistryCard}"
                        Padding="18,22">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets"
                                   Foreground="{DynamicResource ThAccentIcon}"
                                   FontSize="24" HorizontalAlignment="Center"/>
                        <TextBlock Text="Aucune analyse lanc&#233;e"
                                   Foreground="{DynamicResource ThTextTitle}"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="14" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,9,0,0"/>
                        <TextBlock Text="L'analyse reste locale et ne modifie aucune valeur."
                                   Foreground="{DynamicResource ThTextDim}"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <StackPanel x:Name="ResultsPanel"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
