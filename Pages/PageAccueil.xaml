<UserControl x:Class="Optimisation_Tool.Pages.PageAccueil"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">

    <UserControl.Resources>
        <!-- Tuile cliquable : bordure plate 1 px, hover discret (bordure devient bleu accent) -->
        <Style x:Key="DashTile" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{DynamicResource ThPanel}"
                                BorderBrush="{DynamicResource ThBorder}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16,14,16,14">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource ThAccentIcon}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ThHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- En-tête de tuile : ICÔNE + LABEL section -->
        <Style x:Key="DashHdrIcon" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThAccentIcon}"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
        </Style>
        <Style x:Key="DashHdrLbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThTextDim}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize"   Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Valeur principale -->
        <Style x:Key="DashValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThTextTitle}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize"   Value="32"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="LineHeight" Value="36"/>
        </Style>
        <Style x:Key="DashValueUnit" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThTextDim}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="5,0,0,6"/>
        </Style>

        <!-- Sous-titre / ligne secondaire -->
        <Style x:Key="DashSub" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThTextDim}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize"   Value="11.5"/>
            <Setter Property="Margin"     Value="0,3,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- Ligne cliquable du panneau Activité récente -->
        <Style x:Key="ActivityRow" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1,0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" Padding="8,6" CornerRadius="4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ThHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ActivityIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style x:Key="ActivityDate" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThTextDim}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style x:Key="ActivityText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThTextBody}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize"   Value="11.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- Lignes clé/valeur (Matériel, Stockage, sous-scores Bench) -->
        <Style x:Key="DashRowLbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThTextDim}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DashRowVal" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThTextBody}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- En-tête -->
            <RowDefinition Height="Auto"/>   <!-- Rangée 1 de tuiles -->
            <RowDefinition Height="14"/>     <!-- Espace -->
            <RowDefinition Height="Auto"/>   <!-- Rangée 2 de tuiles -->
            <RowDefinition Height="14"/>     <!-- Espace -->
            <RowDefinition Height="*"/>      <!-- Activité récente (prend tout l'espace bas) -->
            <RowDefinition Height="Auto"/>   <!-- Bandeau alertes -->
        </Grid.RowDefinitions>

        <!-- ══════ EN-TÊTE ══════ -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Vue d'ensemble"
                           FontFamily="{StaticResource AppFont}" FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource ThTextTitle}"/>
                <TextBlock x:Name="TxtHeaderSub"
                           Text="Chargement…"
                           FontFamily="{StaticResource AppFont}" FontSize="12"
                           Foreground="{DynamicResource ThTextDim}" Margin="0,2,0,0"/>
            </StackPanel>
            <!-- Indicateur d'état plat (LED carrée + texte) — pas de pilule ovale -->
            <StackPanel x:Name="HeaderBadge" Grid.Column="1" Orientation="Horizontal"
                        VerticalAlignment="Center" Visibility="Collapsed">
                <Border x:Name="HeaderBadgeLed" Width="8" Height="8" CornerRadius="1"
                        Background="{DynamicResource ThOk}" VerticalAlignment="Center"
                        Margin="0,0,7,0"/>
                <TextBlock x:Name="TxtHeaderBadge" Text=""
                           FontFamily="{StaticResource AppFont}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource ThTextBody}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- ══════ RANGÉE 1 ══════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Tuile 1 : Tweakly Score + sous-scores ── -->
            <Button Grid.Column="0" Style="{StaticResource DashTile}" Click="TileScore_Click">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9D9;" Style="{StaticResource DashHdrIcon}"/>
                        <TextBlock Text="TWEAKLY SCORE" Style="{StaticResource DashHdrLbl}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TxtScoreValue" Text="—" Style="{StaticResource DashValue}"
                                   Foreground="{DynamicResource ThAccentIcon}"/>
                        <TextBlock x:Name="TxtScoreDelta" Text="" Style="{StaticResource DashValueUnit}"
                                   Margin="10,0,0,6"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtScoreSub" Text="Aucun benchmark" Style="{StaticResource DashSub}"/>
                    <!-- Sous-scores : 3 mini-barres -->
                    <Grid x:Name="ScoreSubGrid" Margin="0,12,0,0" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CPU" Style="{StaticResource DashRowLbl}"/>
                            <Grid Grid.Column="1" Height="4" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Border CornerRadius="2" Background="{DynamicResource ThTrack}"/>
                                <Grid x:Name="ScoreCpuBar">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0*"/><ColumnDefinition Width="100*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="2"
                                            Background="{DynamicResource ThAccentIcon}"/>
                                </Grid>
                            </Grid>
                            <TextBlock x:Name="TxtScoreCpu" Grid.Column="2" Text="—" Style="{StaticResource DashRowVal}"/>
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Système" Style="{StaticResource DashRowLbl}"/>
                            <Grid Grid.Column="1" Height="4" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Border CornerRadius="2" Background="{DynamicResource ThTrack}"/>
                                <Grid x:Name="ScoreSysBar">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0*"/><ColumnDefinition Width="100*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="2"
                                            Background="{DynamicResource ThAccentIcon}"/>
                                </Grid>
                            </Grid>
                            <TextBlock x:Name="TxtScoreSys" Grid.Column="2" Text="—" Style="{StaticResource DashRowVal}"/>
                        </Grid>
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Réseau" Style="{StaticResource DashRowLbl}"/>
                            <Grid Grid.Column="1" Height="4" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Border CornerRadius="2" Background="{DynamicResource ThTrack}"/>
                                <Grid x:Name="ScoreNetBar">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0*"/><ColumnDefinition Width="100*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="2"
                                            Background="{DynamicResource ThAccentIcon}"/>
                                </Grid>
                            </Grid>
                            <TextBlock x:Name="TxtScoreNet" Grid.Column="2" Text="—" Style="{StaticResource DashRowVal}"/>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Button>

            <!-- ── Tuile 2 : Santé système + 3 derniers incidents ── -->
            <Button Grid.Column="2" Style="{StaticResource DashTile}" Click="TileHealth_Click">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE730;" Style="{StaticResource DashHdrIcon}"/>
                        <TextBlock Text="SANTÉ SYSTÈME" Style="{StaticResource DashHdrLbl}"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtHealthValue" Text="—" Style="{StaticResource DashValue}"
                               Foreground="{DynamicResource ThTextTitle}"/>
                    <TextBlock x:Name="TxtHealthSub" Text="Analyse…" Style="{StaticResource DashSub}"/>
                    <!-- Liste des 3 derniers incidents -->
                    <StackPanel x:Name="HealthList" Margin="0,12,0,0"/>
                </StackPanel>
            </Button>

            <!-- ── Tuile 3 : Dernière session jeu ── -->
            <Button Grid.Column="4" Style="{StaticResource DashTile}" Click="TileGame_Click">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7FC;" Style="{StaticResource DashHdrIcon}"/>
                        <TextBlock Text="DERNIÈRE SESSION JEU" Style="{StaticResource DashHdrLbl}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TxtGameValue" Text="—" Style="{StaticResource DashValue}"
                                   Foreground="{DynamicResource ThTextTitle}"/>
                        <TextBlock Text="fps" Style="{StaticResource DashValueUnit}" Margin="6,0,0,6"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtGameSub" Text="Aucune capture" Style="{StaticResource DashSub}"/>
                    <!-- Détails 0.1% low + CV% -->
                    <Grid x:Name="GameStatsGrid" Margin="0,12,0,0" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="0,1 % low" Style="{StaticResource DashRowLbl}"/>
                            <TextBlock x:Name="TxtGameLow" Grid.Column="1" Text="—" Style="{StaticResource DashRowVal}"/>
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Stabilité frametime" Style="{StaticResource DashRowLbl}"/>
                            <TextBlock x:Name="TxtGameCv" Grid.Column="1" Text="—" Style="{StaticResource DashRowVal}"/>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ══════ RANGÉE 2 ══════ -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Tuile 4 : Matériel en direct avec mini-barres ── -->
            <Button Grid.Column="0" Style="{StaticResource DashTile}" Click="TileHardware_Click">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE950;" Style="{StaticResource DashHdrIcon}"/>
                        <TextBlock Text="MATÉRIEL EN DIRECT" Style="{StaticResource DashHdrLbl}"/>
                    </StackPanel>
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- CPU -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CPU" Style="{StaticResource DashRowLbl}"/>
                            <Grid Grid.Column="1" Height="4" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Border CornerRadius="2" Background="{DynamicResource ThTrack}"/>
                                <Grid x:Name="HwCpuBar">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0*"/><ColumnDefinition Width="100*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="2"
                                            Background="{DynamicResource ThAccentIcon}"/>
                                </Grid>
                            </Grid>
                            <TextBlock x:Name="TxtHwCpu" Grid.Column="2" Text="—" Style="{StaticResource DashRowVal}"/>
                        </Grid>
                        <!-- GPU -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="GPU" Style="{StaticResource DashRowLbl}"/>
                            <Grid Grid.Column="1" Height="4" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Border CornerRadius="2" Background="{DynamicResource ThTrack}"/>
                                <Grid x:Name="HwGpuBar">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0*"/><ColumnDefinition Width="100*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="2"
                                            Background="{DynamicResource ThAccentIcon}"/>
                                </Grid>
                            </Grid>
                            <TextBlock x:Name="TxtHwGpu" Grid.Column="2" Text="—" Style="{StaticResource DashRowVal}"/>
                        </Grid>
                        <!-- RAM -->
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="RAM" Style="{StaticResource DashRowLbl}"/>
                            <Grid Grid.Column="1" Height="4" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Border CornerRadius="2" Background="{DynamicResource ThTrack}"/>
                                <Grid x:Name="HwRamBar">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0*"/><ColumnDefinition Width="100*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="2"
                                            Background="{DynamicResource ThAccentIcon}"/>
                                </Grid>
                            </Grid>
                            <TextBlock x:Name="TxtHwRam" Grid.Column="2" Text="—" Style="{StaticResource DashRowVal}"/>
                        </Grid>
                        <!-- Températures -->
                        <Grid Grid.Row="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Temp." Style="{StaticResource DashRowLbl}"/>
                            <TextBlock x:Name="TxtHwTemp" Grid.Column="2" Text="—" Style="{StaticResource DashRowVal}"/>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Button>

            <!-- ── Tuile 5 : Stockage ── -->
            <Button Grid.Column="2" Style="{StaticResource DashTile}" Click="TileStorage_Click">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEDA2;" Style="{StaticResource DashHdrIcon}"/>
                        <TextBlock Text="STOCKAGE" Style="{StaticResource DashHdrLbl}"/>
                    </StackPanel>
                    <StackPanel x:Name="StorageList" Margin="0,12,0,0"/>
                </StackPanel>
            </Button>

            <!-- ── Tuile 6 : Réseau (ping + débits visibles) ── -->
            <Button Grid.Column="4" Style="{StaticResource DashTile}" Click="TileNetwork_Click">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE839;" Style="{StaticResource DashHdrIcon}"/>
                        <TextBlock Text="RÉSEAU" Style="{StaticResource DashHdrLbl}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TxtNetValue" Text="—" Style="{StaticResource DashValue}"
                                   Foreground="{DynamicResource ThTextTitle}"/>
                        <TextBlock Text="ms ping" Style="{StaticResource DashValueUnit}" Margin="6,0,0,6"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtNetSub" Text="Mesure…" Style="{StaticResource DashSub}"/>
                    <Grid x:Name="NetSpeedGrid" Margin="0,12,0,0" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="↓ Téléchargement" Style="{StaticResource DashRowLbl}"/>
                            <TextBlock x:Name="TxtNetDown" Grid.Column="1" Text="—" Style="{StaticResource DashRowVal}"/>
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="↑ Envoi" Style="{StaticResource DashRowLbl}"/>
                            <TextBlock x:Name="TxtNetUp" Grid.Column="1" Text="—" Style="{StaticResource DashRowVal}"/>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ══════ ACTIVITÉ RÉCENTE (plein-largeur) ══════ -->
        <Border Grid.Row="5"
                Background="{DynamicResource ThPanel}"
                BorderBrush="{DynamicResource ThBorder}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16,14,16,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="&#xE9D5;" Style="{StaticResource DashHdrIcon}"/>
                    <TextBlock Text="ACTIVITÉ RÉCENTE" Style="{StaticResource DashHdrLbl}"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ActivityList"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ══════ BANDEAU D'ALERTES (collapsable si rien à dire) ══════ -->
        <Border x:Name="AlertsStripe" Grid.Row="6"
                Background="{DynamicResource ThPanel}"
                BorderBrush="{DynamicResource ThBorder}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14,10"
                Margin="0,16,0,0"
                Visibility="Collapsed">
            <StackPanel x:Name="AlertsList"/>
        </Border>
    </Grid>
</UserControl>
