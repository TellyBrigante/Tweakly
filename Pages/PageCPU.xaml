<UserControl x:Class="Optimisation_Tool.Pages.PageCPU"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Loaded="UserControl_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="18,14,18,18">

            <!-- DA optim v1.3.5 (validee sur Nettoyage) : rangees switch/icone/texte -->
            <TextBlock Text="TWEAKS CPU"
                       Foreground="{DynamicResource ThTextDim}" FontFamily="{StaticResource AppFont}"
                       FontSize="10.5" FontWeight="SemiBold" Margin="2,0,0,7"/>
            <Border Background="{DynamicResource ThPanel}" BorderBrush="#1A808080"
                    BorderThickness="1" CornerRadius="12" Padding="8,7">
                <StackPanel Grid.IsSharedSizeScope="True">

                    <Border Style="{StaticResource CleanRowStyle}" Tag="{x:Reference ChkUltimatePower}"
                            MouseLeftButtonUp="Row_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ChkUltimatePower" Grid.Column="0" VerticalAlignment="Center"
                                      Style="{StaticResource CleanSwitch}"/>
                            <Border Grid.Column="1" Style="{StaticResource CleanIconBox}" Margin="14,0,0,0">
                                <TextBlock Text="&#xE945;" Style="{StaticResource CleanIconGlyph}"/>
                            </Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="13,0,4,0">
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CleanBadgeColumn"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Activer le mode Performances Ultimes" Style="{StaticResource CleanRowTitle}" TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Column="1" Style="{StaticResource CleanDefaultBadge}">
                                        <TextBlock Text="Au besoin" Style="{StaticResource CleanDefaultText}"/>
                                    </Border>
                                </Grid>
                                <TextBlock Style="{StaticResource CleanRowDesc}">
                                    <InlineUIContainer BaselineAlignment="Center">
                                        <Border Style="{StaticResource CleanMiniStateOff}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource CleanMiniStateKnob}"/>
                                                <TextBlock Grid.Column="1" Text="O" Style="{StaticResource CleanMiniStateTextOff}"/>
                                            </Grid>
                                        </Border>
                                    </InlineUIContainer>
                                    <Run Text="D&#233;faut &#183; "/>
                                    <Run Text="Coche sur PC fixe ; &#224; &#233;viter sur batterie."/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CleanRowStyle}" Tag="{x:Reference ChkDisableThrottling}"
                            MouseLeftButtonUp="Row_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ChkDisableThrottling" Grid.Column="0" VerticalAlignment="Center"
                                      Style="{StaticResource CleanSwitch}"/>
                            <Border Grid.Column="1" Style="{StaticResource CleanIconBox}" Margin="14,0,0,0">
                                <TextBlock Text="&#xE823;" Style="{StaticResource CleanIconGlyph}"/>
                            </Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="13,0,4,0">
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CleanBadgeColumn"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="D&#233;sactiver le Power Throttling" Style="{StaticResource CleanRowTitle}" TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Column="1" Style="{StaticResource CleanDefaultBadge}">
                                        <TextBlock Text="&#192; cocher" Style="{StaticResource CleanDefaultText}"/>
                                    </Border>
                                </Grid>
                                <TextBlock Style="{StaticResource CleanRowDesc}">
                                    <InlineUIContainer BaselineAlignment="Center">
                                        <Border Style="{StaticResource CleanMiniStateOff}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource CleanMiniStateKnob}"/>
                                                <TextBlock Grid.Column="1" Text="O" Style="{StaticResource CleanMiniStateTextOff}"/>
                                            </Grid>
                                        </Border>
                                    </InlineUIContainer>
                                    <Run Text="D&#233;faut &#183; "/>
                                    <Run Text="Coche pour &#233;viter le bridage CPU."/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CleanRowStyle}" Tag="{x:Reference ChkSysResponsiveness}"
                            MouseLeftButtonUp="Row_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ChkSysResponsiveness" Grid.Column="0" VerticalAlignment="Center"
                                      Style="{StaticResource CleanSwitch}"/>
                            <Border Grid.Column="1" Style="{StaticResource CleanIconBox}" Margin="14,0,0,0">
                                <TextBlock Text="&#xE71D;" Style="{StaticResource CleanIconGlyph}"/>
                            </Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="13,0,4,0">
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CleanBadgeColumn"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Prioriser les applications au premier plan" Style="{StaticResource CleanRowTitle}" TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Column="1" Style="{StaticResource CleanDefaultBadge}">
                                        <TextBlock Text="&#192; cocher" Style="{StaticResource CleanDefaultText}"/>
                                    </Border>
                                </Grid>
                                <TextBlock Style="{StaticResource CleanRowDesc}">
                                    <InlineUIContainer BaselineAlignment="Center">
                                        <Border Style="{StaticResource CleanMiniStateOff}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource CleanMiniStateKnob}"/>
                                                <TextBlock Grid.Column="1" Text="O" Style="{StaticResource CleanMiniStateTextOff}"/>
                                            </Grid>
                                        </Border>
                                    </InlineUIContainer>
                                    <Run Text="D&#233;faut &#183; "/>
                                    <Run Text="Coche pour prioriser l'application active."/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- GlobalTimerResolution RETIRE (2026-06-12) : mesure catastrophique
                         au bench sur build Windows 26200 (score Systeme effondre) alors que la
                         doc 22H2/23H2 le dit benefique - comportement dependant du build =
                         viole la regle "jamais d'instabilite". NE PAS le remettre sans
                         re-validation bench avant/apres sur le build cible. -->

                    <Border Style="{StaticResource CleanRowStyle}" Tag="{x:Reference ChkHVCI}"
                            MouseLeftButtonUp="Row_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ChkHVCI" Grid.Column="0" VerticalAlignment="Center"
                                      Style="{StaticResource CleanSwitch}"/>
                            <Border Grid.Column="1" Style="{StaticResource CleanIconBox}" Margin="14,0,0,0">
                                <TextBlock Text="&#xE72E;" Style="{StaticResource CleanIconGlyph}"/>
                            </Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="13,0,4,0">
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CleanBadgeColumn"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="D&#233;sactiver Memory Integrity (HVCI)" Style="{StaticResource CleanRowTitle}" TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Column="1" Style="{StaticResource CleanDefaultBadge}">
                                        <TextBlock Text="Au besoin" Style="{StaticResource CleanDefaultText}"/>
                                    </Border>
                                </Grid>
                                <TextBlock Style="{StaticResource CleanRowDesc}">
                                    <InlineUIContainer BaselineAlignment="Center">
                                        <Border Style="{StaticResource CleanMiniStateOff}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource CleanMiniStateKnob}"/>
                                                <TextBlock Grid.Column="1" Text="O" Style="{StaticResource CleanMiniStateTextOff}"/>
                                            </Grid>
                                        </Border>
                                    </InlineUIContainer>
                                    <Run Text="D&#233;faut &#183; "/>
                                    <Run Text="Coche pour gagner en perf, protection r&#233;duite."/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                <Button x:Name="BtnAppliquer"
                        Content="APPLIQUER LES TWEAKS CPU"
                        Style="{StaticResource CleanRunBtn}"
                        Click="BtnAppliquer_Click"/>
            </StackPanel>

            <Border x:Name="StatusBanner" Visibility="Collapsed"
                    Margin="0,16,0,0" Padding="14,10" CornerRadius="8"
                    Background="{DynamicResource ThPanel}"
                    BorderBrush="{DynamicResource ThBorder}" BorderThickness="1"
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10"
                             VerticalAlignment="Center" Margin="0,0,10,0" Fill="{DynamicResource ThOk}"/>
                    <TextBlock x:Name="StatusText" Text=""
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource AppFont}" FontSize="12.5"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
