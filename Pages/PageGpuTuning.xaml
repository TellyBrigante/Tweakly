<UserControl x:Class="Optimisation_Tool.Pages.PageGpuTuning"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <Style x:Key="GpuCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThPanel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>
        <Style x:Key="GpuLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThTextDim}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="GpuValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThTextTitle}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="GpuProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="9"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Background" Value="{DynamicResource ThTrack}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThAccentIcon}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource ThBorder}"
                                    BorderThickness="1" CornerRadius="5"/>
                            <Border x:Name="PART_Track" Background="Transparent" CornerRadius="5"/>
                            <Decorator x:Name="PART_Indicator" HorizontalAlignment="Left">
                                <Border Background="{TemplateBinding Foreground}" CornerRadius="5"/>
                            </Decorator>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GpuTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ThBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThTextBody}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="18,14,18,18" MaxWidth="1040" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Optimisation GPU" Foreground="{DynamicResource ThTextTitle}"
                                   FontFamily="{StaticResource AppFont}" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="Mesure le GPU à stock avant de comparer un undervolt. Aucun réglage n'est appliqué automatiquement."
                                   Foreground="{DynamicResource ThTextDim}" FontFamily="{StaticResource AppFont}"
                                   FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                        <Border Background="{DynamicResource ThWarnTint}"
                                BorderBrush="{DynamicResource ThWarnBorderTint}" BorderThickness="1"
                                CornerRadius="6" Padding="10,6" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="EXPÉRIMENTAL" Foreground="{DynamicResource ThWarn}"
                                       FontFamily="{StaticResource AppFont}" FontSize="10.5" FontWeight="Bold"/>
                        </Border>
                        <Button x:Name="BtnRefresh" Content="ACTUALISER"
                                Style="{StaticResource SecondaryBtnStyle}" Click="BtnRefresh_Click"/>
                    </StackPanel>
                </Grid>
                <Border Background="{DynamicResource ThWarnTint}"
                        BorderBrush="{DynamicResource ThWarnBorderTint}" BorderThickness="1"
                        CornerRadius="8" Padding="13,10" Margin="0,13,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="⚠" Foreground="{DynamicResource ThWarn}"
                                   FontFamily="{StaticResource AppFont}" FontSize="16" FontWeight="Bold"
                                   VerticalAlignment="Top" Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="1"
                                   Text="Fonction expérimentale — N'utilise cette page que si tu sais remettre ton GPU à stock. Tweakly mesure les profils, mais ne les applique pas et ne peut pas récupérer un réglage instable à ta place."
                                   Foreground="{DynamicResource ThTextBody}" FontFamily="{StaticResource AppFont}"
                                   FontSize="11.2" TextWrapping="Wrap"/>
                    </Grid>
                </Border>
            </StackPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource GpuCard}">
                    <StackPanel>
                        <TextBlock Text="CARTE GRAPHIQUE" Style="{StaticResource GpuLabel}"/>
                        <TextBlock x:Name="TxtGpu" Text="Lecture en cours…" Style="{StaticResource GpuValue}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource GpuCard}">
                    <StackPanel>
                        <TextBlock Text="PILOTE / VBIOS" Style="{StaticResource GpuLabel}"/>
                        <TextBlock x:Name="TxtDriver" Text="—" Style="{StaticResource GpuValue}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource GpuCard}">
                    <StackPanel>
                        <TextBlock Text="LIMITE DE PUISSANCE" Style="{StaticResource GpuLabel}"/>
                        <TextBlock x:Name="TxtPower" Text="— W" Style="{StaticResource GpuValue}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="6" Style="{StaticResource GpuCard}">
                    <StackPanel>
                        <TextBlock Text="MÉMOIRE" Style="{StaticResource GpuLabel}"/>
                        <TextBlock x:Name="TxtMemory" Text="— MHz" Style="{StaticResource GpuValue}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.65*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource GpuCard}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Mesure de référence" Foreground="{DynamicResource ThTextTitle}"
                                           FontFamily="{StaticResource AppFont}" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="3 passages · calcul · rendu · ray tracing · mémoire · transitions"
                                           Foreground="{DynamicResource ThTextDim}" FontFamily="{StaticResource AppFont}"
                                           FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtProgressPercent" Grid.Column="1" Text="0 %"
                                       Foreground="{DynamicResource ThTextNav}" FontFamily="{StaticResource AppFont}"
                                       FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </Grid>
                        <ProgressBar x:Name="PbBaseline" Style="{StaticResource GpuProgress}" Margin="0,14,0,0"/>
                        <TextBlock x:Name="TxtRunState" Text="Aucun test en cours. Durée prévue : environ 15 min."
                                   Foreground="{DynamicResource ThTextBody}" FontFamily="{StaticResource AppFont}"
                                   FontSize="11.5" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button x:Name="BtnStart" Content="MESURER À STOCK"
                                    Style="{StaticResource PrimaryBtnStyle}" Click="BtnStart_Click"/>
                            <Button x:Name="BtnCancel" Content="ANNULER" Margin="8,0,0,0"
                                    Style="{StaticResource SecondaryBtnStyle}" Click="BtnCancel_Click"
                                    Visibility="Collapsed"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource GpuCard}">
                    <StackPanel>
                        <TextBlock Text="État du protocole" Foreground="{DynamicResource ThTextTitle}"
                                   FontFamily="{StaticResource AppFont}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtProtocolState" Text="Vérification en cours…"
                                   Foreground="{DynamicResource ThTextBody}" FontFamily="{StaticResource AppFont}"
                                   FontSize="11.5" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        <Border Background="{DynamicResource ThPill}" CornerRadius="6" Padding="10,7" Margin="0,14,0,0">
                            <TextBlock Text="La courbe tension/fréquence doit être remise à zéro manuellement avant la mesure. Tweakly vérifie ensuite la puissance et la mémoire visibles."
                                       Foreground="{DynamicResource ThTextDim}" FontFamily="{StaticResource AppFont}"
                                       FontSize="10.8" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="6" Style="{StaticResource GpuCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Dernière référence enregistrée" Foreground="{DynamicResource ThTextTitle}"
                                   FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtBaselineStatus" Text="Aucune mesure de référence enregistrée."
                                   Foreground="{DynamicResource ThTextDim}" FontFamily="{StaticResource AppFont}"
                                   FontSize="11.5" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtBaselineBadge" Grid.Column="1" Text="À mesurer"
                               Foreground="{DynamicResource ThTextNav}" Background="{DynamicResource ThPill}"
                               FontFamily="{StaticResource AppFont}" FontSize="10.5" FontWeight="SemiBold"
                               Padding="10,5" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </Grid>
            </Border>

            <Border x:Name="AdviceCard" Grid.Row="8" Style="{StaticResource GpuCard}"
                    Margin="0,0,0,14" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtAdviceTitle" Text="Point de départ calculé" Foreground="{DynamicResource ThTextTitle}"
                                       FontFamily="{StaticResource AppFont}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtAdviceConfidence" Text="—" Margin="9,0,0,0"
                                       Foreground="{DynamicResource ThTextNav}" Background="{DynamicResource ThPill}"
                                       FontFamily="{StaticResource AppFont}" FontSize="10.5" FontWeight="SemiBold"
                                       Padding="8,3" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtAdviceValues" Text="— mV · — MHz · mémoire à stock · Power Limit 100 %"
                                   Foreground="{DynamicResource ThTextTitle}" FontFamily="{StaticResource AppFont}"
                                   FontSize="13.5" FontWeight="SemiBold" Margin="0,9,0,0"/>
                        <TextBlock x:Name="TxtAdviceDetail" Text="—"
                                   Foreground="{DynamicResource ThTextDim}" FontFamily="{StaticResource AppFont}"
                                   FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button x:Name="BtnUseAdvice" Grid.Column="1" Content="UTILISER CES VALEURS"
                            Style="{StaticResource SecondaryBtnStyle}" Margin="18,0,0,0"
                            VerticalAlignment="Center" Click="BtnUseAdvice_Click"/>
                </Grid>
            </Border>

            <Border Grid.Row="10" Style="{StaticResource GpuCard}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Profil à tester" Foreground="{DynamicResource ThTextTitle}"
                                       FontFamily="{StaticResource AppFont}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Applique d'abord le profil dans ton outil habituel, puis renseigne ses valeurs ici. Tweakly mesure et compare, sans modifier le pilote."
                                       Foreground="{DynamicResource ThTextDim}" FontFamily="{StaticResource AppFont}"
                                       FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="~ 5 min" Foreground="{DynamicResource ThTextNav}"
                                   Background="{DynamicResource ThPill}" FontFamily="{StaticResource AppFont}"
                                   FontSize="10.5" FontWeight="SemiBold" Padding="10,5"
                                   VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </Grid>

                    <WrapPanel Margin="0,16,0,0">
                        <StackPanel Width="190" Margin="0,0,10,10">
                            <TextBlock Text="NOM DU PROFIL" Style="{StaticResource GpuLabel}" Margin="1,0,0,5"/>
                            <TextBox x:Name="TxtProfileName" Text="Mon undervolt" Style="{StaticResource GpuTextBox}"/>
                        </StackPanel>
                        <StackPanel Width="120" Margin="0,0,10,10">
                            <TextBlock Text="TENSION (mV)" Style="{StaticResource GpuLabel}" Margin="1,0,0,5"/>
                            <TextBox x:Name="TxtProfileVoltage" Style="{StaticResource GpuTextBox}"/>
                        </StackPanel>
                        <StackPanel Width="130" Margin="0,0,10,10">
                            <TextBlock Text="FRÉQUENCE (MHz)" Style="{StaticResource GpuLabel}" Margin="1,0,0,5"/>
                            <TextBox x:Name="TxtProfileClock" Style="{StaticResource GpuTextBox}"/>
                        </StackPanel>
                        <StackPanel Width="145" Margin="0,0,10,10">
                            <TextBlock Text="MÉMOIRE (+MHz)" Style="{StaticResource GpuLabel}" Margin="1,0,0,5"/>
                            <TextBox x:Name="TxtProfileMemory" Text="0" Style="{StaticResource GpuTextBox}"/>
                        </StackPanel>
                        <StackPanel Width="145" Margin="0,0,0,10">
                            <TextBlock Text="POWER LIMIT (%)" Style="{StaticResource GpuLabel}" Margin="1,0,0,5"/>
                            <TextBox x:Name="TxtProfilePower" Text="100" Style="{StaticResource GpuTextBox}"/>
                        </StackPanel>
                    </WrapPanel>

                    <Grid Margin="1,1,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="ChkStartupDisabled" Style="{StaticResource CleanSwitch}"
                                  VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Text="J'ai désactivé l'application automatique du profil au démarrage de Windows."
                                   Foreground="{DynamicResource ThTextBody}" FontFamily="{StaticResource AppFont}"
                                   FontSize="11.2" TextWrapping="Wrap"/>
                    </Grid>

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Name="PbProfile" Style="{StaticResource GpuProgress}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtProfileProgress" Grid.Column="1" Text="0 %"
                                   Foreground="{DynamicResource ThTextNav}" FontFamily="{StaticResource AppFont}"
                                   FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock x:Name="TxtProfileState" Text="La référence stock est obligatoire avant de mesurer un profil."
                               Foreground="{DynamicResource ThTextBody}" FontFamily="{StaticResource AppFont}"
                               FontSize="11.5" Margin="0,9,0,0" TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="BtnProfileStart" Content="MESURER CE PROFIL"
                                Style="{StaticResource PrimaryBtnStyle}" Click="BtnProfileStart_Click"/>
                        <TextBlock x:Name="TxtProfileButtonHint" Margin="10,0,0,0"
                                   VerticalAlignment="Center" Visibility="Collapsed"
                                   Foreground="{DynamicResource ThWarn}" FontFamily="{StaticResource AppFont}"
                                   FontSize="10.5" FontWeight="SemiBold"/>
                        <Button x:Name="BtnProfileCancel" Content="ANNULER" Margin="8,0,0,0"
                                Style="{StaticResource SecondaryBtnStyle}" Click="BtnCancel_Click"
                                Visibility="Collapsed"/>
                    </StackPanel>

                    <Grid x:Name="ProfileResult" Visibility="Collapsed" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource ThPill}" CornerRadius="6" Padding="11,9">
                            <StackPanel>
                                <TextBlock Text="PERFORMANCE VS STOCK" Style="{StaticResource GpuLabel}"/>
                                <TextBlock x:Name="TxtResultPerformance" Text="— %" Style="{StaticResource GpuValue}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="{DynamicResource ThPill}" CornerRadius="6" Padding="11,9">
                            <StackPanel>
                                <TextBlock Text="PUISSANCE" Style="{StaticResource GpuLabel}"/>
                                <TextBlock x:Name="TxtResultPower" Text="— %" Style="{StaticResource GpuValue}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Background="{DynamicResource ThPill}" CornerRadius="6" Padding="11,9">
                            <StackPanel>
                                <TextBlock Text="RENDEMENT" Style="{StaticResource GpuLabel}"/>
                                <TextBlock x:Name="TxtResultEfficiency" Text="— %" Style="{StaticResource GpuValue}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="6" Background="{DynamicResource ThPill}" CornerRadius="6" Padding="11,9">
                            <StackPanel>
                                <TextBlock Text="TEMPÉRATURE" Style="{StaticResource GpuLabel}"/>
                                <TextBlock x:Name="TxtResultTemperature" Text="— °C" Style="{StaticResource GpuValue}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
