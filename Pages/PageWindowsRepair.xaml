<UserControl x:Class="Optimisation_Tool.Pages.PageWindowsRepair"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <LinearGradientBrush x:Key="RepairAccent" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#3B82E0" Offset="0"/>
            <GradientStop Color="#5BA0FF" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="StepCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThPanel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18,14,18,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="R&#233;paration Windows"
                           Foreground="{DynamicResource ThTextTitle}"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="DISM r&#233;pare l'image Windows, puis SFC r&#233;pare les fichiers syst&#232;me avec cette base propre."
                           Foreground="{DynamicResource ThTextSub}"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="12.5"
                           TextWrapping="Wrap"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="BtnCopyReport"
                        Content="COPIER LE RAPPORT"
                        Style="{StaticResource SecondaryBtnStyle}"
                        Padding="16,9"
                        IsEnabled="False"
                        Click="BtnCopyReport_Click"/>
                <Button x:Name="BtnRunRepair"
                        Content="R&#201;PARER WINDOWS"
                        Style="{StaticResource CleanRunBtn}"
                        Padding="20,10"
                        Margin="10,0,0,0"
                        Click="BtnRunRepair_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource ThPanel}"
                BorderBrush="{DynamicResource ThBorder}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="18,16">
            <StackPanel>
                <Grid Margin="0,0,0,4">
                    <TextBlock x:Name="TxtCurrentTitle"
                               Text="Pr&#234;t"
                               Foreground="{DynamicResource ThTextBody}"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="16"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtTotalPct"
                               Text="0 %"
                               Foreground="{DynamicResource ThTextNav}"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"/>
                </Grid>
                <TextBlock x:Name="TxtCurrentDetail"
                           Text="Clique sur R&#201;PARER WINDOWS pour lancer DISM puis SFC dans le bon ordre."
                           Foreground="{DynamicResource ThTextDim}"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"/>

                <Grid Height="8" Margin="0,0,0,12">
                    <Border Background="{DynamicResource ThTrack}" CornerRadius="4"/>
                    <Grid x:Name="TotalBar" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0*"/>
                            <ColumnDefinition Width="100*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource RepairAccent}" CornerRadius="4"/>
                    </Grid>
                </Grid>

            </StackPanel>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.08*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="0.92*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border x:Name="CardCheck" Style="{StaticResource StepCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="DotCheck" Width="24" Height="24" CornerRadius="12"
                                    Background="{DynamicResource ThTrack}"
                                    BorderBrush="{DynamicResource ThBorder}"
                                    BorderThickness="2"
                                    VerticalAlignment="Top">
                                <TextBlock x:Name="NumCheck" Text="1" Foreground="{DynamicResource ThTextDim}"
                                           FontFamily="{StaticResource AppFont}" FontSize="11.5" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="&#201;tat connu de Windows"
                                           Foreground="{DynamicResource ThTextBody}"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtCheck"
                                           Text="Cherche si Windows sait d&#233;j&#224; que son image est ab&#238;m&#233;e."
                                           Foreground="{DynamicResource ThTextDim}"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="11.5"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"/>
                                <Grid Margin="0,10,0,0">
                                    <TextBlock Text="Progression"
                                               Foreground="{DynamicResource ThTextDim}"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="9.5"
                                               FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtPctCheck"
                                               Text="0 %"
                                               Foreground="{DynamicResource ThTextDim}"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="10.5"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Height="6" Margin="0,4,0,0">
                                    <Border Background="{DynamicResource ThTrack}" CornerRadius="3"/>
                                    <Grid x:Name="StepBarCheck" HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0*"/>
                                            <ColumnDefinition Width="100*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{StaticResource RepairAccent}" CornerRadius="3"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="CardScan" Style="{StaticResource StepCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="DotScan" Width="24" Height="24" CornerRadius="12"
                                    Background="{DynamicResource ThTrack}"
                                    BorderBrush="{DynamicResource ThBorder}"
                                    BorderThickness="2"
                                    VerticalAlignment="Top">
                                <TextBlock x:Name="NumScan" Text="2" Foreground="{DynamicResource ThTextDim}"
                                           FontFamily="{StaticResource AppFont}" FontSize="11.5" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Analyse de l'image Windows"
                                           Foreground="{DynamicResource ThTextBody}"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtScan"
                                           Text="Analyse le magasin de composants utilis&#233; pour r&#233;parer Windows."
                                           Foreground="{DynamicResource ThTextDim}"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="11.5"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"/>
                                <Grid Margin="0,10,0,0">
                                    <TextBlock Text="Progression"
                                               Foreground="{DynamicResource ThTextDim}"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="9.5"
                                               FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtPctScan"
                                               Text="0 %"
                                               Foreground="{DynamicResource ThTextDim}"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="10.5"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Height="6" Margin="0,4,0,0">
                                    <Border Background="{DynamicResource ThTrack}" CornerRadius="3"/>
                                    <Grid x:Name="StepBarScan" HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0*"/>
                                            <ColumnDefinition Width="100*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{StaticResource RepairAccent}" CornerRadius="3"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="CardRestore" Style="{StaticResource StepCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="DotRestore" Width="24" Height="24" CornerRadius="12"
                                    Background="{DynamicResource ThTrack}"
                                    BorderBrush="{DynamicResource ThBorder}"
                                    BorderThickness="2"
                                    VerticalAlignment="Top">
                                <TextBlock x:Name="NumRestore" Text="3" Foreground="{DynamicResource ThTextDim}"
                                           FontFamily="{StaticResource AppFont}" FontSize="11.5" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="R&#233;paration de l'image Windows"
                                           Foreground="{DynamicResource ThTextBody}"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtRestore"
                                           Text="R&#233;cup&#232;re les fichiers propres n&#233;cessaires puis r&#233;pare l'image Windows."
                                           Foreground="{DynamicResource ThTextDim}"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="11.5"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"/>
                                <Grid Margin="0,10,0,0">
                                    <TextBlock Text="Progression"
                                               Foreground="{DynamicResource ThTextDim}"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="9.5"
                                               FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtPctRestore"
                                               Text="0 %"
                                               Foreground="{DynamicResource ThTextDim}"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="10.5"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Height="6" Margin="0,4,0,0">
                                    <Border Background="{DynamicResource ThTrack}" CornerRadius="3"/>
                                    <Grid x:Name="StepBarRestore" HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0*"/>
                                            <ColumnDefinition Width="100*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{StaticResource RepairAccent}" CornerRadius="3"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="CardSfc" Style="{StaticResource StepCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="DotSfc" Width="24" Height="24" CornerRadius="12"
                                    Background="{DynamicResource ThTrack}"
                                    BorderBrush="{DynamicResource ThBorder}"
                                    BorderThickness="2"
                                    VerticalAlignment="Top">
                                <TextBlock x:Name="NumSfc" Text="4" Foreground="{DynamicResource ThTextDim}"
                                           FontFamily="{StaticResource AppFont}" FontSize="11.5" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="V&#233;rification des fichiers syst&#232;me"
                                           Foreground="{DynamicResource ThTextBody}"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtSfc"
                                           Text="V&#233;rifie les fichiers syst&#232;me et remplace ceux qui sont corrompus."
                                           Foreground="{DynamicResource ThTextDim}"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="11.5"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"/>
                                <Grid Margin="0,10,0,0">
                                    <TextBlock Text="Progression"
                                               Foreground="{DynamicResource ThTextDim}"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="9.5"
                                               FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtPctSfc"
                                               Text="0 %"
                                               Foreground="{DynamicResource ThTextDim}"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="10.5"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Height="6" Margin="0,4,0,0">
                                    <Border Background="{DynamicResource ThTrack}" CornerRadius="3"/>
                                    <Grid x:Name="StepBarSfc" HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0*"/>
                                            <ColumnDefinition Width="100*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{StaticResource RepairAccent}" CornerRadius="3"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="2"
                    Background="{DynamicResource ThPanel}"
                    BorderBrush="{DynamicResource ThBorder}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Résumé"
                               Foreground="{DynamicResource ThTextBody}"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="14"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtSummary"
                               Grid.Row="2"
                               Text="Aucune r&#233;paration lanc&#233;e."
                               Foreground="{DynamicResource ThTextSub}"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="12"
                               TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="4"
                               Text="Suivi"
                               Foreground="{DynamicResource ThTextDim}"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="11"
                               FontWeight="SemiBold"/>

                    <ScrollViewer x:Name="LogScroll" Grid.Row="6" VerticalScrollBarVisibility="Auto">
                        <Border Background="Transparent"
                                BorderThickness="0"
                                Padding="0,2,0,0">
                            <TextBlock x:Name="TxtLog"
                                       Text="Le suivi appara&#238;tra ici pendant l'op&#233;ration."
                                       Foreground="{DynamicResource ThTextBody}"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="12"
                                       LineHeight="18"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
