<UserControl x:Class="Optimisation_Tool.Pages.PageNvidia"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <!-- ComboBox sombre -->
        <Style x:Key="DarkComboStyle" TargetType="ComboBox">
            <Setter Property="Background"        Value="{DynamicResource ThPanel}"/>
            <Setter Property="Foreground"        Value="{DynamicResource ThTextBody}"/>
            <Setter Property="BorderBrush"       Value="{DynamicResource ThBorder}"/>
            <Setter Property="BorderThickness"   Value="1"/>
            <Setter Property="FontFamily"        Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="Padding"           Value="10,6"/>
            <Setter Property="Cursor"            Value="Hand"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground"  Value="{DynamicResource ThTextBody}"/>
                        <Setter Property="Background"  Value="{DynamicResource ThPanel}"/>
                        <Setter Property="FontFamily"  Value="{StaticResource AppFont}"/>
                        <Setter Property="FontSize"    Value="12"/>
                        <Setter Property="Padding"     Value="10,6"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ThSelection}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1870CC"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- Visuel : bordure + flèche + item sélectionné -->
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="ContentSite"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="Arrow" Grid.Column="1"
                                               Text="&#x25BE;"
                                               Foreground="{DynamicResource ThTextNav}"
                                               FontSize="11"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- ToggleButton transparent par-dessus : ouvre/ferme la liste -->
                            <ToggleButton Background="Transparent"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen,
                                                      RelativeSource={RelativeSource TemplatedParent},
                                                      Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource ThPanel}"
                                        BorderBrush="{DynamicResource ThBorder}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        MinWidth="{Binding ActualWidth,
                                                  RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThTextNav}"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Arrow" Property="Text" Value="&#x25B4;"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#5BA0FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="18,14,18,18">

            <TextBlock Text="S&#233;lectionnez un profil NVIDIA Inspector (.nip) :"
                       Foreground="{DynamicResource ThTextNav}" FontFamily="{StaticResource AppFont}" FontSize="11.5"
                       Margin="0,0,0,8"/>

            <ComboBox x:Name="ComboProfils"
                      Style="{StaticResource DarkComboStyle}"
                      Width="380"
                      HorizontalAlignment="Left"
                      MaxDropDownHeight="200"
                      SelectionChanged="ComboProfils_SelectionChanged"/>

            <!-- ── Récap du profil sélectionné ── -->
            <Border x:Name="RecapCard" Visibility="Collapsed"
                    Margin="0,14,0,0" Width="540" HorizontalAlignment="Left"
                    Background="{DynamicResource ThPanel}"
                    BorderBrush="{DynamicResource ThBorder}"
                    BorderThickness="1" CornerRadius="10" Padding="16,13">
                <StackPanel>
                    <TextBlock x:Name="TxtRecapTitle"
                               Foreground="{DynamicResource ThTextTitle}"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="13.5" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtRecapSub"
                               Foreground="{DynamicResource ThTextDim}"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="11" Margin="0,2,0,10"/>
                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="RecapList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2,4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{DynamicResource ThTextBody}"
                                                   FontFamily="{StaticResource AppFont}" FontSize="11.5"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Background="{DynamicResource ThPill}"
                                                CornerRadius="6" Padding="8,2" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding Value}"
                                                       Foreground="{DynamicResource ThTextNav}"
                                                       FontFamily="Consolas" FontSize="10.5"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <TextBlock x:Name="TxtNvStatus"
                       Text=""
                       Foreground="{DynamicResource ThTextDim}" FontFamily="{StaticResource AppFont}" FontSize="11.5"
                       Margin="0,8,0,0"/>

            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <Button x:Name="BtnAppliquer"
                        Content="APPLIQUER LE PROFIL S&#201;LECTIONN&#201;"
                        Click="BtnAppliquer_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryBtnStyle}">
                            <Setter Property="Background" Value="#1E7A3C"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#28A050"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#16602E"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="{DynamicResource ThSecBtn}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
