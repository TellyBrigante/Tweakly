<UserControl x:Class="Optimisation_Tool.Pages.PageMonitoring"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">

    <UserControl.Resources>
        <Style x:Key="MTile" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource ThPanel}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource ThBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="12"/>
            <Setter Property="Padding"         Value="16,14"/>
        </Style>
        <Style x:Key="MHdr" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThTextDim}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize"   Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="MName" TargetType="TextBlock">
            <Setter Property="Foreground"    Value="{DynamicResource ThTextBody}"/>
            <Setter Property="FontFamily"    Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize"      Value="11.5"/>
            <Setter Property="TextTrimming"  Value="CharacterEllipsis"/>
            <Setter Property="Margin"        Value="0,2,0,10"/>
        </Style>
        <Style x:Key="MBig" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThTextTitle}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize"   Value="30"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="MRowLbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThTextDim}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize"   Value="11.5"/>
        </Style>
        <Style x:Key="MRowVal" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThTextBody}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize"   Value="11.5"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <!-- Petit bouton discret « Libérer la RAM » (coin sup. droit de la tuile RAM) -->
        <Style x:Key="RamFreeBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ThTextDim}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize"   Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="6"
                                Background="{DynamicResource ThTrack}"
                                BorderBrush="{DynamicResource ThBorder}" BorderThickness="1"
                                Padding="9,3">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#254E8C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18,16,18,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ TUILES ══ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CPU -->
            <Border Grid.Column="0" Style="{StaticResource MTile}">
                <StackPanel>
                    <TextBlock Text="PROCESSEUR" Style="{StaticResource MHdr}"/>
                    <TextBlock x:Name="TxtCpuName" Text="&#8212;" Style="{StaticResource MName}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TxtCpuUsage" Text="&#8212;" Style="{StaticResource MBig}"
                                   Foreground="#3B82E0"/>
                        <TextBlock Text="%" Foreground="#3B82E0" FontSize="16" FontWeight="Bold"
                                   FontFamily="{StaticResource AppFont}" VerticalAlignment="Bottom" Margin="2,0,0,5"/>
                    </StackPanel>
                    <!-- Barre usage -->
                    <Grid Height="6" Margin="0,8,0,12">
                        <Border Background="{DynamicResource ThTrack}" CornerRadius="3"/>
                        <Grid x:Name="BarCpu">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0*"/><ColumnDefinition Width="100*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Remplissage dégradé (style barre de MAJ, couleur de la tuile) -->
                            <Border Grid.Column="0" CornerRadius="3">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#2F6FD8" Offset="0"/>
                                        <GradientStop Color="#5BA0FF" Offset="0.6"/>
                                        <GradientStop Color="#8AC0FF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Grid>
                    <Grid Margin="0,0,0,3">
                        <TextBlock Text="Fr&#233;quence" Style="{StaticResource MRowLbl}"/>
                        <TextBlock x:Name="TxtCpuFreq" Text="&#8212;" Style="{StaticResource MRowVal}"/>
                    </Grid>
                    <Grid Margin="0,0,0,3">
                        <TextBlock x:Name="TxtCpuBaseLbl" Text="Fr&#233;q. de base" Style="{StaticResource MRowLbl}"/>
                        <TextBlock x:Name="TxtCpuBase" Text="&#8212;" Style="{StaticResource MRowVal}"/>
                    </Grid>
                    <Grid Margin="0,0,0,3">
                        <TextBlock Text="Processus" Style="{StaticResource MRowLbl}"/>
                        <TextBlock x:Name="TxtCpuProc" Text="&#8212;" Style="{StaticResource MRowVal}"/>
                    </Grid>
                    <Grid>
                        <TextBlock Text="Plus gourmand" Style="{StaticResource MRowLbl}"/>
                        <TextBlock x:Name="TxtCpuTop" Text="&#8212;" Style="{StaticResource MRowVal}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- GPU -->
            <Border Grid.Column="2" Style="{StaticResource MTile}">
                <StackPanel>
                    <TextBlock Text="CARTE GRAPHIQUE" Style="{StaticResource MHdr}"/>
                    <TextBlock x:Name="TxtGpuName" Text="&#8212;" Style="{StaticResource MName}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TxtGpuUsage" Text="&#8212;" Style="{StaticResource MBig}"
                                   Foreground="#2EC46A"/>
                        <TextBlock Text="%" Foreground="#2EC46A" FontSize="16" FontWeight="Bold"
                                   FontFamily="{StaticResource AppFont}" VerticalAlignment="Bottom" Margin="2,0,0,5"/>
                    </StackPanel>
                    <Grid Height="6" Margin="0,8,0,12">
                        <Border Background="{DynamicResource ThTrack}" CornerRadius="3"/>
                        <Grid x:Name="BarGpu">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0*"/><ColumnDefinition Width="100*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="3">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#1F9650" Offset="0"/>
                                        <GradientStop Color="#2EC46A" Offset="0.6"/>
                                        <GradientStop Color="#6FE3A0" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Grid>
                    <Grid Margin="0,0,0,3">
                        <TextBlock Text="VRAM"        Style="{StaticResource MRowLbl}"/>
                        <TextBlock x:Name="TxtGpuVram" Text="&#8212;" Style="{StaticResource MRowVal}"/>
                    </Grid>
                    <Grid Margin="0,0,0,3">
                        <TextBlock Text="Temp&#233;rature" Style="{StaticResource MRowLbl}"/>
                        <TextBlock x:Name="TxtGpuTemp"     Text="&#8212;" Style="{StaticResource MRowVal}"/>
                    </Grid>
                    <Grid Margin="0,0,0,3">
                        <TextBlock Text="Consommation" Style="{StaticResource MRowLbl}"/>
                        <TextBlock x:Name="TxtGpuWatts" Text="&#8212;" Style="{StaticResource MRowVal}"/>
                    </Grid>
                    <Grid>
                        <TextBlock Text="Fr&#233;quence" Style="{StaticResource MRowLbl}"/>
                        <TextBlock x:Name="TxtGpuFreq"   Text="&#8212;" Style="{StaticResource MRowVal}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- RAM -->
            <Border Grid.Column="4" Style="{StaticResource MTile}">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="M&#201;MOIRE VIVE" Style="{StaticResource MHdr}"/>
                            <TextBlock x:Name="TxtRamName" Text="&#8212;" Style="{StaticResource MName}"/>
                        </StackPanel>
                        <Button x:Name="BtnFreeRam" Content="Nettoyer"
                                Style="{StaticResource RamFreeBtn}"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,0,4,0" Click="BtnFreeRam_Click"
                                ToolTip="Lib&#232;re la m&#233;moire r&#233;ellement r&#233;cup&#233;rable : cache fichiers (standby list) + working sets inactifs. Comme le Boost de PC Manager."/>
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TxtRamUsage" Text="&#8212;" Style="{StaticResource MBig}"
                                   Foreground="#C08CF0"/>
                        <TextBlock Text="%" Foreground="#C08CF0" FontSize="16" FontWeight="Bold"
                                   FontFamily="{StaticResource AppFont}" VerticalAlignment="Bottom" Margin="2,0,0,5"/>
                    </StackPanel>
                    <Grid Height="6" Margin="0,8,0,12">
                        <Border Background="{DynamicResource ThTrack}" CornerRadius="3"/>
                        <Grid x:Name="BarRam">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0*"/><ColumnDefinition Width="100*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="3">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#9A63D8" Offset="0"/>
                                        <GradientStop Color="#C08CF0" Offset="0.6"/>
                                        <GradientStop Color="#DCC0F8" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Grid>
                    <Grid Margin="0,0,0,3">
                        <TextBlock Text="Disponible" Style="{StaticResource MRowLbl}"/>
                        <TextBlock x:Name="TxtRamFree" Text="&#8212;" Style="{StaticResource MRowVal}"/>
                    </Grid>
                    <Grid Margin="0,0,0,3">
                        <TextBlock Text="Type" Style="{StaticResource MRowLbl}"/>
                        <TextBlock x:Name="TxtRamType" Text="&#8212;" Style="{StaticResource MRowVal}"/>
                    </Grid>
                    <Grid Margin="0,0,0,3">
                        <TextBlock Text="Barrettes" Style="{StaticResource MRowLbl}"/>
                        <TextBlock x:Name="TxtRamSticks" Text="&#8212;" Style="{StaticResource MRowVal}"/>
                    </Grid>
                    <Grid>
                        <TextBlock Text="Plus gourmand" Style="{StaticResource MRowLbl}"/>
                        <TextBlock x:Name="TxtRamTop" Text="&#8212;" Style="{StaticResource MRowVal}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══ STOCKAGE NVMe : tuiles générées dynamiquement (même style que CPU/GPU/RAM) ══ -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <!-- Tuiles NVMe : colonnes égales remplies en code -->
            <Grid x:Name="NvmeGrid"/>
            <!-- Repli si aucun NVMe -->
            <Border x:Name="NvmeEmptyTile" Style="{StaticResource MTile}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="STOCKAGE NVMe" Style="{StaticResource MHdr}" Margin="0,0,0,8"/>
                    <TextBlock Text="Aucun disque NVMe détecté."
                               Foreground="{DynamicResource ThTextDim}"
                               FontFamily="{StaticResource AppFont}" FontSize="11.5"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══ GRAPHIQUE ══ -->
        <Border Grid.Row="2" Style="{StaticResource MTile}" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- En-tête + légende -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="HISTORIQUE  (60 s)" Style="{StaticResource MHdr}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Ellipse Width="8" Height="8" Fill="#3B82E0" VerticalAlignment="Center"/>
                        <TextBlock Text="CPU" Foreground="{DynamicResource ThTextNav}"
                                   FontFamily="{StaticResource AppFont}" FontSize="11" Margin="5,0,14,0" VerticalAlignment="Center"/>
                        <Ellipse Width="8" Height="8" Fill="#2EC46A" VerticalAlignment="Center"/>
                        <TextBlock Text="GPU" Foreground="{DynamicResource ThTextNav}"
                                   FontFamily="{StaticResource AppFont}" FontSize="11" Margin="5,0,14,0" VerticalAlignment="Center"/>
                        <Ellipse Width="8" Height="8" Fill="#C08CF0" VerticalAlignment="Center"/>
                        <TextBlock Text="RAM" Foreground="{DynamicResource ThTextNav}"
                                   FontFamily="{StaticResource AppFont}" FontSize="11" Margin="5,0,14,0" VerticalAlignment="Center"/>
                        <!-- Entrées NVMe ajoutées dynamiquement (pastille + marque) -->
                        <StackPanel x:Name="NvmeLegend" Orientation="Horizontal" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Zone de tracé -->
                <Border Grid.Row="1" Background="{DynamicResource ThBg}"
                        BorderBrush="{DynamicResource ThBorder}" BorderThickness="1" CornerRadius="8"
                        ClipToBounds="True">
                    <Grid x:Name="GraphArea" SizeChanged="GraphArea_SizeChanged">
                        <!-- Lignes de grille horizontales (25/50/75 %) -->
                        <Canvas x:Name="GridCanvas" IsHitTestVisible="False"/>
                        <!-- (v1.3.5 : aires dégradées sous les courbes ESSAYÉES puis RETIRÉES
                             à la demande de l'utilisateur — garder uniquement courbes lissées
                             + grille pointillée. Ne pas re-proposer.) -->
                        <Polyline x:Name="RamLine" Stroke="#C08CF0" StrokeThickness="2.2"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Polyline x:Name="GpuLine" Stroke="#2EC46A" StrokeThickness="2.2"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Polyline x:Name="CpuLine" Stroke="#3B82E0" StrokeThickness="2.2"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
