<UserControl x:Class="Optimisation_Tool.Pages.PagePrivacy"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Loaded="UserControl_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="18,14,18,18">

            <CheckBox x:Name="ChkTelemetrie"
                      Content="T&#233;l&#233;m&#233;trie Windows (AllowTelemetry + services DiagTrack)"
                      Style="{StaticResource TweakChkStyle}"/>
            <CheckBox x:Name="ChkAdID"
                      Content="Identifiant publicitaire Windows (AdvertisingInfo)"
                      Style="{StaticResource TweakChkStyle}"/>
            <CheckBox x:Name="ChkActivityHistory"
                      Content="Historique d'activit&#233; / Timeline (Activity Feed)"
                      Style="{StaticResource TweakChkStyle}"/>
            <CheckBox x:Name="ChkBingSearch"
                      Content="D&#233;sactiver l'envoi des recherches locales &#224; Bing (menu D&#233;marrer)"
                      Style="{StaticResource TweakChkStyle}"/>
            <CheckBox x:Name="ChkInputPersonal"
                      Content="Personnalisation de la saisie (Ink &amp; Text collection)"
                      Style="{StaticResource TweakChkStyle}"/>
            <CheckBox x:Name="ChkLocation"
                      Content="Service de localisation Windows (DisableLocation)"
                      Style="{StaticResource TweakChkStyle}"/>
            <CheckBox x:Name="ChkWER"
                      Content="Rapport d'erreurs Windows (WerSvc + WER Disabled)"
                      Style="{StaticResource TweakChkStyle}"/>
            <CheckBox x:Name="ChkTailoredExp"
                      Content="Personnalisation Windows bas&#233;e sur les donn&#233;es de diagnostic (Tailored Experiences)"
                      Style="{StaticResource TweakChkStyle}"/>
            <CheckBox x:Name="ChkCompatTel"
                      Content="T&#233;l&#233;m&#233;trie applications Windows (CompatTelRunner / AppCompat Inventory)"
                      Style="{StaticResource TweakChkStyle}"/>

            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <Button x:Name="BtnAppliquer"
                        Content="APPLIQUER LES PARAM&#200;TRES CONFIDENTIALIT&#201;"
                        Style="{StaticResource PrimaryBtnStyle}"
                        Click="BtnAppliquer_Click"/>
            </StackPanel>

            <Border x:Name="StatusBanner" Visibility="Collapsed"
                    Margin="0,16,0,0" Padding="14,10" CornerRadius="8"
                    Background="{DynamicResource ThPanel}"
                    BorderBrush="{DynamicResource ThBorder}" BorderThickness="1"
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10"
                             VerticalAlignment="Center" Margin="0,0,10,0" Fill="#2EC46A"/>
                    <TextBlock x:Name="StatusText" Text=""
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource AppFont}" FontSize="12.5"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
