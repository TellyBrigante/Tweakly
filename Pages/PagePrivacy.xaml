<UserControl x:Class="Optimisation_Tool.Pages.PagePrivacy"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Loaded="UserControl_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="18,14,18,18">

            <!-- DA optim v1.3.5 : rangees switch/icone/texte (styles dans App.xaml) -->
            <TextBlock Text="DONN&#201;ES &#201;CHANG&#201;ES AVEC MICROSOFT"
                       Foreground="{DynamicResource ThTextDim}" FontFamily="{StaticResource AppFont}"
                       FontSize="10.5" FontWeight="SemiBold" Margin="2,0,0,7"/>
            <Border Background="{DynamicResource ThPanel}" BorderBrush="{DynamicResource ThFaintBorder}"
                    BorderThickness="1" CornerRadius="12" Padding="8,7">
                <StackPanel Grid.IsSharedSizeScope="True">

                    <Border Style="{StaticResource CleanRowStyle}" Tag="{x:Reference ChkTelemetrie}"
                            MouseLeftButtonUp="Row_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ChkTelemetrie" Grid.Column="0" VerticalAlignment="Center"
                                      Style="{StaticResource CleanSwitch}"/>
                            <Border Grid.Column="1" Style="{StaticResource CleanIconBox}" Margin="14,0,0,0">
                                <TextBlock Text="&#xE774;" Style="{StaticResource CleanIconGlyph}"/>
                            </Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="13,0,4,0">
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CleanBadgeColumn"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="R&#233;duire la t&#233;l&#233;m&#233;trie Windows" Style="{StaticResource CleanRowTitle}" TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Column="1" Style="{StaticResource CleanDefaultBadge}">
                                        <TextBlock Text="&#192; cocher" Style="{StaticResource CleanDefaultText}"/>
                                    </Border>
                                </Grid>
                                <TextBlock Style="{StaticResource CleanRowDesc}">
                                    <InlineUIContainer BaselineAlignment="Center">
                                        <Border Style="{StaticResource CleanMiniStateOff}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource CleanMiniStateKnob}"/>
                                                <TextBlock Grid.Column="1" Text="O" Style="{StaticResource CleanMiniStateTextOff}"/>
                                            </Grid>
                                        </Border>
                                    </InlineUIContainer>
                                    <Run Text="D&#233;faut &#183; "/>
                                    <Run Text="Coche pour r&#233;duire les diagnostics envoy&#233;s."/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CleanRowStyle}" Tag="{x:Reference ChkCompatTel}"
                            MouseLeftButtonUp="Row_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ChkCompatTel" Grid.Column="0" VerticalAlignment="Center"
                                      Style="{StaticResource CleanSwitch}"/>
                            <Border Grid.Column="1" Style="{StaticResource CleanIconBox}" Margin="14,0,0,0">
                                <TextBlock Text="&#xE71D;" Style="{StaticResource CleanIconGlyph}"/>
                            </Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="13,0,4,0">
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CleanBadgeColumn"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="D&#233;sactiver la t&#233;l&#233;m&#233;trie des applications" Style="{StaticResource CleanRowTitle}" TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Column="1" Style="{StaticResource CleanDefaultBadge}">
                                        <TextBlock Text="&#192; cocher" Style="{StaticResource CleanDefaultText}"/>
                                    </Border>
                                </Grid>
                                <TextBlock Style="{StaticResource CleanRowDesc}">
                                    <InlineUIContainer BaselineAlignment="Center">
                                        <Border Style="{StaticResource CleanMiniStateOff}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource CleanMiniStateKnob}"/>
                                                <TextBlock Grid.Column="1" Text="O" Style="{StaticResource CleanMiniStateTextOff}"/>
                                            </Grid>
                                        </Border>
                                    </InlineUIContainer>
                                    <Run Text="D&#233;faut &#183; "/>
                                    <Run Text="Coche pour bloquer CompatTelRunner."/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CleanRowStyle}" Tag="{x:Reference ChkAdID}"
                            MouseLeftButtonUp="Row_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ChkAdID" Grid.Column="0" VerticalAlignment="Center"
                                      Style="{StaticResource CleanSwitch}"/>
                            <Border Grid.Column="1" Style="{StaticResource CleanIconBox}" Margin="14,0,0,0">
                                <TextBlock Text="&#xE77B;" Style="{StaticResource CleanIconGlyph}"/>
                            </Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="13,0,4,0">
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CleanBadgeColumn"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="D&#233;sactiver l'identifiant publicitaire" Style="{StaticResource CleanRowTitle}" TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Column="1" Style="{StaticResource CleanDefaultBadge}">
                                        <TextBlock Text="&#192; cocher" Style="{StaticResource CleanDefaultText}"/>
                                    </Border>
                                </Grid>
                                <TextBlock Style="{StaticResource CleanRowDesc}">
                                    <InlineUIContainer BaselineAlignment="Center">
                                        <Border Style="{StaticResource CleanMiniStateOff}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource CleanMiniStateKnob}"/>
                                                <TextBlock Grid.Column="1" Text="O" Style="{StaticResource CleanMiniStateTextOff}"/>
                                            </Grid>
                                        </Border>
                                    </InlineUIContainer>
                                    <Run Text="D&#233;faut &#183; "/>
                                    <Run Text="Coche pour supprimer l'identifiant publicitaire."/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CleanRowStyle}" Tag="{x:Reference ChkActivityHistory}"
                            MouseLeftButtonUp="Row_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ChkActivityHistory" Grid.Column="0" VerticalAlignment="Center"
                                      Style="{StaticResource CleanSwitch}"/>
                            <Border Grid.Column="1" Style="{StaticResource CleanIconBox}" Margin="14,0,0,0">
                                <TextBlock Text="&#xE823;" Style="{StaticResource CleanIconGlyph}"/>
                            </Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="13,0,4,0">
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CleanBadgeColumn"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="D&#233;sactiver l'historique d'activit&#233; (Timeline)" Style="{StaticResource CleanRowTitle}" TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Column="1" Style="{StaticResource CleanDefaultBadge}">
                                        <TextBlock Text="&#192; cocher" Style="{StaticResource CleanDefaultText}"/>
                                    </Border>
                                </Grid>
                                <TextBlock Style="{StaticResource CleanRowDesc}">
                                    <InlineUIContainer BaselineAlignment="Center">
                                        <Border Style="{StaticResource CleanMiniStateOff}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource CleanMiniStateKnob}"/>
                                                <TextBlock Grid.Column="1" Text="O" Style="{StaticResource CleanMiniStateTextOff}"/>
                                            </Grid>
                                        </Border>
                                    </InlineUIContainer>
                                    <Run Text="D&#233;faut &#183; "/>
                                    <Run Text="Coche pour couper le journal d'activit&#233;."/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CleanRowStyle}" Tag="{x:Reference ChkBingSearch}"
                            MouseLeftButtonUp="Row_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ChkBingSearch" Grid.Column="0" VerticalAlignment="Center"
                                      Style="{StaticResource CleanSwitch}"/>
                            <Border Grid.Column="1" Style="{StaticResource CleanIconBox}" Margin="14,0,0,0">
                                <TextBlock Text="&#xE721;" Style="{StaticResource CleanIconGlyph}"/>
                            </Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="13,0,4,0">
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CleanBadgeColumn"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Bloquer les recherches Bing du menu D&#233;marrer" Style="{StaticResource CleanRowTitle}" TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Column="1" Style="{StaticResource CleanDefaultBadge}">
                                        <TextBlock Text="&#192; cocher" Style="{StaticResource CleanDefaultText}"/>
                                    </Border>
                                </Grid>
                                <TextBlock Style="{StaticResource CleanRowDesc}">
                                    <InlineUIContainer BaselineAlignment="Center">
                                        <Border Style="{StaticResource CleanMiniStateOff}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource CleanMiniStateKnob}"/>
                                                <TextBlock Grid.Column="1" Text="O" Style="{StaticResource CleanMiniStateTextOff}"/>
                                            </Grid>
                                        </Border>
                                    </InlineUIContainer>
                                    <Run Text="D&#233;faut &#183; "/>
                                    <Run Text="Coche pour garder le menu D&#233;marrer local."/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CleanRowStyle}" Tag="{x:Reference ChkInputPersonal}"
                            MouseLeftButtonUp="Row_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ChkInputPersonal" Grid.Column="0" VerticalAlignment="Center"
                                      Style="{StaticResource CleanSwitch}"/>
                            <Border Grid.Column="1" Style="{StaticResource CleanIconBox}" Margin="14,0,0,0">
                                <TextBlock Text="&#xE70F;" Style="{StaticResource CleanIconGlyph}"/>
                            </Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="13,0,4,0">
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CleanBadgeColumn"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="D&#233;sactiver la personnalisation de la saisie" Style="{StaticResource CleanRowTitle}" TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Column="1" Style="{StaticResource CleanDefaultBadge}">
                                        <TextBlock Text="&#192; cocher" Style="{StaticResource CleanDefaultText}"/>
                                    </Border>
                                </Grid>
                                <TextBlock Style="{StaticResource CleanRowDesc}">
                                    <InlineUIContainer BaselineAlignment="Center">
                                        <Border Style="{StaticResource CleanMiniStateOff}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource CleanMiniStateKnob}"/>
                                                <TextBlock Grid.Column="1" Text="O" Style="{StaticResource CleanMiniStateTextOff}"/>
                                            </Grid>
                                        </Border>
                                    </InlineUIContainer>
                                    <Run Text="D&#233;faut &#183; "/>
                                    <Run Text="Coche pour limiter la collecte de saisie."/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CleanRowStyle}" Tag="{x:Reference ChkLocation}"
                            MouseLeftButtonUp="Row_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ChkLocation" Grid.Column="0" VerticalAlignment="Center"
                                      Style="{StaticResource CleanSwitch}"/>
                            <Border Grid.Column="1" Style="{StaticResource CleanIconBox}" Margin="14,0,0,0">
                                <TextBlock Text="&#xE707;" Style="{StaticResource CleanIconGlyph}"/>
                            </Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="13,0,4,0">
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CleanBadgeColumn"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="D&#233;sactiver le service de localisation" Style="{StaticResource CleanRowTitle}" TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Column="1" Style="{StaticResource CleanDefaultBadge}">
                                        <TextBlock Text="Au besoin" Style="{StaticResource CleanDefaultText}"/>
                                    </Border>
                                </Grid>
                                <TextBlock Style="{StaticResource CleanRowDesc}">
                                    <InlineUIContainer BaselineAlignment="Center">
                                        <Border Style="{StaticResource CleanMiniStateOff}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource CleanMiniStateKnob}"/>
                                                <TextBlock Grid.Column="1" Text="O" Style="{StaticResource CleanMiniStateTextOff}"/>
                                            </Grid>
                                        </Border>
                                    </InlineUIContainer>
                                    <Run Text="D&#233;faut &#183; "/>
                                    <Run Text="Coche si tu veux couper la localisation."/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CleanRowStyle}" Tag="{x:Reference ChkWER}"
                            MouseLeftButtonUp="Row_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ChkWER" Grid.Column="0" VerticalAlignment="Center"
                                      Style="{StaticResource CleanSwitch}"/>
                            <Border Grid.Column="1" Style="{StaticResource CleanIconBox}" Margin="14,0,0,0">
                                <TextBlock Text="&#xE783;" Style="{StaticResource CleanIconGlyph}"/>
                            </Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="13,0,4,0">
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CleanBadgeColumn"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="D&#233;sactiver l'envoi des rapports d'erreurs" Style="{StaticResource CleanRowTitle}" TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Column="1" Style="{StaticResource CleanDefaultBadge}">
                                        <TextBlock Text="Au besoin" Style="{StaticResource CleanDefaultText}"/>
                                    </Border>
                                </Grid>
                                <TextBlock Style="{StaticResource CleanRowDesc}">
                                    <InlineUIContainer BaselineAlignment="Center">
                                        <Border Style="{StaticResource CleanMiniStateOff}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource CleanMiniStateKnob}"/>
                                                <TextBlock Grid.Column="1" Text="O" Style="{StaticResource CleanMiniStateTextOff}"/>
                                            </Grid>
                                        </Border>
                                    </InlineUIContainer>
                                    <Run Text="D&#233;faut &#183; "/>
                                    <Run Text="Coche pour couper l'envoi des rapports."/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CleanRowStyle}" Tag="{x:Reference ChkTailoredExp}"
                            MouseLeftButtonUp="Row_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ChkTailoredExp" Grid.Column="0" VerticalAlignment="Center"
                                      Style="{StaticResource CleanSwitch}"/>
                            <Border Grid.Column="1" Style="{StaticResource CleanIconBox}" Margin="14,0,0,0">
                                <TextBlock Text="&#xE734;" Style="{StaticResource CleanIconGlyph}"/>
                            </Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="13,0,4,0">
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CleanBadgeColumn"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="D&#233;sactiver les exp&#233;riences personnalis&#233;es" Style="{StaticResource CleanRowTitle}" TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Column="1" Style="{StaticResource CleanDefaultBadge}">
                                        <TextBlock Text="&#192; cocher" Style="{StaticResource CleanDefaultText}"/>
                                    </Border>
                                </Grid>
                                <TextBlock Style="{StaticResource CleanRowDesc}">
                                    <InlineUIContainer BaselineAlignment="Center">
                                        <Border Style="{StaticResource CleanMiniStateOff}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource CleanMiniStateKnob}"/>
                                                <TextBlock Grid.Column="1" Text="O" Style="{StaticResource CleanMiniStateTextOff}"/>
                                            </Grid>
                                        </Border>
                                    </InlineUIContainer>
                                    <Run Text="D&#233;faut &#183; "/>
                                    <Run Text="Coche pour couper les suggestions personnalis&#233;es."/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                <Button x:Name="BtnAppliquer"
                        Content="APPLIQUER LES PARAM&#200;TRES DE CONFIDENTIALIT&#201;"
                        Style="{StaticResource CleanRunBtn}"
                        Click="BtnAppliquer_Click"/>
            </StackPanel>

            <Border x:Name="StatusBanner" Visibility="Collapsed"
                    Margin="0,16,0,0" Padding="14,10" CornerRadius="8"
                    Background="{DynamicResource ThPanel}"
                    BorderBrush="{DynamicResource ThBorder}" BorderThickness="1"
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10"
                             VerticalAlignment="Center" Margin="0,0,10,0" Fill="{DynamicResource ThOk}"/>
                    <TextBlock x:Name="StatusText" Text=""
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource AppFont}" FontSize="12.5"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
