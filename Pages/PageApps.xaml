<UserControl x:Class="Optimisation_Tool.Pages.PageApps"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Loaded="UserControl_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Barre d'outils ─────────────────────────────────────────────── -->
        <Grid Grid.Row="0" Margin="18,14,18,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Zone de recherche -->
            <Border Grid.Column="0"
                    Background="{DynamicResource ThSidebar}"
                    BorderBrush="{DynamicResource ThBorder}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Height="34">
                <Grid>
                    <TextBlock x:Name="TxtSearchHint"
                               Text="Rechercher une application…"
                               Foreground="{DynamicResource ThTextDim}"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="10,0"
                               IsHitTestVisible="False"/>
                    <TextBox x:Name="TxtSearch"
                             Background="Transparent"
                             Foreground="{DynamicResource ThTextBody}"
                             CaretBrush="#DCE0F6"
                             SelectionBrush="#256DCC"
                             FontFamily="{StaticResource AppFont}"
                             FontSize="12"
                             VerticalAlignment="Center"
                             Margin="10,0"
                             TextChanged="TxtSearch_TextChanged">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Border Background="Transparent"
                                                    BorderThickness="0">
                                                <ScrollViewer x:Name="PART_ContentHost"
                                                              Focusable="False"
                                                              HorizontalScrollBarVisibility="Hidden"
                                                              VerticalScrollBarVisibility="Hidden"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>
            </Border>

            <!-- Compteur -->
            <TextBlock x:Name="TxtAppCount"
                       Grid.Column="1"
                       Text=""
                       Foreground="{DynamicResource ThTextDim}"
                       FontFamily="{StaticResource AppFont}"
                       FontSize="11.5"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"/>

            <!-- Actualiser -->
            <Button x:Name="BtnRefresh"
                    Grid.Column="3"
                    Content="ACTUALISER"
                    IsEnabled="False"
                    Style="{StaticResource SecondaryBtnStyle}"
                    Click="BtnRefresh_Click"/>

            <!-- Nettoyer les r&#233;sidus (apparait apr&#232;s d&#233;sinstallation) -->
            <Button x:Name="BtnNettoyer"
                    Grid.Column="7"
                    Content="NETTOYER LES R&#201;SIDUS"
                    Visibility="Collapsed"
                    Click="BtnNettoyer_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryBtnStyle}">
                        <Setter Property="Background" Value="#B5781E"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D8941E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#8E5E16"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="{DynamicResource ThSecBtn}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- D&#233;sinstaller -->
            <Button x:Name="BtnDesinstaller"
                    Grid.Column="5"
                    Content="D&#201;SINSTALLER"
                    IsEnabled="False"
                    Click="BtnDesinstaller_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryBtnStyle}">
                        <Setter Property="Background" Value="#7A1E1E"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#9E2828"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#5E1818"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="{DynamicResource ThSecBtn}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <!-- ── DataGrid ───────────────────────────────────────────────────── -->
        <DataGrid x:Name="DgApps"
                  Grid.Row="1"
                  Margin="18,0,18,0"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CanUserResizeRows="False"
                  CanUserSortColumns="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  Background="{DynamicResource ThBg}"
                  RowBackground="{DynamicResource ThBg}"
                  AlternatingRowBackground="{DynamicResource ThPanel}"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource ThBorder}"
                  VerticalGridLinesBrush="Transparent"
                  BorderBrush="{DynamicResource ThBorder}"
                  BorderThickness="1"
                  RowHeaderWidth="0"
                  RowHeight="30"
                  FontFamily="{StaticResource AppFont}"
                  FontSize="12"
                  Foreground="{DynamicResource ThTextBody}"
                  SelectionChanged="DgApps_SelectionChanged">

            <!-- Surcharge des couleurs syst&#232;me pour la s&#233;lection -->
            <DataGrid.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                                 Color="#34408A"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                                 Color="#E2E6FF"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                                 Color="#2E3658"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}"
                                 Color="#B6BEE4"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}"
                                 Color="#262C49"/>
            </DataGrid.Resources>

            <!-- En-t&#234;tes de colonnes -->
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background"      Value="{DynamicResource ThSidebar}"/>
                    <Setter Property="Foreground"      Value="{DynamicResource ThTextNav}"/>
                    <Setter Property="FontFamily"      Value="{StaticResource AppFont}"/>
                    <Setter Property="FontSize"        Value="11.5"/>
                    <Setter Property="FontWeight"      Value="SemiBold"/>
                    <Setter Property="Padding"         Value="10,0"/>
                    <Setter Property="Height"          Value="32"/>
                    <Setter Property="BorderBrush"     Value="{DynamicResource ThBorder}"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="Cursor"          Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridColumnHeader">
                                <Grid>
                                    <Border x:Name="HeaderBd"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <TextBlock Text="{TemplateBinding Content}"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   FontSize="{TemplateBinding FontSize}"
                                                   FontWeight="{TemplateBinding FontWeight}"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <!-- Gripper de redimensionnement (invisible) -->
                                    <Thumb x:Name="PART_RightHeaderGripper"
                                           HorizontalAlignment="Right"
                                           Cursor="SizeWE">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="4" Background="Transparent"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="HeaderBd"
                                                Property="Background" Value="{DynamicResource ThHover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <!-- Lignes -->
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="Transparent"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ThHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ThSelection}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <!-- Cellules -->
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="BorderThickness"  Value="0"/>
                    <Setter Property="Background"       Value="Transparent"/>
                    <Setter Property="Padding"          Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Background="Transparent"
                                        Padding="10,0">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource ThTextTitle}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Application"
                                    Binding="{Binding Name}"
                                    Width="*"
                                    MinWidth="200"/>
                <DataGridTextColumn Header="&#201;diteur"
                                    Binding="{Binding Publisher}"
                                    Width="200"/>
                <DataGridTextColumn Header="Version"
                                    Binding="{Binding Version}"
                                    Width="110"/>
                <DataGridTextColumn Header="Winget ID"
                                    Binding="{Binding WingetId}"
                                    Width="230"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ── Barre de statut ────────────────────────────────────────────── -->
        <Border Grid.Row="2"
                Background="{DynamicResource ThSidebar}"
                BorderBrush="{DynamicResource ThBorder}"
                BorderThickness="0,1,0,0"
                Padding="18,7">
            <TextBlock x:Name="TxtStatus"
                       Text="Chargement…"
                       Foreground="{DynamicResource ThTextDim}"
                       FontFamily="{StaticResource AppFont}"
                       FontSize="11.5"/>
        </Border>
    </Grid>
</UserControl>
