<UserControl x:Class="Optimisation_Tool.Pages.PageApps"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Optimisation_Tool.Pages"
             Background="Transparent"
             Loaded="UserControl_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Barre d'outils ─────────────────────────────────────────────── -->
        <Grid Grid.Row="0" Margin="18,14,18,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>    <!-- 0: recherche -->
                <ColumnDefinition Width="Auto"/> <!-- 1: compteur -->
                <ColumnDefinition Width="12"/>   <!-- 2: spacer -->
                <ColumnDefinition Width="Auto"/> <!-- 3: Actualiser -->
                <ColumnDefinition Width="8"/>    <!-- 4: spacer -->
                <ColumnDefinition Width="Auto"/> <!-- 5: Tout mettre à jour -->
                <ColumnDefinition Width="10"/>   <!-- 6: spacer -->
                <ColumnDefinition Width="Auto"/> <!-- 7: Désinstaller -->
                <ColumnDefinition Width="10"/>   <!-- 8: spacer -->
                <ColumnDefinition Width="Auto"/> <!-- 9: Nettoyer résidus -->
            </Grid.ColumnDefinitions>

            <!-- Zone de recherche -->
            <Border Grid.Column="0"
                    Background="{DynamicResource ThSidebar}"
                    BorderBrush="{DynamicResource ThBorder}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Height="34">
                <Grid>
                    <TextBlock x:Name="TxtSearchHint"
                               Text="Rechercher une application…"
                               Foreground="{DynamicResource ThTextDim}"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="10,0"
                               IsHitTestVisible="False"/>
                    <TextBox x:Name="TxtSearch"
                             Background="Transparent"
                             Foreground="{DynamicResource ThTextBody}"
                             CaretBrush="#DCE0F6"
                             SelectionBrush="#256DCC"
                             FontFamily="{StaticResource AppFont}"
                             FontSize="12"
                             VerticalAlignment="Center"
                             Margin="10,0"
                             TextChanged="TxtSearch_TextChanged">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Border Background="Transparent" BorderThickness="0">
                                                <ScrollViewer x:Name="PART_ContentHost"
                                                              Focusable="False"
                                                              HorizontalScrollBarVisibility="Hidden"
                                                              VerticalScrollBarVisibility="Hidden"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>
            </Border>

            <!-- Compteur -->
            <TextBlock x:Name="TxtAppCount"
                       Grid.Column="1"
                       Foreground="{DynamicResource ThTextDim}"
                       FontFamily="{StaticResource AppFont}"
                       FontSize="11.5"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"/>

            <!-- Actualiser -->
            <Button x:Name="BtnRefresh"
                    Grid.Column="3"
                    Content="ACTUALISER"
                    IsEnabled="False"
                    Style="{StaticResource SecondaryBtnStyle}"
                    Click="BtnRefresh_Click"/>

            <!-- Tout mettre à jour -->
            <Button x:Name="BtnUpdateAll"
                    Grid.Column="5"
                    Content="TOUT METTRE À JOUR"
                    IsEnabled="False"
                    Click="BtnUpdateAll_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryBtnStyle}">
                        <Setter Property="Background" Value="#1A5C9E"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2070BE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#124478"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="{DynamicResource ThSecBtn}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Désinstaller -->
            <Button x:Name="BtnDesinstaller"
                    Grid.Column="7"
                    Content="DÉSINSTALLER"
                    IsEnabled="False"
                    Click="BtnDesinstaller_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryBtnStyle}">
                        <Setter Property="Background" Value="#7A1E1E"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#9E2828"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#5E1818"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="{DynamicResource ThSecBtn}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Nettoyer les résidus -->
            <Button x:Name="BtnNettoyer"
                    Grid.Column="9"
                    Content="NETTOYER LES RÉSIDUS"
                    Visibility="Collapsed"
                    Click="BtnNettoyer_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryBtnStyle}">
                        <Setter Property="Background" Value="#B5781E"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D8941E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#8E5E16"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="{DynamicResource ThSecBtn}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <!-- ── DataGrid ───────────────────────────────────────────────────── -->
        <DataGrid x:Name="DgApps"
                  Grid.Row="1"
                  Margin="18,0,18,0"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CanUserResizeRows="False"
                  CanUserSortColumns="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  Background="{DynamicResource ThBg}"
                  RowBackground="{DynamicResource ThBg}"
                  AlternatingRowBackground="{DynamicResource ThPanel}"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource ThBorder}"
                  VerticalGridLinesBrush="Transparent"
                  BorderBrush="{DynamicResource ThBorder}"
                  BorderThickness="1"
                  RowHeaderWidth="0"
                  RowHeight="32"
                  FontFamily="{StaticResource AppFont}"
                  FontSize="12"
                  Foreground="{DynamicResource ThTextBody}"
                  SelectionChanged="DgApps_SelectionChanged">

            <!-- Surcharge des couleurs système pour la sélection -->
            <DataGrid.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                                 Color="#3D4FA0"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                                 Color="#E8EEFF"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                                 Color="#2E3870"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}"
                                 Color="#B6BEE4"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}"
                                 Color="#262C49"/>
            </DataGrid.Resources>

            <!-- En-têtes de colonnes -->
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background"      Value="{DynamicResource ThSidebar}"/>
                    <Setter Property="Foreground"      Value="{DynamicResource ThTextNav}"/>
                    <Setter Property="FontFamily"      Value="{StaticResource AppFont}"/>
                    <Setter Property="FontSize"        Value="11.5"/>
                    <Setter Property="FontWeight"      Value="SemiBold"/>
                    <Setter Property="Padding"         Value="10,0"/>
                    <Setter Property="Height"          Value="32"/>
                    <Setter Property="BorderBrush"     Value="{DynamicResource ThBorder}"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="Cursor"          Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridColumnHeader">
                                <Grid>
                                    <Border x:Name="HeaderBd"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <TextBlock Text="{TemplateBinding Content}"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   FontSize="{TemplateBinding FontSize}"
                                                   FontWeight="{TemplateBinding FontWeight}"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <Thumb x:Name="PART_RightHeaderGripper"
                                           HorizontalAlignment="Right"
                                           Cursor="SizeWE">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="4" Background="Transparent"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="HeaderBd"
                                                Property="Background" Value="{DynamicResource ThHover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <!-- Lignes -->
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background"     Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ThHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background"      Value="#3D4FA0"/>
                            <Setter Property="BorderBrush"     Value="#5BA0FF"/>
                            <Setter Property="BorderThickness" Value="3,0,0,0"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <!-- Cellules -->
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="BorderThickness"  Value="0"/>
                    <Setter Property="Background"       Value="Transparent"/>
                    <Setter Property="Padding"          Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Background="Transparent" Padding="10,0">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="#E8EEFF"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.Columns>

                <!-- Application -->
                <DataGridTextColumn Header="Application"
                                    Binding="{Binding Name}"
                                    Width="*"
                                    MinWidth="200"/>

                <!-- Éditeur -->
                <DataGridTextColumn Header="Éditeur"
                                    Binding="{Binding Publisher}"
                                    Width="180"/>

                <!-- Version installée -->
                <DataGridTextColumn Header="Version"
                                    Binding="{Binding Version}"
                                    Width="100"/>

                <!-- Winget ID -->
                <DataGridTextColumn Header="Winget ID"
                                    Binding="{Binding WingetId}"
                                    Width="190"/>

                <!-- Statut de mise à jour -->
                <DataGridTemplateColumn Header="Statut"
                                        Width="210"
                                        MinWidth="160"
                                        SortMemberPath="StatusText">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <DockPanel Margin="2,0" LastChildFill="False" VerticalAlignment="Center">

                                <!-- Bouton individuel (affiché seulement si mise à jour dispo ou échec) -->
                                <Button DockPanel.Dock="Right"
                                        Content="METTRE À JOUR"
                                        Tag="{Binding}"
                                        Click="BtnUpdateOne_Click"
                                        VerticalAlignment="Center"
                                        Margin="5,0,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryBtnStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Setter Property="Padding"    Value="7,3"/>
                                            <Setter Property="FontSize"   Value="10.5"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UpdateStatus}" Value="UpdateAvailable">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding UpdateStatus}" Value="Failed">
                                                    <Setter Property="Visibility"  Value="Visible"/>
                                                    <Setter Property="Background"  Value="#7A1E1E"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Badge statut -->
                                <Border DockPanel.Dock="Left"
                                        CornerRadius="4"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Padding"    Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UpdateStatus}" Value="Checking">
                                                    <Setter Property="Background" Value="#1C2040"/>
                                                    <Setter Property="Padding"    Value="8,3"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding UpdateStatus}" Value="UpToDate">
                                                    <Setter Property="Background" Value="#0D2418"/>
                                                    <Setter Property="Padding"    Value="8,3"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding UpdateStatus}" Value="UpdateAvailable">
                                                    <Setter Property="Background" Value="#0E1E36"/>
                                                    <Setter Property="Padding"    Value="8,3"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding UpdateStatus}" Value="Updating">
                                                    <Setter Property="Background" Value="#28200C"/>
                                                    <Setter Property="Padding"    Value="8,3"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding UpdateStatus}" Value="Updated">
                                                    <Setter Property="Background" Value="#0A2016"/>
                                                    <Setter Property="Padding"    Value="8,3"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding UpdateStatus}" Value="Failed">
                                                    <Setter Property="Background" Value="#2A0E0E"/>
                                                    <Setter Property="Padding"    Value="8,3"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <TextBlock Text="{Binding StatusText}"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource ThTextDim}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding UpdateStatus}" Value="Checking">
                                                        <Setter Property="Foreground" Value="{DynamicResource ThTextDim}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding UpdateStatus}" Value="UpToDate">
                                                        <Setter Property="Foreground" Value="#5FD98C"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding UpdateStatus}" Value="UpdateAvailable">
                                                        <Setter Property="Foreground" Value="#5BA0FF"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding UpdateStatus}" Value="Updating">
                                                        <Setter Property="Foreground" Value="#F5C24A"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding UpdateStatus}" Value="Updated">
                                                        <Setter Property="Foreground" Value="#5FD98C"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding UpdateStatus}" Value="Failed">
                                                        <Setter Property="Foreground" Value="#E05555"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                            </DockPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <!-- ── Barre de statut ────────────────────────────────────────────── -->
        <Border Grid.Row="2"
                Background="{DynamicResource ThSidebar}"
                BorderBrush="{DynamicResource ThBorder}"
                BorderThickness="0,1,0,0"
                Padding="18,7">
            <TextBlock x:Name="TxtStatus"
                       Text="Chargement…"
                       Foreground="{DynamicResource ThTextDim}"
                       FontFamily="{StaticResource AppFont}"
                       FontSize="11.5"/>
        </Border>
    </Grid>
</UserControl>
