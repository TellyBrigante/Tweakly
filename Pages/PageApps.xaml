<UserControl x:Class="Optimisation_Tool.Pages.PageApps"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Optimisation_Tool.Pages"
             Background="Transparent"
             Loaded="UserControl_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: barre d'outils -->
            <RowDefinition Height="Auto"/> <!-- 1: bandeau de stats (refonte v1.3.4) -->
            <RowDefinition Height="*"/>    <!-- 2: liste -->
            <RowDefinition Height="Auto"/> <!-- 3: barre de statut -->
        </Grid.RowDefinitions>

        <!-- ── Barre d'outils ─────────────────────────────────────────────── -->
        <Grid Grid.Row="0" Margin="18,14,18,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>    <!-- 0: recherche -->
                <ColumnDefinition Width="Auto"/> <!-- 1: compteur -->
                <ColumnDefinition Width="12"/>   <!-- 2: spacer -->
                <ColumnDefinition Width="Auto"/> <!-- 3: Actualiser -->
                <ColumnDefinition Width="8"/>    <!-- 4: spacer -->
                <ColumnDefinition Width="Auto"/> <!-- 5: Tout mettre à jour -->
                <ColumnDefinition Width="10"/>   <!-- 6: spacer -->
                <ColumnDefinition Width="Auto"/> <!-- 7: Désinstaller -->
                <ColumnDefinition Width="10"/>   <!-- 8: spacer -->
                <ColumnDefinition Width="Auto"/> <!-- 9: Nettoyer résidus -->
            </Grid.ColumnDefinitions>

            <!-- Zone de recherche -->
            <Border Grid.Column="0"
                    Background="{DynamicResource ThSidebar}"
                    BorderBrush="{DynamicResource ThBorder}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Height="34">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE721;"
                               FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Foreground="{DynamicResource ThTextDim}"
                               VerticalAlignment="Center" Margin="11,0,0,0"
                               IsHitTestVisible="False"/>
                    <TextBlock x:Name="TxtSearchHint" Grid.Column="1"
                               Text="Rechercher une application…"
                               Foreground="{DynamicResource ThTextDim}"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="10,0"
                               IsHitTestVisible="False"/>
                    <TextBox x:Name="TxtSearch"
                             Grid.Column="1"
                             Background="Transparent"
                             Foreground="{DynamicResource ThTextBody}"
                             CaretBrush="#DCE0F6"
                             SelectionBrush="#256DCC"
                             FontFamily="{StaticResource AppFont}"
                             FontSize="12"
                             VerticalAlignment="Center"
                             Margin="10,0"
                             TextChanged="TxtSearch_TextChanged">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Border Background="Transparent" BorderThickness="0">
                                                <ScrollViewer x:Name="PART_ContentHost"
                                                              Focusable="False"
                                                              HorizontalScrollBarVisibility="Hidden"
                                                              VerticalScrollBarVisibility="Hidden"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>
            </Border>

            <!-- Compteur -->
            <TextBlock x:Name="TxtAppCount"
                       Grid.Column="1"
                       Foreground="{DynamicResource ThTextDim}"
                       FontFamily="{StaticResource AppFont}"
                       FontSize="11.5"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"/>

            <!-- Actualiser -->
            <!-- ⚠️ PrimaryBtnStyle/SecondaryBtnStyle affichent Content via un TextBlock
                 (TemplateBinding Text) → le Content DOIT rester une simple chaîne.
                 Un StackPanel icône+texte rend un bouton VIDE (bug vécu, refonte v1.3.4). -->
            <Button x:Name="BtnRefresh"
                    Grid.Column="3"
                    Content="ACTUALISER"
                    IsEnabled="False"
                    Style="{StaticResource SecondaryBtnStyle}"
                    Click="BtnRefresh_Click"/>

            <!-- Tout mettre à jour -->
            <!-- Bouton bleu de base → style brillant CleanRunBtn (v1.3.5, uniformisation) -->
            <Button x:Name="BtnUpdateAll"
                    Grid.Column="5"
                    Content="TOUT METTRE À JOUR"
                    IsEnabled="False"
                    Style="{StaticResource CleanRunBtn}" Padding="20,10"
                    Click="BtnUpdateAll_Click"/>

            <!-- Désinstaller -->
            <Button x:Name="BtnDesinstaller"
                    Grid.Column="7"
                    Content="DÉSINSTALLER"
                    IsEnabled="False"
                    Click="BtnDesinstaller_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryBtnStyle}">
                        <Setter Property="Background" Value="#7A1E1E"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#9E2828"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#5E1818"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="{DynamicResource ThSecBtn}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Nettoyer les résidus -->
            <Button x:Name="BtnNettoyer"
                    Grid.Column="9"
                    Content="NETTOYER LES RÉSIDUS"
                    Visibility="Collapsed"
                    Click="BtnNettoyer_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryBtnStyle}">
                        <Setter Property="Background" Value="#B5781E"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D8941E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#8E5E16"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="{DynamicResource ThSecBtn}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <!-- ── Bandeau de stats (refonte v1.3.4) : tuiles teintées + barre d'accent
             verticale + icône MDL2 — même grammaire que l'overlay de MAJ validé ── -->
        <UniformGrid Grid.Row="1" Rows="1" Margin="18,0,18,12">
            <!-- Total -->
            <Border CornerRadius="12" Background="#0F5BA0FF" BorderBrush="#2E5BA0FF"
                    BorderThickness="1" Padding="0" Margin="0,0,10,0">
                <Grid>
                    <Border Width="3" CornerRadius="2" Background="{DynamicResource ThAccentIcon}"
                            HorizontalAlignment="Left" Margin="0,10,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="18,11">
                        <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                   Foreground="{DynamicResource ThAccentIcon}" VerticalAlignment="Center" Margin="0,0,13,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtStatTotal" Text="—" FontSize="23" FontWeight="Bold"
                                       FontFamily="{StaticResource AppFont}"
                                       Foreground="{DynamicResource ThTextTitle}"/>
                            <TextBlock Text="APPLICATIONS" FontSize="9.5" FontWeight="SemiBold"
                                       FontFamily="{StaticResource AppFont}" Margin="0,1,0,0"
                                       Foreground="{DynamicResource ThTextDim}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <!-- À jour -->
            <Border CornerRadius="12" Background="#0F5FD98C" BorderBrush="#2E5FD98C"
                    BorderThickness="1" Padding="0" Margin="0,0,10,0">
                <Grid>
                    <Border Width="3" CornerRadius="2" Background="{DynamicResource ThOk}"
                            HorizontalAlignment="Left" Margin="0,10,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="18,11">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                   Foreground="{DynamicResource ThOk}" VerticalAlignment="Center" Margin="0,0,13,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtStatOk" Text="—" FontSize="23" FontWeight="Bold"
                                       FontFamily="{StaticResource AppFont}" Foreground="{DynamicResource ThOk}"/>
                            <TextBlock Text="&#192; JOUR" FontSize="9.5" FontWeight="SemiBold"
                                       FontFamily="{StaticResource AppFont}" Margin="0,1,0,0"
                                       Foreground="{DynamicResource ThTextDim}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <!-- Mises à jour disponibles -->
            <Border CornerRadius="12" Background="#0F5BA0FF" BorderBrush="#2E5BA0FF"
                    BorderThickness="1" Padding="0" Margin="0,0,10,0">
                <Grid>
                    <Border Width="3" CornerRadius="2" Background="{DynamicResource ThAccentIcon}"
                            HorizontalAlignment="Left" Margin="0,10,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="18,11">
                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                   Foreground="{DynamicResource ThAccentIcon}" VerticalAlignment="Center" Margin="0,0,13,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtStatAvail" Text="—" FontSize="23" FontWeight="Bold"
                                       FontFamily="{StaticResource AppFont}" Foreground="{DynamicResource ThAccentIcon}"/>
                            <TextBlock Text="MISES &#192; JOUR DISPONIBLES" FontSize="9.5" FontWeight="SemiBold"
                                       FontFamily="{StaticResource AppFont}" Margin="0,1,0,0"
                                       Foreground="{DynamicResource ThTextDim}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <!-- Échecs (visible seulement s'il y en a) -->
            <Border x:Name="StatFailedCard" CornerRadius="12" Background="#14E05555"
                    BorderBrush="#3DE05555" BorderThickness="1" Padding="0"
                    Visibility="Collapsed">
                <Grid>
                    <Border Width="3" CornerRadius="2" Background="{DynamicResource ThCrit}"
                            HorizontalAlignment="Left" Margin="0,10,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="18,11">
                        <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                   Foreground="{DynamicResource ThCrit}" VerticalAlignment="Center" Margin="0,0,13,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtStatFailed" Text="—" FontSize="23" FontWeight="Bold"
                                       FontFamily="{StaticResource AppFont}" Foreground="{DynamicResource ThCrit}"/>
                            <TextBlock Text="&#201;CHECS" FontSize="9.5" FontWeight="SemiBold"
                                       FontFamily="{StaticResource AppFont}" Margin="0,1,0,0"
                                       Foreground="{DynamicResource ThTextDim}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- ── DataGrid ───────────────────────────────────────────────────── -->
        <DataGrid x:Name="DgApps"
                  Grid.Row="2"
                  Margin="18,0,18,0"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CanUserResizeRows="False"
                  CanUserSortColumns="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  Background="Transparent"
                  RowBackground="Transparent"
                  GridLinesVisibility="None"
                  BorderBrush="Transparent"
                  BorderThickness="0"
                  RowHeaderWidth="0"
                  RowHeight="46"
                  FontFamily="{StaticResource AppFont}"
                  FontSize="12"
                  Foreground="{DynamicResource ThTextBody}"
                  SelectionChanged="DgApps_SelectionChanged">

            <!-- Surcharge des couleurs système pour la sélection -->
            <DataGrid.Resources>
                <!-- Sélection translucide : lisible sur les DEUX thèmes (le texte garde
                     sa couleur de thème, plus de blanc forcé — refonte v1.3.4) -->
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                                 Color="#1F5BA0FF"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                                 Color="#5BA0FF"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                                 Color="#145BA0FF"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}"
                                 Color="#805BA0FF"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}"
                                 Color="#262C49"/>
            </DataGrid.Resources>

            <!-- En-têtes de colonnes -->
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background"      Value="Transparent"/>
                    <Setter Property="Foreground"      Value="{DynamicResource ThTextDim}"/>
                    <Setter Property="FontFamily"      Value="{StaticResource AppFont}"/>
                    <Setter Property="FontSize"        Value="10.5"/>
                    <Setter Property="FontWeight"      Value="SemiBold"/>
                    <Setter Property="Padding"         Value="10,0"/>
                    <Setter Property="Height"          Value="30"/>
                    <Setter Property="BorderBrush"     Value="{DynamicResource ThBorder}"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="Cursor"          Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridColumnHeader">
                                <Grid>
                                    <Border x:Name="HeaderBd"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <TextBlock Text="{TemplateBinding Content}"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   FontSize="{TemplateBinding FontSize}"
                                                   FontWeight="{TemplateBinding FontWeight}"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <Thumb x:Name="PART_RightHeaderGripper"
                                           HorizontalAlignment="Right"
                                           Cursor="SizeWE">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="4" Background="Transparent"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="HeaderBd"
                                                Property="Background" Value="{DynamicResource ThHover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <!-- Lignes -->
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background"     Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Style.Triggers>
                        <!-- Hover : voile bleu FRANC — doit se voir immédiatement
                             (3e passe, les deux précédentes étaient trop timides) -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background"      Value="#2E5BA0FF"/>
                            <Setter Property="BorderBrush"     Value="#665BA0FF"/>
                            <Setter Property="BorderThickness" Value="1"/>
                        </Trigger>
                        <!-- Sélection : fond bleu marqué + CONTOUR COMPLET accent + barre
                             gauche épaisse — la ligne sélectionnée saute aux yeux -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background"      Value="#505BA0FF"/>
                            <Setter Property="BorderBrush"     Value="#5BA0FF"/>
                            <Setter Property="BorderThickness" Value="5,1,1,1"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <!-- Cellules -->
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="BorderThickness"  Value="0"/>
                    <Setter Property="Background"       Value="Transparent"/>
                    <Setter Property="Padding"          Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Background="Transparent" Padding="10,0">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.Columns>

                <!-- Application : avatar à initiale (accent bleu unique, pas d'arc-en-ciel)
                     + nom au-dessus de l'éditeur (refonte v1.3.4) -->
                <DataGridTemplateColumn Header="APPLICATION"
                                        Width="*" MinWidth="220"
                                        SortMemberPath="Name">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="30" Height="30" CornerRadius="8"
                                        BorderBrush="#2E5BA0FF" BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#3D5BA0FF" Offset="0"/>
                                            <GradientStop Color="#145BA0FF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="{Binding Initial}"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="13.5" FontWeight="Bold"
                                               Foreground="{DynamicResource ThAccentIcon}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Margin="11,0,0,0">
                                    <TextBlock Text="{Binding Name}"
                                               FontFamily="{StaticResource AppFont}" FontSize="12.5"
                                               Foreground="{DynamicResource ThTextBody}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Publisher}"
                                               FontFamily="{StaticResource AppFont}" FontSize="10.5"
                                               Foreground="{DynamicResource ThTextDim}"
                                               TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Version installée -->
                <DataGridTextColumn Header="VERSION"
                                    Binding="{Binding Version}"
                                    Width="110"/>

                <!-- (colonne Winget ID supprimée à la demande de l'utilisateur — info interne
                     sans valeur pour lui ; l'ID reste dans le modèle pour les MAJ winget) -->

                <!-- Statut de mise à jour -->
                <DataGridTemplateColumn Header="STATUT"
                                        Width="210"
                                        MinWidth="160"
                                        SortMemberPath="StatusText">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <DockPanel Margin="2,0" LastChildFill="False" VerticalAlignment="Center">

                                <!-- Bouton individuel (affiché seulement si mise à jour dispo ou échec) -->
                                <Button DockPanel.Dock="Right"
                                        Content="METTRE À JOUR"
                                        Tag="{Binding}"
                                        Click="BtnUpdateOne_Click"
                                        VerticalAlignment="Center"
                                        Margin="5,0,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryBtnStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Setter Property="Padding"    Value="7,3"/>
                                            <Setter Property="FontSize"   Value="10.5"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UpdateStatus}" Value="UpdateAvailable">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding UpdateStatus}" Value="Failed">
                                                    <Setter Property="Visibility"  Value="Visible"/>
                                                    <Setter Property="Background"  Value="#7A1E1E"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Badge statut (pilule semi-transparente, assortie à la couleur du statut) -->
                                <Border DockPanel.Dock="Left"
                                        CornerRadius="10"
                                        BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background"  Value="Transparent"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Setter Property="Padding"     Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UpdateStatus}" Value="Checking">
                                                    <Setter Property="Background"  Value="#22B4BBE0"/>
                                                    <Setter Property="BorderBrush" Value="#55B4BBE0"/>
                                                    <Setter Property="Padding"     Value="10,3"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding UpdateStatus}" Value="UpToDate">
                                                    <Setter Property="Background"  Value="#225FD98C"/>
                                                    <Setter Property="BorderBrush" Value="#555FD98C"/>
                                                    <Setter Property="Padding"     Value="10,3"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding UpdateStatus}" Value="UpdateAvailable">
                                                    <Setter Property="Background"  Value="#225BA0FF"/>
                                                    <Setter Property="BorderBrush" Value="#555BA0FF"/>
                                                    <Setter Property="Padding"     Value="10,3"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding UpdateStatus}" Value="Updating">
                                                    <Setter Property="Background"  Value="#22F5C24A"/>
                                                    <Setter Property="BorderBrush" Value="#55F5C24A"/>
                                                    <Setter Property="Padding"     Value="10,3"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding UpdateStatus}" Value="Updated">
                                                    <Setter Property="Background"  Value="#225FD98C"/>
                                                    <Setter Property="BorderBrush" Value="#555FD98C"/>
                                                    <Setter Property="Padding"     Value="10,3"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding UpdateStatus}" Value="Failed">
                                                    <Setter Property="Background"  Value="#22E05555"/>
                                                    <Setter Property="BorderBrush" Value="#55E05555"/>
                                                    <Setter Property="Padding"     Value="10,3"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <TextBlock Text="{Binding StatusText}"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource ThTextDim}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding UpdateStatus}" Value="Checking">
                                                        <Setter Property="Foreground" Value="{DynamicResource ThTextDim}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding UpdateStatus}" Value="UpToDate">
                                                        <Setter Property="Foreground" Value="{DynamicResource ThOk}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding UpdateStatus}" Value="UpdateAvailable">
                                                        <Setter Property="Foreground" Value="{DynamicResource ThAccentIcon}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding UpdateStatus}" Value="Updating">
                                                        <Setter Property="Foreground" Value="{DynamicResource ThWarn}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding UpdateStatus}" Value="Updated">
                                                        <Setter Property="Foreground" Value="{DynamicResource ThOk}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding UpdateStatus}" Value="Failed">
                                                        <Setter Property="Foreground" Value="{DynamicResource ThCrit}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                            </DockPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <!-- ── Barre de statut ────────────────────────────────────────────── -->
        <Border Grid.Row="3"
                Background="{DynamicResource ThSidebar}"
                BorderBrush="{DynamicResource ThBorder}"
                BorderThickness="0,1,0,0"
                Padding="18,7">
            <TextBlock x:Name="TxtStatus"
                       Text="Chargement…"
                       Foreground="{DynamicResource ThTextDim}"
                       FontFamily="{StaticResource AppFont}"
                       FontSize="11.5"/>
        </Border>
    </Grid>
</UserControl>
