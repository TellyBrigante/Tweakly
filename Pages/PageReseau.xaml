<UserControl x:Class="Optimisation_Tool.Pages.PageReseau"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Loaded="UserControl_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="18,14,18,18">

            <CheckBox x:Name="ChkNagle"
                      Content="D&#233;sactiver l'algorithme de Nagle (TcpAckFrequency) &#8212; r&#233;duction latence"
                      Style="{StaticResource TweakChkStyle}"/>
            <CheckBox x:Name="ChkNetDNS"
                      Content="DNS Cloudflare 1.1.1.1 / 8.8.8.8 &#8212; r&#233;solution de noms plus rapide"
                      Style="{StaticResource TweakChkStyle}"/>
            <CheckBox x:Name="ChkAdapterPower"
                      Content="D&#233;sactiver la mise en veille de l'adaptateur r&#233;seau"
                      Style="{StaticResource TweakChkStyle}"/>
            <CheckBox x:Name="ChkWPAD"
                      Content="D&#233;sactiver la d&#233;tection automatique de proxy (WPAD)"
                      Style="{StaticResource TweakChkStyle}"/>

            <StackPanel Orientation="Horizontal" Margin="0,20,0,0" >
                <Button x:Name="BtnAppliquer"
                        Content="APPLIQUER LES TWEAKS R&#201;SEAU"
                        Style="{StaticResource PrimaryBtnStyle}"
                        Click="BtnAppliquer_Click"/>
                <Button x:Name="BtnFlushDNS"
                        Content="VIDER LE CACHE DNS"
                        Style="{StaticResource SecondaryBtnStyle}"
                        Margin="12,0,0,0"
                        Click="BtnFlushDNS_Click"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
