<UserControl x:Class="Optimisation_Tool.Pages.PageReseau"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Loaded="UserControl_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="18,14,18,18">

            <!-- DA optim v1.3.5 : rangees switch/icone/texte (styles dans App.xaml) -->
            <TextBlock Text="TWEAKS R&#201;SEAU"
                       Foreground="{DynamicResource ThTextDim}" FontFamily="{StaticResource AppFont}"
                       FontSize="10.5" FontWeight="SemiBold" Margin="2,0,0,7"/>
            <Border Background="{DynamicResource ThPanel}" BorderBrush="#1A808080"
                    BorderThickness="1" CornerRadius="12" Padding="8,7">
                <StackPanel Grid.IsSharedSizeScope="True">

                    <Border Style="{StaticResource CleanRowStyle}" Tag="{x:Reference ChkNagle}"
                            MouseLeftButtonUp="Row_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ChkNagle" Grid.Column="0" VerticalAlignment="Center"
                                      Style="{StaticResource CleanSwitch}"/>
                            <Border Grid.Column="1" Style="{StaticResource CleanIconBox}" Margin="14,0,0,0">
                                <TextBlock Text="&#xE71B;" Style="{StaticResource CleanIconGlyph}"/>
                            </Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="13,0,4,0">
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CleanBadgeColumn"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="D&#233;sactiver l'algorithme de Nagle" Style="{StaticResource CleanRowTitle}" TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Column="1" Style="{StaticResource CleanDefaultBadge}">
                                        <TextBlock Text="Au besoin" Style="{StaticResource CleanDefaultText}"/>
                                    </Border>
                                </Grid>
                                <TextBlock Style="{StaticResource CleanRowDesc}">
                                    <InlineUIContainer BaselineAlignment="Center">
                                        <Border Style="{StaticResource CleanMiniStateOff}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource CleanMiniStateKnob}"/>
                                                <TextBlock Grid.Column="1" Text="O" Style="{StaticResource CleanMiniStateTextOff}"/>
                                            </Grid>
                                        </Border>
                                    </InlineUIContainer>
                                    <Run Text="D&#233;faut &#183; "/>
                                    <Run Text="Coche seulement si un jeu r&#233;agit mal."/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CleanRowStyle}" Tag="{x:Reference ChkNetDNS}"
                            MouseLeftButtonUp="Row_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ChkNetDNS" Grid.Column="0" VerticalAlignment="Center"
                                      Style="{StaticResource CleanSwitch}"/>
                            <Border Grid.Column="1" Style="{StaticResource CleanIconBox}" Margin="14,0,0,0">
                                <TextBlock Text="&#xE774;" Style="{StaticResource CleanIconGlyph}"/>
                            </Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="13,0,4,0">
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CleanBadgeColumn"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Forcer les DNS Cloudflare / Google" Style="{StaticResource CleanRowTitle}" TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Column="1" Style="{StaticResource CleanDefaultBadge}">
                                        <TextBlock Text="Au besoin" Style="{StaticResource CleanDefaultText}"/>
                                    </Border>
                                </Grid>
                                <TextBlock Style="{StaticResource CleanRowDesc}">
                                    <InlineUIContainer BaselineAlignment="Center">
                                        <Border Style="{StaticResource CleanMiniStateOff}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource CleanMiniStateKnob}"/>
                                                <TextBlock Grid.Column="1" Text="O" Style="{StaticResource CleanMiniStateTextOff}"/>
                                            </Grid>
                                        </Border>
                                    </InlineUIContainer>
                                    <Run Text="D&#233;faut &#183; "/>
                                    <Run Text="Coche pour forcer 1.1.1.1 et 8.8.8.8."/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CleanRowStyle}" Tag="{x:Reference ChkAdapterPower}"
                            MouseLeftButtonUp="Row_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ChkAdapterPower" Grid.Column="0" VerticalAlignment="Center"
                                      Style="{StaticResource CleanSwitch}"/>
                            <Border Grid.Column="1" Style="{StaticResource CleanIconBox}" Margin="14,0,0,0">
                                <TextBlock Text="&#xE708;" Style="{StaticResource CleanIconGlyph}"/>
                            </Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="13,0,4,0">
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CleanBadgeColumn"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Emp&#234;cher la veille de l'adaptateur r&#233;seau" Style="{StaticResource CleanRowTitle}" TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Column="1" Style="{StaticResource CleanDefaultBadge}">
                                        <TextBlock Text="&#192; cocher" Style="{StaticResource CleanDefaultText}"/>
                                    </Border>
                                </Grid>
                                <TextBlock Style="{StaticResource CleanRowDesc}">
                                    <InlineUIContainer BaselineAlignment="Center">
                                        <Border Style="{StaticResource CleanMiniStateOff}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource CleanMiniStateKnob}"/>
                                                <TextBlock Grid.Column="1" Text="O" Style="{StaticResource CleanMiniStateTextOff}"/>
                                            </Grid>
                                        </Border>
                                    </InlineUIContainer>
                                    <Run Text="D&#233;faut &#183; "/>
                                    <Run Text="Coche pour &#233;viter les micro-coupures."/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CleanRowStyle}" Tag="{x:Reference ChkWPAD}"
                            MouseLeftButtonUp="Row_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ChkWPAD" Grid.Column="0" VerticalAlignment="Center"
                                      Style="{StaticResource CleanSwitch}"/>
                            <Border Grid.Column="1" Style="{StaticResource CleanIconBox}" Margin="14,0,0,0">
                                <TextBlock Text="&#xE727;" Style="{StaticResource CleanIconGlyph}"/>
                            </Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="13,0,4,0">
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CleanBadgeColumn"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="D&#233;sactiver la d&#233;tection de proxy (WPAD)" Style="{StaticResource CleanRowTitle}" TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Column="1" Style="{StaticResource CleanDefaultBadge}">
                                        <TextBlock Text="&#192; cocher" Style="{StaticResource CleanDefaultText}"/>
                                    </Border>
                                </Grid>
                                <TextBlock Style="{StaticResource CleanRowDesc}">
                                    <InlineUIContainer BaselineAlignment="Center">
                                        <Border Style="{StaticResource CleanMiniStateOff}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource CleanMiniStateKnob}"/>
                                                <TextBlock Grid.Column="1" Text="O" Style="{StaticResource CleanMiniStateTextOff}"/>
                                            </Grid>
                                        </Border>
                                    </InlineUIContainer>
                                    <Run Text="D&#233;faut &#183; "/>
                                    <Run Text="Coche sur PC hors domaine/proxy."/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CleanRowStyle}" Tag="{x:Reference ChkNetThrottle}"
                            MouseLeftButtonUp="Row_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ChkNetThrottle" Grid.Column="0" VerticalAlignment="Center"
                                      Style="{StaticResource CleanSwitch}"/>
                            <Border Grid.Column="1" Style="{StaticResource CleanIconBox}" Margin="14,0,0,0">
                                <TextBlock Text="&#xE945;" Style="{StaticResource CleanIconGlyph}"/>
                            </Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="13,0,4,0">
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CleanBadgeColumn"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="D&#233;sactiver le bridage r&#233;seau multim&#233;dia" Style="{StaticResource CleanRowTitle}" TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Column="1" Style="{StaticResource CleanDefaultBadge}">
                                        <TextBlock Text="&#192; cocher" Style="{StaticResource CleanDefaultText}"/>
                                    </Border>
                                </Grid>
                                <TextBlock Style="{StaticResource CleanRowDesc}">
                                    <InlineUIContainer BaselineAlignment="Center">
                                        <Border Style="{StaticResource CleanMiniStateOff}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource CleanMiniStateKnob}"/>
                                                <TextBlock Grid.Column="1" Text="O" Style="{StaticResource CleanMiniStateTextOff}"/>
                                            </Grid>
                                        </Border>
                                    </InlineUIContainer>
                                    <Run Text="D&#233;faut &#183; "/>
                                    <Run Text="Coche pour limiter les variations de latence."/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,18,0,0" >
                <Button x:Name="BtnAppliquer"
                        Content="APPLIQUER LES TWEAKS R&#201;SEAU"
                        Style="{StaticResource CleanRunBtn}"
                        Click="BtnAppliquer_Click"/>
                <Button x:Name="BtnFlushDNS"
                        Content="VIDER LE CACHE DNS"
                        Style="{StaticResource SecondaryBtnStyle}"
                        VerticalAlignment="Center"
                        Margin="12,0,0,0"
                        Click="BtnFlushDNS_Click"/>
            </StackPanel>

            <Border x:Name="StatusBanner" Visibility="Collapsed"
                    Margin="0,16,0,0" Padding="14,10" CornerRadius="8"
                    Background="{DynamicResource ThPanel}"
                    BorderBrush="{DynamicResource ThBorder}" BorderThickness="1"
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10"
                             VerticalAlignment="Center" Margin="0,0,10,0" Fill="{DynamicResource ThOk}"/>
                    <TextBlock x:Name="StatusText" Text=""
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource AppFont}" FontSize="12.5"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
