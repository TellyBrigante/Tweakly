<UserControl x:Class="Optimisation_Tool.Pages.PageBenchmark"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <Style x:Key="BTile" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource ThPanel}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource ThBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="12"/>
            <Setter Property="Padding"         Value="18,16"/>
        </Style>
        <Style x:Key="BCat" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThTextDim}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="BLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThTextDim}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize"   Value="11.5"/>
        </Style>
        <Style x:Key="BValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThTextBody}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Pill de sous-score (refonte v1.3.2) : compacte, cliquable, détail au clic.
             Hover : bordure accent, curseur main. -->
        <Style x:Key="BPill" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource ThPanel}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource ThBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="14,10,14,12"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#5BA0FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="18,16,18,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ════════════════════════════════════════════════════════════
                 BLOC 1 — HERO compact : score + verdict + bouton.
                 (Refonte v1.3.2 : le thermomètre 0-150 a été retiré — redondant
                 avec le classement qui montre la position bien mieux.)
            ════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="0" Style="{StaticResource BTile}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Gros score à gauche -->
                    <TextBlock Grid.Column="0" x:Name="TxtScore" Text="—"
                               Foreground="{DynamicResource ThTextTitle}"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="58" FontWeight="Bold"
                               VerticalAlignment="Center"
                               LineHeight="58" LineStackingStrategy="BlockLineHeight"
                               Margin="4,0,22,0"/>

                    <!-- Centre : titre + verdict + explication discrète -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="TWEAKLY SCORE" Style="{StaticResource BCat}"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock x:Name="TxtLastWhen" Text=""
                                       Foreground="{DynamicResource ThTextDim}"
                                       FontFamily="{StaticResource AppFont}" FontSize="10.5"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtVerdict" Text="Lance ton premier benchmark pour mesurer ta machine."
                                   Foreground="{DynamicResource ThTextTitle}"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="15" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Margin="0,3,0,3"/>
                        <TextBlock TextWrapping="Wrap"
                                   Foreground="{DynamicResource ThTextDim}"
                                   FontFamily="{StaticResource AppFont}" FontSize="11">
                            <Run Text="100"/><Run Text=" = la performance nominale de TON matériel (réf. publiques). Au-dessus : tu surperformes. En-dessous : quelque chose te ralentit."/>
                        </TextBlock>
                        <!-- Boucle mesurer → corriger → prouver (v1.3.5) : visible quand des
                             tweaks ont été appliqués depuis le dernier bench -->
                        <TextBlock x:Name="TxtRebenchHint" Visibility="Collapsed"
                                   TextWrapping="Wrap" Margin="0,6,0,0"
                                   Foreground="#5BA0FF"
                                   FontFamily="{StaticResource AppFont}" FontSize="11.5" FontWeight="SemiBold"
                                   Text="&#x26A1; Des r&#233;glages ont &#233;t&#233; appliqu&#233;s depuis ce benchmark — relance-le pour mesurer le gain."/>
                    </StackPanel>

                    <!-- Bouton à droite -->
                    <Button Grid.Column="2" x:Name="BtnRun"
                            Content="LANCER LE BENCHMARK"
                            Style="{StaticResource CleanRunBtn}" Padding="20,10"
                            VerticalAlignment="Center"
                            Margin="20,0,0,0"
                            Click="BtnRun_Click"/>
                </Grid>
            </Border>

            <!-- ════════════════════════════════════════════════════════════
                 BLOC 2 — CLASSEMENT CPU (le héros de la page, type Cinebench)
            ════════════════════════════════════════════════════════════ -->
            <Border x:Name="LadderTile" Grid.Row="1" Style="{StaticResource BTile}" Margin="0,12,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="CLASSEMENT CPU" Style="{StaticResource BCat}"/>
                        <TextBlock Grid.Column="1" Text="référence : moyennes publiques PassMark"
                                   Foreground="{DynamicResource ThTextDim}"
                                   FontFamily="{StaticResource AppFont}" FontSize="10.5"/>
                    </Grid>
                    <!-- Rempli par RefreshLadder(). Avant le 1er bench : message d'accueil. -->
                    <TextBlock x:Name="TxtLadderEmpty"
                               Text="Ton processeur sera positionné ici face aux modèles voisins après ton premier benchmark."
                               Foreground="{DynamicResource ThTextDim}"
                               FontFamily="{StaticResource AppFont}" FontSize="12"
                               TextWrapping="Wrap" Margin="2,4,0,4"/>
                    <StackPanel x:Name="LadderPanel"/>
                </StackPanel>
            </Border>

            <!-- ════════════════════════════════════════════════════════════
                 BLOC 3 — 4 pills compactes (CPU / Système / RAM / Réseau).
                 Clic sur une pill = détail déplié en dessous (zone partagée).
            ════════════════════════════════════════════════════════════ -->
            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- CPU -->
                    <Border Grid.Column="0" Style="{StaticResource BPill}"
                            MouseLeftButtonUp="PillCpu_Click">
                        <StackPanel>
                            <Grid Margin="0,0,0,7">
                                <TextBlock Text="PROCESSEUR" Style="{StaticResource BCat}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtCpuScore" Text="—" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource ThTextTitle}"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="20" FontWeight="Bold"/>
                            </Grid>
                            <Grid Height="4">
                                <Border CornerRadius="2" Background="{DynamicResource ThTrack}"/>
                                <Grid x:Name="CpuBar">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="CpuCol"     Width="0*"/>
                                        <ColumnDefinition x:Name="CpuColRest" Width="150*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="2" Background="#3B82E0"/>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Système -->
                    <Border Grid.Column="2" Style="{StaticResource BPill}"
                            MouseLeftButtonUp="PillSys_Click">
                        <StackPanel>
                            <Grid Margin="0,0,0,7">
                                <TextBlock Text="SYSTÈME" Style="{StaticResource BCat}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtSysScore" Text="—" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource ThTextTitle}"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="20" FontWeight="Bold"/>
                            </Grid>
                            <Grid Height="4">
                                <Border CornerRadius="2" Background="{DynamicResource ThTrack}"/>
                                <Grid x:Name="SysBar">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="SysCol"     Width="0*"/>
                                        <ColumnDefinition x:Name="SysColRest" Width="100*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="2" Background="#C08CF0"/>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- RAM -->
                    <Border Grid.Column="4" Style="{StaticResource BPill}"
                            MouseLeftButtonUp="PillRam_Click">
                        <StackPanel>
                            <Grid Margin="0,0,0,7">
                                <TextBlock Text="MÉMOIRE" Style="{StaticResource BCat}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtRamScore" Text="—" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource ThTextTitle}"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="20" FontWeight="Bold"/>
                            </Grid>
                            <Grid Height="4">
                                <Border CornerRadius="2" Background="{DynamicResource ThTrack}"/>
                                <Grid x:Name="RamBar">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="RamCol"     Width="0*"/>
                                        <ColumnDefinition x:Name="RamColRest" Width="100*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="2" Background="#F08CB8"/>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Réseau -->
                    <Border Grid.Column="6" Style="{StaticResource BPill}"
                            MouseLeftButtonUp="PillNet_Click">
                        <StackPanel>
                            <Grid Margin="0,0,0,7">
                                <TextBlock Text="RÉSEAU" Style="{StaticResource BCat}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtNetScore" Text="—" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource ThTextTitle}"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="20" FontWeight="Bold"/>
                            </Grid>
                            <Grid Height="4">
                                <Border CornerRadius="2" Background="{DynamicResource ThTrack}"/>
                                <Grid x:Name="NetBar">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="NetCol"     Width="0*"/>
                                        <ColumnDefinition x:Name="NetColRest" Width="100*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="2" Background="#2EC46A"/>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Zone de détail partagée (un seul panneau visible à la fois, toggle au clic) -->
                <Border x:Name="DetailZone" Style="{StaticResource BTile}" Margin="0,8,0,0"
                        Visibility="Collapsed" Padding="16,12">
                    <Grid>
                        <StackPanel x:Name="DetailCpu" Visibility="Collapsed">
                            <TextBlock x:Name="TxtCpuRefModel" Text="—"
                                       Style="{StaticResource BLabel}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <TextBlock x:Name="TxtCpuMeasured" Text="—"
                                       Style="{StaticResource BValue}" TextWrapping="Wrap" LineHeight="18"/>
                        </StackPanel>
                        <StackPanel x:Name="DetailSys" Visibility="Collapsed">
                            <TextBlock Text="Réactivité système — à quel point Windows répond vite et régulièrement (stabilité 60 Hz + jitter)"
                                       Style="{StaticResource BLabel}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <TextBlock x:Name="TxtSysMeasured" Text="—"
                                       Style="{StaticResource BValue}" TextWrapping="Wrap" LineHeight="18"/>
                            <!-- Causes CONSTATÉES sur la machine (BenchAdvisor) + bouton par action -->
                            <StackPanel x:Name="SysAdvicePanel" Margin="0,10,0,0"/>
                        </StackPanel>
                        <StackPanel x:Name="DetailRam" Visibility="Collapsed">
                            <TextBlock Text="Mémoire vive — bande passante (STREAM) + latence d'accès aléatoire"
                                       Style="{StaticResource BLabel}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <TextBlock x:Name="TxtRamDetail" Text="—"
                                       Style="{StaticResource BValue}" TextWrapping="Wrap" LineHeight="18"/>
                        </StackPanel>
                        <StackPanel x:Name="DetailNet" Visibility="Collapsed">
                            <TextBlock Text="Réseau — 30 pings vers 1.1.1.1 (médiane / jitter / perte) · cible excellente : moins de 15 ms"
                                       Style="{StaticResource BLabel}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <TextBlock x:Name="TxtNetMeasured" Text="—"
                                       Style="{StaticResource BValue}" TextWrapping="Wrap" LineHeight="18"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ════════════════════════════════════════════════════════════
                 BLOC 4 — Historique (sparkline + lignes compactes)
            ════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="3" Style="{StaticResource BTile}" Margin="0,12,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="HISTORIQUE" Style="{StaticResource BCat}" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Height="36" Margin="20,0,0,0"
                                Background="{DynamicResource ThTrack}" CornerRadius="6">
                            <Canvas x:Name="SparkCanvas" ClipToBounds="True"/>
                        </Border>
                    </Grid>
                    <StackPanel x:Name="HistoryPanel"/>
                </StackPanel>
            </Border>

            <!-- ════════════════════════════════════════════════════════════
                 BLOC 5 — Comparateur
            ════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="4" Style="{StaticResource BTile}" Margin="0,12,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="COMPARAISON" Style="{StaticResource BCat}"/>
                        <TextBlock Grid.Column="1" x:Name="TxtCompareRange"
                                   Foreground="{DynamicResource ThTextDim}"
                                   FontFamily="{StaticResource AppFont}" FontSize="11"/>
                    </Grid>
                    <StackPanel x:Name="ComparePanel"/>
                </StackPanel>
            </Border>

            <!-- ════════════════════════════════════════════════════════════
                 BLOC 6 — Bouton « Effacer l'historique »
            ════════════════════════════════════════════════════════════ -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="BtnClearHistory"
                        Content="EFFACER L'HISTORIQUE"
                        Style="{StaticResource SecondaryBtnStyle}"
                        Padding="16,8"
                        Click="BtnClearHistory_Click"/>
            </StackPanel>

            <!-- ════════════════════════════════════════════════════════════
                 OVERLAY BENCH EN COURS (modal)
            ════════════════════════════════════════════════════════════ -->
            <Border x:Name="BenchOverlay" Grid.RowSpan="6"
                    Background="#CC1A1F36" CornerRadius="12"
                    Visibility="Collapsed">
                <Border Style="{StaticResource BTile}" MaxWidth="520"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel>
                        <TextBlock x:Name="TxtOverlayTitle" Text="Benchmark en cours…"
                                   Foreground="{DynamicResource ThTextTitle}"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtOverlayPhase" Text="Préparation…"
                                   Foreground="{DynamicResource ThTextDim}"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="12.5" Margin="0,4,0,16"/>
                        <!-- Barre ÉTAPE (sonde en cours) — conservée telle quelle -->
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="&#201;TAPE EN COURS"
                                       Foreground="{DynamicResource ThTextDim}"
                                       FontFamily="{StaticResource AppFont}" FontSize="9.5" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtOverlayPct" Text="0 %"
                                       Foreground="{DynamicResource ThTextDim}"
                                       FontFamily="{StaticResource AppFont}" FontSize="11"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Height="8" Margin="0,0,0,12">
                            <Border Background="{DynamicResource ThTrack}" CornerRadius="4"/>
                            <Grid x:Name="ProgressBar" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0*"/>
                                    <ColumnDefinition Width="100*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="4">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#3B82E0" Offset="0"/>
                                            <GradientStop Color="#5BA0FF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Grid>
                        <!-- Barre TOTALE (v1.3.5, demande utilisateur) : avance d'un cran par
                             étape franchie (8 sondes pondérées également) + la progression
                             interne de l'étape — donne le « temps restant » global -->
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="PROGRESSION TOTALE"
                                       Foreground="{DynamicResource ThTextDim}"
                                       FontFamily="{StaticResource AppFont}" FontSize="9.5" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtOverlayTotalPct" Text="0 %"
                                       Foreground="{DynamicResource ThTextNav}"
                                       FontFamily="{StaticResource AppFont}" FontSize="11" FontWeight="SemiBold"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Height="8">
                            <Border Background="{DynamicResource ThTrack}" CornerRadius="4"/>
                            <Grid x:Name="TotalBar" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0*"/>
                                    <ColumnDefinition Width="100*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="4">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#2F6FD8" Offset="0"/>
                                            <GradientStop Color="#5BA0FF" Offset="0.6"/>
                                            <GradientStop Color="#8AC0FF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Grid>
                        <TextBlock Text="Pour une mesure fiable, ne lance rien d'autre pendant le bench. Le CPU tourne à 100 %."
                                   Foreground="{DynamicResource ThTextDim}"
                                   FontFamily="{StaticResource AppFont}" FontSize="11.5"
                                   TextWrapping="Wrap" Margin="0,16,0,0"/>
                        <!-- Annulation (v1.3.5) : le CancellationToken existait, aucun bouton
                             ne l'actionnait. Le résultat partiel est JETÉ (pas d'historique pollué). -->
                        <Button x:Name="BtnCancelBench" Content="ANNULER LE BENCHMARK"
                                Style="{StaticResource SecondaryBtnStyle}"
                                HorizontalAlignment="Center" Padding="18,9" Margin="0,16,0,0"
                                Click="BtnCancelBench_Click"/>
                    </StackPanel>
                </Border>
            </Border>

            <!-- ════════════════════════════════════════════════════════════
                 MODAL CONFIRMATION AVANT BENCH
            ════════════════════════════════════════════════════════════ -->
            <Border x:Name="ConfirmOverlay" Grid.RowSpan="6"
                    Background="#CC1A1F36" CornerRadius="12"
                    Visibility="Collapsed">
                <Border Style="{StaticResource BTile}" MaxWidth="540"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Avant de lancer le benchmark"
                                   Foreground="{DynamicResource ThTextTitle}"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Pour une mesure fiable, ferme les applications gourmandes :"
                                   Foreground="{DynamicResource ThTextBody}"
                                   FontFamily="{StaticResource AppFont}" FontSize="13"
                                   TextWrapping="Wrap" Margin="0,10,0,6"/>
                        <TextBlock Text="• Navigateurs (Chrome, Firefox…)&#x0a;• Jeux, Discord, Steam&#x0a;• Logiciels de stream (OBS…)&#x0a;• Téléchargements en cours"
                                   Foreground="{DynamicResource ThTextBody}"
                                   FontFamily="{StaticResource AppFont}" FontSize="12.5"
                                   Margin="6,0,0,12"/>
                        <TextBlock Text="Le bench dure 1 à 2 minutes (7 sondes × 3 passes). Le CPU tournera à 100 %."
                                   Foreground="{DynamicResource ThTextDim}"
                                   FontFamily="{StaticResource AppFont}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Border x:Name="NoiseWarn" Background="#33F5C24A" BorderBrush="#F5C24A"
                                BorderThickness="1" CornerRadius="8" Padding="12,8"
                                Margin="0,0,0,14" Visibility="Collapsed">
                            <TextBlock Text="⚠ Activité système détectée — ferme tes apps avant de lancer pour un score fiable."
                                       Foreground="{DynamicResource ThWarn}"
                                       FontFamily="{StaticResource AppFont}" FontSize="12"
                                       TextWrapping="Wrap"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="ANNULER"
                                    Style="{StaticResource SecondaryBtnStyle}"
                                    Padding="18,10" Margin="0,0,10,0"
                                    Click="BtnCancelConfirm_Click"/>
                            <Button Content="LANCER"
                                    Style="{StaticResource CleanRunBtn}" Padding="22,10"
                                    Click="BtnGoConfirm_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
